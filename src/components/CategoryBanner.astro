---
// =====================================================================
//  MUSFIRAS - SHOP BY CATEGORY - MASTER CONTROL PANEL
//  Yahan se sirf text / image / link badalna hai
// =====================================================================
const MFS_CATEGORY_CONFIG = {
  bestSellersTitle: "Discover the Collection",
  bestSellers: [
    {
      image: "/mbnr.jpeg", // public folder wali apni site ki image
      name: "Fashion & Accessories",
      desc: "Wallets, watches and more, finishing touches that make every outfit unforgettable",
      href: "https://www.musfiras.com/fashion_accessories",
    },
  ],
};
---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,700;0,6..96,900;1,6..96,400&family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

<style is:global>
:root{
  --pink:#e6007e;
  --soft-pink:rgba(230,0,126,0.06);
  --maroon:#a8402d;
  --heading-maroon:#9c2954;
  --white:#ffffff;
  --text-dark:#1a1a1a;
  --muted:#555555;
}

html{scroll-behavior:smooth;}

.mfs-page{
  position:relative;
  width:100%;max-width:100%;
  margin:0;padding:0;
  overflow-x:hidden;
  background:var(--white);
  font-family:'Montserrat',sans-serif;
  color:var(--text-dark);
  -webkit-font-smoothing:antialiased;
}
.mfs-page,.mfs-page *,.mfs-page *::before,.mfs-page *::after{box-sizing:border-box;margin:0;padding:0;}
.mfs-page img{display:block;width:100%;height:100%;object-fit:cover;}
.mfs-page a{text-decoration:none;color:inherit;display:inline-block;}

/* HEADING */
.mfs-section-head{
  text-align:center;padding:40px 20px 20px;background:var(--white);
}
.mfs-section-title{
  font-family:'Bodoni Moda',serif;
  font-size:clamp(22px, 3.2vw, 28px);
  font-weight:900;
  color:var(--heading-maroon);
  line-height:1.3;
}
.mfs-section-rule{
  display:flex;align-items:center;justify-content:center;gap:10px;margin-top:8px;
}
.mfs-section-rule span{display:block;width:35px;height:1px;background:var(--pink);opacity:.4;}
.mfs-section-rule i{color:var(--pink);font-size:8px;font-style:normal;font-weight:bold;}

/* WIDE LANDSCAPE BANNER CARD */
.mfs-bs-grid{
  display:grid;
  grid-template-columns:1fr;
  gap:0;
  width:100%;
  padding:0 30px 10px;
  background:var(--white);
  max-width:1700px;
  margin:0 auto;
}
@media(max-width:1024px){ .mfs-bs-grid{padding:0 20px 10px;} }
@media(max-width:767px){ .mfs-bs-grid{padding:0 12px 8px;} }
@media(max-width:420px){ .mfs-bs-grid{padding:0 10px 6px;} }

.mfs-bs-card{
  display:flex;flex-direction:column;
  border-radius:12px;overflow:hidden;
  width:100%;
  background-color:var(--white);
  border:1px solid #f5e6ec;
}

.mfs-bs-img-wrap{
  position:relative;width:100%;
  aspect-ratio:3.4/1;overflow:hidden;
}
@media(max-width:1024px){ .mfs-bs-img-wrap{aspect-ratio:2.8/1;} }
@media(max-width:767px){ .mfs-bs-img-wrap{aspect-ratio:2.2/1;} }
.mfs-bs-img-wrap img{width:100%;height:100%;object-fit:cover;object-position:center;transition:transform .7s ease;}
.mfs-bs-img-wrap:hover img{transform:scale(1.03);}

.mfs-bs-content{
  display:flex;flex-direction:column;align-items:flex-start;
  gap:8px;
  padding:20px 26px 24px;
  background:var(--white);
}
.mfs-bs-name{
  font-family:'Bodoni Moda',serif;
  font-size:clamp(20px, 2.6vw, 28px);
  font-weight:900;
  color:var(--heading-maroon);
  line-height:1.25;
}
.mfs-bs-desc{
  font-size:clamp(12px, 1.4vw, 14px);
  font-weight:700;
  color:var(--muted);
  line-height:1.45;
  max-width:70ch;
}
.mfs-bs-btn{
  background:transparent;color:var(--maroon);
  border:1.5px solid var(--maroon);
  font-size:clamp(10.5px, 1.2vw, 12px);
  font-weight:900;letter-spacing:0.5px;text-transform:uppercase;
  padding:11px 26px;border-radius:50px;
  display:inline-flex;align-items:center;gap:8px;
  transition:all 0.3s ease;
  margin-top:6px;
}
.mfs-bs-btn svg path{stroke:var(--maroon); transition:stroke .3s ease;}

.mfs-bs-card:has(.mfs-bs-img-wrap:hover) .mfs-bs-btn,
.mfs-bs-card:focus-visible .mfs-bs-btn,
.mfs-bs-btn:hover{
  background:var(--pink); border-color:var(--pink); color:var(--white);
  box-shadow:0 6px 16px rgba(230,0,126,0.35);
}
.mfs-bs-card:has(.mfs-bs-img-wrap:hover) .mfs-bs-btn svg path,
.mfs-bs-card:focus-visible .mfs-bs-btn svg path,
.mfs-bs-btn:hover svg path{stroke:var(--white);}
.mfs-bs-card:focus-visible{outline:3px solid var(--pink);outline-offset:2px;}

@media(max-width:520px){
  .mfs-bs-content{padding:14px 14px 16px; gap:6px;}
  .mfs-bs-name{font-size:19px;}
  .mfs-bs-desc{font-size:12px;}
  .mfs-bs-btn{padding:10px 22px; font-size:10.5px;}
}
@media(prefers-reduced-motion:reduce){
  .mfs-bs-img-wrap img,.mfs-bs-btn{transition:none;}
  .mfs-bs-img-wrap:hover img{transform:none;}
}
</style>

<section class="mfs-page">
  <div class="mfs-section-head">
    <h2 class="mfs-section-title" id="mfsBSTitle">{MFS_CATEGORY_CONFIG.bestSellersTitle}</h2>
    <div class="mfs-section-rule"><span></span><i>&#9670;</i><span></span></div>
  </div>
  <div class="mfs-bs-grid" id="mfsBSGrid">
    {MFS_CATEGORY_CONFIG.bestSellers.map((item) => (
      <a href={item.href} class="mfs-bs-card">
        <div class="mfs-bs-img-wrap">
          <img src={item.image} alt={item.name} loading="lazy" decoding="async" />
        </div>
        <div class="mfs-bs-content">
          <div class="mfs-bs-name">{item.name}</div>
          <div class="mfs-bs-desc">{item.desc}</div>
          <span class="mfs-bs-btn">
            Shop Now
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </div>
      </a>
    ))}
  </div>
</section>