---
// Do sections ke beech simple, soft pink divider line
---
<style is:global>
.mfs-divider{
  width:100%;
  max-width:700px;
  height:1px;
  margin:18px auto;
  background:linear-gradient(90deg, rgba(230,0,126,0) 0%, rgba(230,0,126,.28) 50%, rgba(230,0,126,0) 100%);
}
@media(max-width:767px){
  .mfs-divider{max-width:80%;margin:14px auto;}
}
</style>

<div class="mfs-divider" role="separator" aria-hidden="true"></div>