---
// FashionCategoryBanner.astro
// Category page ka hero banner. Data categories.js se aata hai (banner: { ... }).
// image na ho to banner dikhta hi nahi, to baqi categories par koi asar nahi.
const { image, lineBlack = '', lineAccent = '', tagline = '', taglineHref = '' } = Astro.props;
const alt = `${lineBlack} ${lineAccent}`.trim();
---

{image && (
  <>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,700;1,6..96,400&family=Montserrat:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <section class="mfscb-page" aria-label="Category Banner">
      <div class="mfscb-banner">
        <img src={image} alt={alt} loading="eager" fetchpriority="high" />
        <div class="mfscb-overlay">
          <p>
            <span>{lineBlack}</span>{' '}
            <span class="mfscb-accent">{lineAccent}</span>
          </p>
        </div>
      </div>
      {tagline && (
        <div class="mfscb-caption">
          <p>{taglineHref ? <a href={taglineHref}>{tagline}</a> : tagline}</p>
        </div>
      )}
      <div class="mfscb-divider-wrap" aria-hidden="true"><span></span></div>
    </section>
  </>
)}

<style>
  .mfscb-page {
    --mfscb-pink: #e6007e;
    --mfscb-maroon: #a8402d;
    --mfscb-black: #141414;
    --mfscb-white: #ffffff;
    width: 100%;
    background: var(--mfscb-white);
    font-family: 'Montserrat', sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .mfscb-page,
  .mfscb-page *,
  .mfscb-page *::before,
  .mfscb-page *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  .mfscb-page img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mfscb-banner {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 1;
    border-radius: 5px;
    overflow: hidden;
    background: #f5f5f5;
  }
  @media (max-width: 1024px) {
    .mfscb-banner { aspect-ratio: 3.2 / 1; }
  }
  @media (max-width: 600px) {
    .mfscb-banner { aspect-ratio: 2.2 / 1; }
  }
  .mfscb-banner img { transition: transform 0.6s ease; }

  .mfscb-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 18px 20px 20px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.45) 0%, rgba(0, 0, 0, 0.15) 55%, transparent 100%);
    display: flex;
    justify-content: center;
  }
  .mfscb-overlay p {
    font-family: 'Bodoni Moda', serif;
    font-weight: 700;
    font-size: clamp(16px, 2.6vw, 26px);
    line-height: 1.3;
    color: #ffffff;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  }
  .mfscb-overlay .mfscb-accent {
    color: var(--mfscb-pink);
    font-style: italic;
  }

  .mfscb-caption {
    text-align: center;
    padding: 16px 20px 0;
  }
  .mfscb-caption p {
    font-family: 'Bodoni Moda', serif;
    font-weight: 600;
    font-style: italic;
    font-size: clamp(13px, 1.6vw, 16px);
    letter-spacing: 0.2px;
    color: var(--mfscb-maroon);
    line-height: 1.5;
    max-width: 760px;
    margin: 0 auto;
  }
  .mfscb-caption a { color: inherit; text-decoration: none; }
  .mfscb-caption a:hover { text-decoration: underline; }
  @media (max-width: 600px) {
    .mfscb-caption p { font-size: 11.5px; max-width: 100%; }
  }
  @media (max-width: 360px) {
    .mfscb-caption p { font-size: 10.5px; }
  }

  .mfscb-divider-wrap {
    width: 100%;
    display: flex;
    justify-content: center;
    padding: 8px 22px 20px;
  }
  .mfscb-divider-wrap span {
    display: block;
    height: 1px;
    width: 100%;
    max-width: 340px;
    background: var(--mfscb-pink);
    opacity: 0.35;
  }
</style>