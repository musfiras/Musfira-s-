---
// Footer.astro : poora footer ek hi file mein (floating WhatsApp button bhi isi mein hai).
// Links, number, email, social sab src/config/site.js se aate hain, yahan kuch badalna nahi.
// Colour variables ka naam --mfs-... hai, taake header ke colours se takrao na ho.
import { site, whatsappUrl } from '../config/site.js';

const icons = {
  facebook: `<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22c4.78-.79 8.44-4.94 8.44-9.94z"/></svg>`,
  instagram: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/></svg>`,
  pinterest: `<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.24 2.64 7.86 6.36 9.32-.09-.79-.16-2.01.04-2.87.18-.78 1.15-4.94 1.15-4.94s-.29-.58-.29-1.44c0-1.35.78-2.36 1.76-2.36.83 0 1.23.62 1.23 1.37 0 .84-.53 2.09-.81 3.25-.23.97.49 1.76 1.44 1.76 1.73 0 3.06-1.82 3.06-4.45 0-2.33-1.67-3.95-4.06-3.95-2.77 0-4.39 2.07-4.39 4.22 0 .83.32 1.73.72 2.22.08.1.09.18.06.28-.07.29-.23.94-.26 1.07-.04.17-.14.21-.32.13-1.18-.55-1.92-2.27-1.92-3.65 0-2.97 2.16-5.7 6.22-5.7 3.27 0 5.81 2.33 5.81 5.44 0 3.25-2.05 5.86-4.89 5.86-.96 0-1.86-.5-2.17-1.09l-.59 2.25c-.21.82-.79 1.84-1.18 2.47.89.27 1.83.42 2.81.42 5.52 0 10-4.48 10-10S17.52 2 12 2z"/></svg>`,
  website: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 2.5 15.4 0 18M12 3c-2.5 2.6-2.5 15.4 0 18"/></svg>`,
};

const w = site.whatsapp;
const wa = whatsappUrl();
// "-BAGS & CARRYING-" jaise naam se kinare ke dash hata kar footer mein saaf dikhane ke liye
const clean = (s) => String(s).replace(/^[-\s]+|[-\s]+$/g, '');
const year = new Date().getFullYear();
---
<footer class="mfs-footer">

  <!-- ══ 1. PROMISE STRIP: customer ko yaqeen dilane wali 3 baatein ══ -->
  <div class="mfs-wrap">
    <div class="mfs-promises">
      <div class="mfs-promise">
        <span class="mfs-promise-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.4 5.6L20 11l-5.6 2.4L12 19l-2.4-5.6L4 11l5.6-2.4L12 3z"/></svg>
        </span>
        <div>
          <div class="mfs-promise-title">Hand-selected</div>
          <p class="mfs-promise-text">Every piece is picked by us, one by one, so you only see what we would love to carry ourselves.</p>
        </div>
      </div>
      <div class="mfs-promise">
        <span class="mfs-promise-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.7"/><circle cx="17" cy="17.5" r="1.7"/></svg>
        </span>
        <div>
          <div class="mfs-promise-title">Delivered across the UAE</div>
          <p class="mfs-promise-text">Sent to your door with care, wherever you are in the Emirates.</p>
        </div>
      </div>
      <div class="mfs-promise">
        <span class="mfs-promise-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="9" width="18" height="11" rx="2"/><path d="M12 9v11M3 13h18"/><path d="M12 9c-1-3-5-3-5-1s3 1 5 1zM12 9c1-3 5-3 5-1s-3 1-5 1z"/></svg>
        </span>
        <div>
          <div class="mfs-promise-title">Complimentary shipping</div>
          <p class="mfs-promise-text">Shipping is on us, so choosing something lovely is one less thing to worry about.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- ══ 2. MAIN FOOTER ══ -->
  <div class="mfs-wrap">
    <div class="mfs-grid">

      <div class="mfs-col mfs-brand-col">
        <img src="https://d1yei2z3i6k35z.cloudfront.net/13948987/69aa3fe0e2064_Musfiras_handbags_ladies_bags_1_1.png" alt="Musfira’s logo" class="mfs-footer-logo-img" loading="lazy" decoding="async">
        <div class="mfs-tag"><i></i><span>Made to adore</span><i></i></div>
        <p class="mfs-about">Musfira’s is a little world of ladies’ bags, jewellery, wallets, watches and accessories, chosen by hand and sent to you with the kind of care you would give a gift for someone you love.</p>
        <div class="mfs-social-row">
          {site.social.map((s) => (
            <a href={s.href} {...(s.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})} class="mfs-social-icon" aria-label={s.name} set:html={icons[s.key] ?? ''} />
          ))}
        </div>
      </div>

      <nav class="mfs-col" aria-label="Shop">
        <div class="mfs-col-title">Shop</div>
        <a href={site.home} class="mfs-link">Home</a>
        {site.collections.map((c) => (
          <a href={c.href} class="mfs-link">{clean(c.label)}</a>
        ))}
      </nav>

      <nav class="mfs-col" aria-label="Help and information">
        <div class="mfs-col-title">Help &amp; Info</div>
        {site.pages.map((p) => (
          <a href={p.href} class="mfs-link">{p.label}</a>
        ))}
      </nav>

      <div class="mfs-col mfs-contact-col">
        <div class="mfs-col-title">Talk to us</div>
        <p class="mfs-contact-text">Questions about a piece, an order or a gift? Message us, we are happy to help you choose.</p>
        {w.show && (
          <a href={wa} target="_blank" rel="noopener noreferrer" class="mfs-wa-btn">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            <span>Chat on WhatsApp</span>
          </a>
          <div class="mfs-contact-line">{w.display}</div>
        )}
        <a href={`mailto:${site.email}`} class="mfs-mail">{site.email}</a>
      </div>

    </div>
  </div>

  <!-- ══ 3. CLOSING LINE + COPYRIGHT ══ -->
  <div class="mfs-wrap">
    <div class="mfs-bottom">
      <p class="mfs-closing">Every <span class="mfs-brand">Musfira’s</span> piece is hand-selected by us and delivered to your door with care. <span class="mfs-brand">Made to adore.</span></p>
      <div class="mfs-bottom-row">
        <div class="mfs-footer-copy">&#169; <span id="mfsYear">{year}</span> <span class="mfs-brand-soft">Musfira’s</span> &#183; All Rights Reserved</div>
        <button type="button" id="mfsTop" class="mfs-top-btn" aria-label="Back to top"><span>Back to top</span><b>&#8593;</b></button>
      </div>
    </div>
  </div>

  <!-- ══ Floating WhatsApp (chhota, soft). Cart khulne par khud chup jata hai ══ -->
  {w.show && (
    <a href={wa} target="_blank" rel="noopener noreferrer" class="whatsapp-float" aria-label={w.label}>
      <span class="whatsapp-float-tip">{w.label}</span>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    </a>
  )}
</footer>

<style is:global>
:root{
  --mfs-pink: #e6007e;
  --mfs-maroon: var(--orange-maroon, #a3301f);
  --mfs-heading-maroon: #9c2954;
  --mfs-lpink: #fce4f0;
  --mfs-line: #f4dde9;
  --mfs-text: #6b5560;
}

.mfs-footer{
  position:relative;
  width:100%;
  padding:56px 0 26px;
  background:linear-gradient(180deg,#ffffff 0%,#fff8fb 100%);
}
.mfs-footer::before{
  content:"";position:absolute;top:0;left:0;right:0;height:3px;
  background:linear-gradient(90deg,var(--mfs-maroon),var(--mfs-pink),var(--mfs-maroon));
}
.mfs-wrap{ max-width:1180px; margin:0 auto; padding:0 24px; }

.mfs-brand{ color:var(--mfs-pink) !important; font-weight:700; }
.mfs-brand-soft{ color:var(--mfs-pink); font-weight:500; opacity:.9; }

/* ───── 1. Promise strip ───── */
.mfs-promises{
  display:grid; grid-template-columns:repeat(3,1fr); gap:18px;
  margin-bottom:56px;
}
.mfs-promise{
  display:flex; align-items:flex-start; gap:16px;
  padding:22px 22px;
  background:#fff;
  border:1px solid var(--mfs-line);
  border-radius:20px;
  box-shadow:0 6px 22px rgba(156,41,84,.05);
  transition:box-shadow .35s ease, border-color .35s ease;
}
@media (hover:hover){
  .mfs-promise:hover{ border-color:#f1c4da; box-shadow:0 12px 30px rgba(230,0,126,.10); }
}
.mfs-promise-icon{
  flex-shrink:0; width:46px; height:46px; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  background:var(--mfs-lpink); color:var(--mfs-maroon);
  border:1px solid #f5cfe3;
}
.mfs-promise-title{
  font-family:'Montserrat',sans-serif; font-size:12px; font-weight:800;
  letter-spacing:1.4px; text-transform:uppercase; color:var(--mfs-maroon);
  margin:2px 0 7px;
}
.mfs-promise-text{
  margin:0; font-family:'Montserrat',sans-serif; font-size:13px; line-height:1.7;
  color:var(--mfs-text); font-weight:500;
}

/* ───── 2. Main grid ───── */
.mfs-grid{
  display:grid;
  grid-template-columns:1.5fr 1fr 1fr 1.25fr;
  gap:44px 40px;
  padding-bottom:44px;
}
.mfs-col-title{
  position:relative;
  font-family:'Montserrat',sans-serif; font-size:12px; font-weight:800;
  letter-spacing:2.2px; text-transform:uppercase; color:var(--mfs-heading-maroon);
  padding-bottom:14px; margin-bottom:14px;
}
.mfs-col-title::after{
  content:""; position:absolute; left:0; bottom:0; width:30px; height:2px; border-radius:2px;
  background:linear-gradient(90deg,var(--mfs-maroon),var(--mfs-pink));
}

.mfs-footer-logo-img{
  display:block; height:auto;
  width:clamp(104px, 11vw, 138px);
  object-fit:contain;
  margin:0 0 14px;
}
.mfs-tag{ display:flex; align-items:center; gap:9px; margin-bottom:14px; }
.mfs-tag span{
  font-family:'Bodoni Moda',Georgia,serif; font-style:italic; font-size:15px;
  color:var(--mfs-pink); letter-spacing:.3px;
}
.mfs-tag i{ display:block; width:28px; height:1px; background:linear-gradient(90deg,var(--mfs-pink),transparent); }
.mfs-tag i:first-child{ background:linear-gradient(90deg,transparent,var(--mfs-pink)); }
.mfs-about{
  margin:0 0 20px; max-width:340px;
  font-family:'Montserrat',sans-serif; font-size:13.5px; line-height:1.85;
  color:var(--mfs-text); font-weight:500;
}

.mfs-social-row{ display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
.mfs-social-icon{
  width:38px; height:38px; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  background:var(--mfs-lpink); color:var(--mfs-maroon);
  border:1px solid #f5cfe3;
  transition:all .25s ease;
  -webkit-tap-highlight-color:transparent;
}
.mfs-social-icon:active{
  background:linear-gradient(135deg,var(--mfs-maroon),var(--mfs-pink));
  color:#fff; border-color:transparent;
}
@media (hover:hover){
  .mfs-social-icon:hover{
    background:linear-gradient(135deg,var(--mfs-maroon),var(--mfs-pink));
    color:#fff; border-color:transparent;
    transform:translateY(-3px);
    box-shadow:0 8px 20px rgba(230,0,126,.3);
  }
}

.mfs-link{
  display:block; width:fit-content;
  padding:7px 0;
  font-family:'Montserrat',sans-serif; font-size:13.5px; font-weight:600; letter-spacing:.3px;
  color:var(--mfs-maroon); text-decoration:none;
  transition:color .25s ease, transform .3s cubic-bezier(.22,.61,.36,1);
  -webkit-tap-highlight-color:transparent;
}
.mfs-link:active{ color:var(--mfs-pink); }
@media (hover:hover){
  .mfs-link:hover{ color:var(--mfs-pink); transform:translateX(5px); }
}

.mfs-contact-text{
  margin:0 0 16px;
  font-family:'Montserrat',sans-serif; font-size:13.5px; line-height:1.85;
  color:var(--mfs-text); font-weight:500;
}
.mfs-wa-btn{
  display:inline-flex; align-items:center; gap:10px;
  padding:12px 22px; border-radius:999px;
  background:linear-gradient(145deg,#52d98c,#27b867);
  color:#fff; text-decoration:none;
  font-family:'Montserrat',sans-serif; font-size:12px; font-weight:800; letter-spacing:1.2px; text-transform:uppercase;
  box-shadow:0 8px 20px rgba(39,184,103,.26);
  transition:transform .3s cubic-bezier(.22,.61,.36,1), box-shadow .3s ease;
  -webkit-tap-highlight-color:transparent; touch-action:manipulation;
}
.mfs-wa-btn svg{ width:18px; height:18px; fill:currentColor; flex-shrink:0; }
.mfs-wa-btn:active{ transform:scale(.97); }
@media (hover:hover){
  .mfs-wa-btn:hover{ transform:translateY(-3px); box-shadow:0 12px 26px rgba(39,184,103,.34); }
}
.mfs-contact-line{
  margin:12px 0 4px;
  font-family:'Montserrat',sans-serif; font-size:13px; font-weight:700; letter-spacing:.4px;
  color:var(--mfs-maroon);
}
.mfs-mail{
  display:inline-block; margin-top:4px;
  font-family:'Montserrat',sans-serif; font-size:13px; font-weight:600;
  color:var(--mfs-pink); text-decoration:none;
  border-bottom:1px solid rgba(230,0,126,.35);
  word-break:break-all;
  transition:border-color .25s ease;
}
@media (hover:hover){ .mfs-mail:hover{ border-bottom-color:var(--mfs-pink); } }

/* ───── 3. Bottom ───── */
.mfs-bottom{ border-top:1px solid var(--mfs-line); padding-top:26px; text-align:center; }
.mfs-closing{
  max-width:620px; margin:0 auto 20px;
  font-family:'Bodoni Moda',Georgia,serif; font-style:italic; font-size:15.5px; line-height:1.75;
  color:#7d6672;
}
.mfs-bottom-row{
  display:flex; align-items:center; justify-content:center; gap:22px; flex-wrap:wrap;
}
.mfs-footer-copy{
  font-family:'Montserrat',sans-serif; font-size:12px; font-weight:500;
  color:#8a7480; letter-spacing:.2px;
}
.mfs-top-btn{
  display:inline-flex; align-items:center; gap:8px;
  padding:7px 16px; border-radius:999px;
  background:var(--mfs-lpink); color:var(--mfs-maroon);
  border:1px solid #f5cfe3; cursor:pointer;
  font-family:'Montserrat',sans-serif; font-size:10.5px; font-weight:800; letter-spacing:1.4px; text-transform:uppercase;
  transition:all .25s ease;
  -webkit-tap-highlight-color:transparent; touch-action:manipulation;
}
.mfs-top-btn b{ font-size:13px; line-height:1; transition:transform .3s ease; }
.mfs-top-btn:active{
  background:linear-gradient(135deg,var(--mfs-maroon),var(--mfs-pink)); color:#fff; border-color:transparent;
}
@media (hover:hover){
  .mfs-top-btn:hover{
    background:linear-gradient(135deg,var(--mfs-maroon),var(--mfs-pink)); color:#fff; border-color:transparent;
  }
  .mfs-top-btn:hover b{ transform:translateY(-2px); }
}

/* ───── Floating WhatsApp (chhota + soft) ───── */
.whatsapp-float{
  position:fixed;
  right:16px; right:max(16px, env(safe-area-inset-right, 0px));
  bottom:18px; bottom:calc(18px + env(safe-area-inset-bottom, 0px));
  z-index:9000;
  width:42px; height:42px; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  background:linear-gradient(145deg,#52d98c,#27b867);
  color:#fff;
  border:2px solid #fff;
  box-shadow:0 6px 16px rgba(39,184,103,.28), 0 2px 6px rgba(0,0,0,.08);
  text-decoration:none;
  transition:transform .35s cubic-bezier(.22,.61,.36,1), box-shadow .35s ease;
  -webkit-tap-highlight-color:transparent; touch-action:manipulation;
}
.whatsapp-float svg{ width:21px; height:21px; fill:currentColor; display:block; }
.whatsapp-float::before{
  content:""; position:absolute; top:-2px; right:-2px; bottom:-2px; left:-2px;
  border-radius:50%; border:2px solid rgba(39,184,103,.4);
  opacity:0; animation:mWaRing 5s ease-out infinite; pointer-events:none;
}
@keyframes mWaRing{
  0%,72%{ transform:scale(1); opacity:0; }
  76%{ opacity:.7; }
  100%{ transform:scale(1.6); opacity:0; }
}
.whatsapp-float-tip{
  position:absolute; right:calc(100% + 10px); top:50%;
  transform:translateY(-50%) translateX(6px);
  padding:7px 13px; border-radius:999px;
  background:#fff; color:var(--mfs-maroon);
  border:1px solid #f5cfe3;
  font-family:'Montserrat',sans-serif; font-size:10.5px; font-weight:800; letter-spacing:1px; text-transform:uppercase;
  white-space:nowrap;
  box-shadow:0 6px 18px rgba(156,41,84,.12);
  opacity:0; pointer-events:none;
  transition:opacity .3s ease, transform .35s cubic-bezier(.22,.61,.36,1);
}
.whatsapp-float:active{ transform:scale(.95); }
@media (hover:hover){
  .whatsapp-float:hover{ transform:translateY(-3px); box-shadow:0 10px 22px rgba(39,184,103,.34), 0 3px 8px rgba(0,0,0,.1); }
  .whatsapp-float:hover .whatsapp-float-tip{ opacity:1; transform:translateY(-50%) translateX(0); }
}

