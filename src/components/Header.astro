    function openSearch() {
        if (isOpen) { return; }
        isOpen = true;
        lastFocus = document.activeElement;
        try { if (typeof closeNav === 'function') { closeNav(); } } catch (e) {}
        try { var dd = document.getElementById('mDropdown'); if (dd) { dd.classList.remove('open'); } } catch (e) {}
        root.style.display = 'block';
        root.setAttribute('aria-hidden', 'false');
        lockPage();
        try { input.focus({ preventScroll: true }); } catch (e) { input.focus(); }
        root.offsetWidth;
        root.classList.add('is-open');
        if (DB) { render(); }
        else { failed = false; render(); load(function () { if (isOpen) { render(); } }); }
    }
    function closeSearch() {
        if (!isOpen) { return; }
        isOpen = false;
        root.classList.remove('is-open');
        root.setAttribute('aria-hidden', 'true');
        input.blur();
        unlockPage();
        setTimeout(function () {
            if (!isOpen) { root.style.display = 'none'; input.value = ''; clearBtn.hidden = true; }
        }, 380);
        if (lastFocus && lastFocus.focus) { try { lastFocus.focus({ preventScroll: true }); } catch (e) {} }
    }

    /* ---------- header icon: cart ke left mein ---------- */
    var right = document.querySelector('.header-section .nav-right');
    if (right) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'ms-search-btn';
        btn.setAttribute('aria-label', 'Search products');
        btn.setAttribute('aria-haspopup', 'dialog');
        btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="11" cy="11" r="6.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M20 20l-4.2-4.2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
        right.insertBefore(btn, right.querySelector('.m-header-cart-wrapper') || null);
        btn.addEventListener('click', openSearch);
        btn.addEventListener('pointerenter', warm);
        btn.addEventListener('touchstart', warm, { passive: true });
        btn.addEventListener('focus', warm);
    }
    window.addEventListener('load', function () { setTimeout(warm, 2500); });

    /* ---------- events ---------- */
    input.addEventListener('input', render);
    clearBtn.addEventListener('click', function () { input.value = ''; render(); input.focus(); });
    closeBtn.addEventListener('click', closeSearch);
    root.addEventListener('click', function (e) { if (e.target === root) { closeSearch(); } });

    function move(d) {
        if (!items.length) { return; }
        var n = active + d;
        if (n < 0) { n = items.length - 1; }
        if (n >= items.length) { n = 0; }
        setActive(n, true);
    }
    input.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
        else if (e.key === 'Enter') {
            e.preventDefault();
            var el = items[active];
            if (input.value.trim()) { addRecent(input.value); track(input.value); }
            if (el) { window.location.href = el.getAttribute('href'); }
        }
    });
    body.addEventListener('click', function (e) {
        var t = e.target;
        if (!t || !t.closest) { return; }
        var chip = t.closest('[data-q]');
        if (chip) { e.preventDefault(); input.value = chip.getAttribute('data-q'); render(); input.focus(); return; }
        if (t.closest('[data-act="clear-recent"]')) { clearRecent(); render(); return; }
        if (t.closest('.ms-item') && input.value.trim()) { addRecent(input.value); track(input.value); }
    });
    body.addEventListener('mouseover', function (e) {
        var it = e.target && e.target.closest ? e.target.closest('.ms-item') : null;
        if (!it) { return; }
        var i = items.indexOf(it);
        if (i > -1 && i !== active) { setActive(i, false); }
    });
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && isOpen) { closeSearch(); return; }
        var tag = e.target && e.target.tagName;
        var typing = tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || (e.target && e.target.isContentEditable);
        if (!isOpen && ((e.key === '/' && !typing && !e.ctrlKey && !e.metaKey && !e.altKey) || ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')))) {
            e.preventDefault();
            openSearch();
        }
    });
    document.addEventListener('focusin', function (e) {
        if (isOpen && !root.contains(e.target)) { try { input.focus({ preventScroll: true }); } catch (err) {} }
    });
    window.addEventListener('pageshow', function (e) {
        if (e.persisted && isOpen) {
            isOpen = false; unlockPage();
            root.classList.remove('is-open'); root.style.display = 'none';
            input.value = ''; clearBtn.hidden = true;
        }
    });
})();
</script>
