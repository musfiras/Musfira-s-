<script is:inline>
(function () {
    'use strict';
    var root = document.getElementById('msSearch');
    if (!root || root.getAttribute('data-ready')) { return; }
    root.setAttribute('data-ready', '1');
    if (root.parentNode !== document.body) { document.body.appendChild(root); }

    var INDEX_URL = '/search-index.json';
    var MAX_RESULTS = 24;
    var input = root.querySelector('.ms-input');
    var body = root.querySelector('.ms-body');
    var clearBtn = root.querySelector('.ms-clear');
    var closeBtn = root.querySelector('.ms-close');

    var DB = null, loading = false, failed = false, waiters = [];
    var isOpen = false, lastFocus = null, items = [], active = -1, locked = false, prev = {}, warmed = false;

    /* ---------- helpers ---------- */
    function digits(s) {
