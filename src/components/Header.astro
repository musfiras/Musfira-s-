            if (s > best) { best = s; if (best === 1) { break; } }
        }
        return best;
    }
    // ek lafz ka ek product par score (name sab se zyada, phir color, keywords, category, description)
    function tokScore(p, ts, loose, useDesc) {
        var num = isNum(ts), best = 0, vars = [ts], j, k, f, v;
        if (num) {
            var n = parseInt(ts, 10);
            if (p.p === n) { best = 8; }
            else if (loose && n > 0 && Math.abs(p.p - n) / n <= 0.2) { best = 3; }
        } else if (SYN[ts]) { vars = vars.concat(SYN[ts]); }
        for (j = 0; j < vars.length; j++) {
            f = j === 0 ? 1 : 0.6;
            for (k = 0; k < FIELDS.length; k++) {
                if (!useDesc && FIELDS[k][0] === '_desc') { continue; }
                v = fieldScore(p[FIELDS[k][0]], vars[j], num, loose) * FIELDS[k][1] * f;
                if (v > best) { best = v; }
