        var r = search(q);
        if (r.kind === 'none') { renderNone(raw, r); } else { renderFound(r, q, raw); }
    }

    /* ---------- open / close ---------- */
    function lockPage() {
        if (locked) { return; }
        locked = true;
        var b = document.body, h = document.documentElement;
        var sbw = window.innerWidth - h.clientWidth;
        prev = { bo: b.style.overflow, ho: h.style.overflow, pr: b.style.paddingRight };
        b.style.overflow = 'hidden';
        h.style.overflow = 'hidden';
        if (sbw > 0) { b.style.paddingRight = sbw + 'px'; }
