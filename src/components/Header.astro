        return s.replace(/\s+/g, ' ').trim();
    }
    function stem(w) {
        return (w.length > 3 && w.charAt(w.length - 1) === 's' && w.charAt(w.length - 2) !== 's') ? w.slice(0, -1) : w;
    }
    function words(s) {
        var n = norm(s);
        return n ? n.split(' ').map(stem) : [];
    }
    function isNum(t) { return /^\d+$/.test(t); }
    function lev(a, b, max) {
        if (Math.abs(a.length - b.length) > max) { return max + 1; }
        var prevRow = [], cur = [], i, j, t;
        for (j = 0; j <= b.length; j++) { prevRow[j] = j; }
        for (i = 1; i <= a.length; i++) {
            cur[0] = i;
            var rowMin = cur[0];
            for (j = 1; j <= b.length; j++) {
                var c = a.charCodeAt(i - 1) === b.charCodeAt(j - 1) ? 0 : 1;
                cur[j] = Math.min(prevRow[j] + 1, cur[j - 1] + 1, prevRow[j - 1] + c);
                if (cur[j] < rowMin) { rowMin = cur[j]; }
            }
            if (rowMin > max) { return max + 1; }
            t = prevRow; prevRow = cur; cur = t;
        }
        return prevRow[b.length];
    }
    // do lafzon ki shakal kitni milti hai (0 se 1): "wallett" aur "wallet" waghera
    function dice(a, b) {
        if (a.length < 2 || b.length < 2) { return 0; }
        var A = {}, n = a.length - 1, m = b.length - 1, hit = 0, i, x;
        for (i = 0; i < n; i++) { x = a.substr(i, 2); A[x] = (A[x] || 0) + 1; }
        for (i = 0; i < m; i++) { x = b.substr(i, 2); if (A[x] > 0) { A[x]--; hit++; } }
        return (2 * hit) / (n + m);
    }

    /* ---------- milte julte lafz (synonyms) ----------
       Customer "purse" likhe aur product "handbag" ho to bhi mil jaye.
       Apne products ke hisaab se is list mein lafz add / kam kar sakte ho. */
    var SYN_GROUPS = [
        ['bag', 'handbag', 'purse', 'tote', 'sling', 'crossbody', 'satchel', 'clutch', 'backpack', 'shoulder', 'hobo'],
        ['wallet', 'cardholder', 'purse', 'pouch'],
        ['watch', 'wristwatch', 'timepiece'],
        ['jewellery', 'jewelry', 'necklace', 'pendant', 'ring', 'earring', 'bracelet', 'bangle', 'anklet'],
        ['sunglass', 'sunglasses', 'shades', 'eyewear', 'glasses'],
        ['shoe', 'shoes', 'sandal', 'heel', 'sneaker', 'flat', 'footwear'],
        ['scarf', 'hijab', 'shawl', 'stole'],
        ['perfume', 'fragrance', 'scent'],
        ['gift', 'present'],
        ['beige', 'nude', 'cream', 'tan', 'camel'],
        ['pink', 'blush', 'rose'],
        ['black', 'ebony'],
        ['brown', 'chocolate', 'coffee'],
        ['white', 'ivory', 'offwhite'],
        ['red', 'maroon', 'burgundy', 'wine'],
        ['blue', 'navy'],
        ['green', 'olive'],
        ['grey', 'gray', 'silver']
    ];
    var SYN = {};
    SYN_GROUPS.forEach(function (g) {
        var st = g.map(stem);
        st.forEach(function (w) {
            var o = SYN[w] || (SYN[w] = []);
            st.forEach(function (x) { if (x !== w && o.indexOf(x) < 0) { o.push(x); } });
        });
    });

    /* ---------- recent + tracking ---------- */
    function getRecent() {
        try {
            var a = JSON.parse(localStorage.getItem('ms_recent') || '[]');
            return Array.isArray(a) ? a.filter(function (x) { return typeof x === 'string'; }).slice(0, 5) : [];
        } catch (e) { return []; }
    }
    function addRecent(q) {
        q = String(q || '').trim();
        if (q.length < 2) { return; }
        try {
            var a = getRecent().filter(function (x) { return x.toLowerCase() !== q.toLowerCase(); });
            a.unshift(q.slice(0, 40));
            localStorage.setItem('ms_recent', JSON.stringify(a.slice(0, 5)));
        } catch (e) {}
    }
    function clearRecent() { try { localStorage.removeItem('ms_recent'); } catch (e) {} }
    function track(q) {
        q = String(q || '').trim();
        if (q.length < 2) { return; }
        try { if (typeof fbq !== 'undefined') { fbq('track', 'Search', { search_string: q.slice(0, 80) }); } } catch (e) {}
        try { if (typeof gtag === 'function') { gtag('event', 'search', { search_term: q.slice(0, 80) }); } } catch (e) {}
    }

    /* ---------- data: har search se pehle poori site ka data scan ---------- */
    function prepare(d) {
        var out = { categories: (d && d.categories) || [], products: (d && d.products) || [] };
        out.products.forEach(function (p) {
            p.c = p.c || []; p.cats = p.cats || [];
            p._name = words(p.n);
            p._col = words(p.c.join(' '));
            p._kw = words(p.k || '');
            p._cat = words(p.cats.join(' '));
            p._desc = words(p.d || '');
            p._nameN = norm(p.n);
        });
        return out;
    }
    function load(cb) {
        if (DB) { if (cb) { cb(); } return; }
        if (cb) { waiters.push(cb); }
        if (loading) { return; }
        loading = true; failed = false;
        fetch(INDEX_URL, { cache: 'no-cache' })
            .then(function (r) { if (!r.ok) { throw new Error('bad'); } return r.json(); })
            .then(function (d) { DB = prepare(d); })
            .catch(function () { failed = true; })
            .then(function () {
                loading = false;
                var w = waiters; waiters = [];
                w.forEach(function (f) { try { f(); } catch (e) {} });
            });
    }
    function warm() { if (!warmed) { warmed = true; load(); } }

    /* ---------- query parse ---------- */
    var UNDER = { under: 1, below: 1, less: 1, max: 1, upto: 1, within: 1, up: 1, cheaper: 1 };
    var OVER = { over: 1, above: 1, min: 1, least: 1, more: 1, minimum: 1 };
    var SKIP = { aed: 1, dirham: 1, dirhams: 1, dhs: 1, price: 1, cost: 1, the: 1, and: 1, 'for': 1, 'with': 1, a: 1, of: 1, 'in': 1, to: 1, than: 1, at: 1, only: 1, is: 1, my: 1 };
    var FIELDS = [['_name', 10], ['_col', 6], ['_kw', 5], ['_cat', 4], ['_desc', 1]];

    function parse(raw) {
        var s = digits(raw).replace(/<=?/g, ' under ').replace(/>=?/g, ' over ');
        var n = norm(s);
        var q = { raw: raw, toks: [], stems: [], max: null, min: null, hasText: false, any: false, phrase: '' };
        if (!n) { return q; }
        var mode = null;
        n.split(' ').forEach(function (t) {
            if (UNDER[t]) { mode = 'max'; return; }
            if (OVER[t]) { mode = 'min'; return; }
            if (SKIP[t]) { return; }
            if (isNum(t)) {
                var v = parseInt(t, 10);
                if (mode === 'max') { q.max = v; mode = null; return; }
                if (mode === 'min') { q.min = v; mode = null; return; }
                q.toks.push(t); q.stems.push(t);
                return;
            }
            mode = null;
            q.toks.push(t); q.stems.push(stem(t));
        });
        q.hasText = q.toks.length > 0;
        q.any = q.hasText || q.max !== null || q.min !== null;
        q.phrase = q.toks.join(' ');
        return q;
    }

    /* ---------- scoring ---------- */
    function fieldScore(ws, ts, numeric, loose) {
        var best = 0, i, w, s, m;
        for (i = 0; i < ws.length; i++) {
            w = ws[i]; s = 0;
            if (w === ts) { s = 1; }
            else if (!numeric) {
                if (w.indexOf(ts) === 0) { s = 0.8; }
                else if (w.length >= 4 && ts.indexOf(w) === 0 && ts.length - w.length <= 2) { s = 0.7; }
                else if (ts.length >= 3 && w.indexOf(ts) > 0) { s = 0.5; }
                else if (ts.length >= 4 && w.length >= 3) {
                    m = ts.length >= 7 ? 2 : 1;
                    if (lev(w, ts, m) <= m) { s = 0.4; }
                    else if (loose && w.length >= 4 && dice(w, ts) >= 0.6) { s = 0.3; }
                }
