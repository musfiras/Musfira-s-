<script is:inline>
    // Move drawer and backdrop straight under the page body so they always sit above WhatsApp and chat buttons
    (function () {
        var ov = document.getElementById("drawerOverlay");
        var dr = document.getElementById("sideNav");
        if (ov) { if (ov.parentNode !== document.body) { document.body.appendChild(ov); } }
        if (dr) { if (dr.parentNode !== document.body) { document.body.appendChild(dr); } }
    })();

    function openNav() {
        var d = document.getElementById("sideNav");
        d.classList.add("active");
        d.setAttribute("aria-hidden", "false");
        document.getElementById("drawerOverlay").classList.add("active");
        document.body.style.overflow = "hidden";
    }
    function closeNav() {
        var d = document.getElementById("sideNav");
        d.classList.remove("active");
        d.setAttribute("aria-hidden", "true");
        document.getElementById("drawerOverlay").classList.remove("active");
        document.body.style.overflow = "";
    }
    function closeDropdown(e) {
        if (e) { e.stopPropagation(); }
        var dd = document.getElementById("mDropdown");
        dd.classList.remove("open");
        if (dd.contains(document.activeElement)) { document.activeElement.blur(); }
    }
    function openAbout() { document.getElementById("aboutModal").style.display = "block"; }
    function closeAbout() { document.getElementById("aboutModal").style.display = "none"; }
    window.onclick = function(e) { if(e.target == document.getElementById("aboutModal")) { closeAbout(); } };;

    // Scroll pe bar chup jaye, scroll rukne ke baad slowly wapas aa jaye
    (function () {
        var hdr = document.querySelector(".header-section");
        if (!hdr) { return; }
        var stopTimer = null;
        window.addEventListener("scroll", function () {
            if ((window.pageYOffset || document.documentElement.scrollTop) > 5) {
                hdr.classList.add("scrolling");
            }
            clearTimeout(stopTimer);
            stopTimer = setTimeout(function () { hdr.classList.remove("scrolling"); }, 350);
        }, { passive: true });
    })();

    // Categories dropdown: hover on mouse, tap on touch, always re-opens, closes with X / outside click / Esc
    (function () {
        var dd = document.getElementById("mDropdown");
        if (!dd) { return; }
        var trigger = dd.querySelector(".dropdown-trigger");
        var closeTimer = null;
        var lastType = "mouse";

        function openDd() { clearTimeout(closeTimer); dd.classList.add("open"); }
        function closeDd() { clearTimeout(closeTimer); dd.classList.remove("open"); }
        function closeSoon() { clearTimeout(closeTimer); closeTimer = setTimeout(closeDd, 160); }

        dd.addEventListener("pointerdown", function (e) { lastType = e.pointerType || "mouse"; });
        dd.addEventListener("pointerenter", function (e) { if (e.pointerType === "mouse") { openDd(); } });
        trigger.addEventListener("pointerover", function (e) { if (e.pointerType === "mouse") { openDd(); } });
        dd.addEventListener("pointerleave", function (e) { if (e.pointerType === "mouse") { closeSoon(); } });

        trigger.addEventListener("click", function (e) {
            e.stopPropagation();
            if (lastType === "mouse") { openDd(); } else { dd.classList.toggle("open"); }
        });
        trigger.addEventListener("keydown", function (e) {
            if (e.key === "Enter" || e.key === " ") { e.preventDefault(); dd.classList.toggle("open"); }
        });
        document.addEventListener("click", function (e) {
            if (!dd.contains(e.target)) { closeDd(); }
        });
        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape") { closeDd(); closeNav(); }
        });
    })();

    // Cart count badge: number 0 ho to chhupa do, 1+ ho to bag ke andar dikhao (cart script jaise bhi likhe)
    (function () {
        var b = document.getElementById("m-global-count");
        if (!b) { return; }
        function sync() {
            var n = parseInt(String(b.textContent).replace(/\D/g, ""), 10) || 0;
            b.setAttribute("data-empty", n > 0 ? "0" : "1");
            b.setAttribute("data-len", String(Math.min(String(n).length, 3)));
        }
        sync();
        new MutationObserver(sync).observe(b, { childList: true, characterData: true, subtree: true });
    })();
</script>

