        body.innerHTML = h;
        bindItems();
        setActive(0, false);
    }
    function render() {
        var raw = input.value;
        clearBtn.hidden = !raw;
        if (!DB) {
            body.innerHTML = failed
                ? '<div class="ms-state">Search is unavailable right now.</div><div class="ms-chips" style="justify-content:center;"><a class="ms-chip ms-chip-main" href="/store/">Browse all products \u2192</a></div>'
                : '<div class="ms-state">Loading\u2026</div>';
