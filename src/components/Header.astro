    }
    // koi bhi lafz mil jaye (jitne zyada milen utna upar)
    function orScore(p, q, loose) {
        var total = 0, i;
        for (i = 0; i < q.stems.length; i++) { total += tokScore(p, q.stems[i], loose, false); }
        return total;
    }
    function collect(fn) {
        var res = [];
        DB.products.forEach(function (p, idx) {
            var s = fn(p);
            if (s > 0) { res.push({ p: p, s: s, i: idx }); }
        });
        res.sort(function (a, b) {
            if (b.s !== a.s) { return b.s - a.s; }
            var as = a.p.stock === false ? 1 : 0, bs = b.p.stock === false ? 1 : 0;
            if (as !== bs) { return as - bs; }
            return a.i - b.i;
        });
        return res;
    }
    function nearest(target) {
        var r = DB.products.map(function (p, i) { return { p: p, s: 1, i: i, d: Math.abs(p.p - target) }; });
        r.sort(function (a, b) { return (a.d - b.d) || (a.i - b.i); });
        return r.slice(0, 6);
    }
    function picks() {
        var r = [];
        DB.products.forEach(function (p, i) { if (p.h) { r.push({ p: p, s: 1, i: i }); } });
        if (!r.length) { DB.products.forEach(function (p, i) { r.push({ p: p, s: 1, i: i }); }); }
        return r.slice(0, 4);
    }

    // Poora search: pehle exact, phir milta julta, phir shakal se milta, phir qeemat ke qareeb, aakhir mein "aap ko pasand aa sakta hai"
    function search(q) {
        var P = DB.products;
        function ok(p) { return (q.max === null || p.p <= q.max) && (q.min === null || p.p >= q.min); }
        var res, t;
        if (!q.hasText) {
            res = [];
            P.forEach(function (p, i) { if (ok(p)) { res.push({ p: p, s: 1, i: i }); } });
            if (res.length) {
                res.sort(function (a, b) { return (a.p.p - b.p.p) || (a.i - b.i); });
                return { kind: 'exact', list: res };
            }
            t = q.max !== null ? q.max : q.min;
            return { kind: 'nearprice', list: nearest(t) };
        }
        res = collect(function (p) { return ok(p) ? andScore(p, q) : 0; });
        if (res.length) { return { kind: 'exact', list: res }; }
        res = collect(function (p) { return ok(p) ? orScore(p, q, false) : 0; });
        if (res.length) { return { kind: 'close', list: res }; }
        res = collect(function (p) { return ok(p) ? orScore(p, q, true) : 0; });
        if (res.length) { return { kind: 'close', list: res }; }
        if (q.max !== null || q.min !== null) {
            res = collect(function (p) { return orScore(p, q, true); });
            if (res.length) { return { kind: 'noprice', list: res }; }
        }
        var nums = q.toks.filter(isNum);
        if (nums.length && nums.length === q.toks.length) {
            return { kind: 'nearprice', list: nearest(parseInt(nums[0], 10)), target: parseInt(nums[0], 10) };
        }
        return { kind: 'none', list: picks() };
    }

    /* ---------- render ---------- */
    function hl(text, toks) {
        var t = String(text == null ? '' : text);
        if (!toks || !toks.length) { return esc(t); }
        var low = t.toLowerCase(), mk = [], i, j;
        for (i = 0; i < t.length; i++) { mk[i] = 0; }
        toks.forEach(function (tok) {
            if (tok.length < 2) { return; }
            var cands = [tok], st = stem(tok);
            if (st !== tok) { cands.push(st); }
            cands.forEach(function (c) {
                var pos = low.indexOf(c);
                while (pos > -1) {
                    for (j = pos; j < pos + c.length; j++) { mk[j] = 1; }
                    pos = low.indexOf(c, pos + c.length);
                }
            });
        });
        var out = '', open = false;
        for (i = 0; i < t.length; i++) {
            if (mk[i] && !open) { out += '<mark class="ms-hl">'; open = true; }
            if (!mk[i] && open) { out += '</mark>'; open = false; }
            out += esc(t.charAt(i));
        }
        if (open) { out += '</mark>'; }
        return out;
    }
    function itemHtml(p, toks, i) {
        var cols = p.c.length ? (p.c.length + (p.c.length === 1 ? ' Color: ' : ' Colors: ') + p.c.join(' \u00b7 ')) : '';
        return '<a class="ms-item" role="option" href="/product/' + encodeURIComponent(p.s) + '" style="animation-delay:' + (Math.min(i, 8) * 30) + 'ms">'
            + '<img class="ms-thumb" src="' + esc(p.i) + '" alt="" loading="lazy" width="64" height="64">'
            + '<span class="ms-info">'
            + '<span class="ms-name">' + hl(p.n, toks) + '</span>'
            + (cols ? '<span class="ms-meta">' + hl(cols, toks) + '</span>' : '')
            + '<span class="ms-prices"><b class="ms-new">AED ' + esc(p.p) + '</b>'
            + (p.o > p.p ? '<s class="ms-old">AED ' + esc(p.o) + '</s>' : '')
            + (p.stock === false ? '<em class="ms-sold">Sold out</em>' : '')
            + '</span></span><span class="ms-go" aria-hidden="true">\u2192</span></a>';
    }
    function browseChips() {
        var h = '<div class="ms-chips">';
        DB.categories.forEach(function (c) {
            h += '<a class="ms-chip" href="/' + esc(c.slug) + '/">' + esc(c.title) + '</a>';
        });
        return h + '<a class="ms-chip" href="/store/">Shop All</a></div>';
    }
    function bindItems() {
        items = Array.prototype.slice.call(body.querySelectorAll('.ms-item'));
        active = -1;
        body.scrollTop = 0;
    }
    function setActive(i, scroll) {
        if (active > -1 && items[active]) { items[active].classList.remove('is-active'); }
        active = i;
        if (i > -1 && items[i]) {
            items[i].classList.add('is-active');
            if (scroll && items[i].scrollIntoView) { try { items[i].scrollIntoView({ block: 'nearest' }); } catch (e) {} }
        }
    }
    function listHtml(res, toks) {
        var h = '<div class="ms-list" role="listbox">';
        res.slice(0, MAX_RESULTS).forEach(function (r, i) { h += itemHtml(r.p, toks, i); });
        return h + '</div>';
    }
    function renderHome() {
        var h = '', rec = getRecent();
        if (rec.length) {
            h += '<div class="ms-label"><span>Recent</span><button type="button" class="ms-link" data-act="clear-recent">Clear</button></div><div class="ms-chips">';
            rec.forEach(function (r) { h += '<button type="button" class="ms-chip" data-q="' + esc(r) + '">' + esc(r) + '</button>'; });
            h += '</div>';
        }
        h += '<div class="ms-label"><span>Browse</span></div>' + browseChips();
        var pk = picks();
        if (pk.length) {
            h += '<div class="ms-label"><span>Quick picks</span></div>' + listHtml(pk, []);
        }
        body.innerHTML = h;
        bindItems();
    }
    function renderNone(raw, r) {
        var h = '<div class="ms-none"><div class="ms-none-t">Nothing matched \u201c' + esc(raw.trim()) + '\u201d</div>'
            + '<div class="ms-none-s">Try a product name, a colour, or a price like \u201cunder 60\u201d.</div></div>';
        if (r.list.length) { h += '<div class="ms-label"><span>You might like</span></div>' + listHtml(r.list, []); }
        h += '<div class="ms-label"><span>Browse</span></div>' + browseChips()
            + '<div class="ms-chips" style="margin-top:14px;"><a class="ms-chip ms-chip-main" href="/store/">Browse all products \u2192</a></div>';
        body.innerHTML = h;
        bindItems();
    }
    function renderFound(r, q, raw) {
        var n = r.list.length, h = '', rawS = esc(raw.trim());
        if (r.kind === 'exact') {
            var note = '';
            if (q.max !== null) { note += ' \u00b7 under AED ' + q.max; }
            if (q.min !== null) { note += ' \u00b7 from AED ' + q.min; }
            h += '<div class="ms-label"><span>' + n + (n === 1 ? ' result' : ' results') + esc(note) + '</span></div>';
        } else if (r.kind === 'close') {
            h += '<div class="ms-note">No exact match for <b>\u201c' + rawS + '\u201d</b>. These are the closest.</div>';
        } else if (r.kind === 'noprice') {
            var lim = q.max !== null ? ('under AED ' + q.max) : ('from AED ' + q.min);
            h += '<div class="ms-note">Nothing <b>' + esc(lim) + '</b> for \u201c' + rawS + '\u201d. These are the closest options.</div>';
        } else if (r.kind === 'nearprice') {
            var lbl;
            if (q.max !== null) { lbl = 'Nothing under <b>AED ' + q.max + '</b>. These are the closest prices.'; }
            else if (q.min !== null) { lbl = 'Nothing from <b>AED ' + q.min + '</b>. These are the closest prices.'; }
            else { lbl = 'No exact price match. These are closest to <b>AED ' + esc(r.target) + '</b>.'; }
            h += '<div class="ms-note">' + lbl + '</div>';
