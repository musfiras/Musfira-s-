---
// =====================================================================
//  MUSFIRAS - HERO SLIDER - MASTER CONTROL PANEL
//  Banners clickable nahi hain. Sirf images badalni hain.
//  Neeche ka code (HTML / CSS / JS) ko haath lagane ki zaroorat nahi.
// =====================================================================

// ---------- 1) SLIDER SETTINGS ----------
const SLIDE_TIME_SECONDS = 4.5;   // har banner kitni der rukay (3 se 5 best hai)

// ---------- 2) 4 SLIDES: IMAGE (DESKTOP aur MOBILE ALAG) ----------
// Images public/products/ folder me hain (WebP, naam: bnr1.webp ... bnr8.webp).
// Agar koi slide abhi ready nahi hai to uski dono images "" khali chor do.

const MFS_SLIDES = [
  {
    // ===== SLIDE 1: Bundle Offer =====
    desktopImage: "/products/bnr1.webp",   // bnr 1 = desktop
    mobileImage:  "/products/bnr2.webp",   // bnr 2 = mobile
    alt: "Buy more, save more. Bundle deals at Musfira's",
  },
  {
    // ===== SLIDE 2: Bags & Carrying =====
    desktopImage: "/products/bnr3.webp",   // bnr 3 = desktop
    mobileImage:  "/products/bnr6.webp",   // bnr 6 = mobile
    alt: "Bags and carrying collection by Musfira's",
  },
  {
    // ===== SLIDE 3: Fashion & Accessories =====
    desktopImage: "/products/bnr5.webp",   // bnr 5 = desktop
    mobileImage:  "/products/bnr4.webp",   // bnr 4 = mobile
    alt: "Fashion and accessories by Musfira's",
  },
  {
    // ===== SLIDE 4: Musfira's Choice =====
    desktopImage: "/products/bnr7.webp",   // bnr 7 = desktop
    mobileImage:  "/products/bnr8.webp",   // bnr 8 = mobile
    alt: "Musfira's Choice, watches, wallets and bags",
  },
];

// ---------- Neeche kuch change nahi karna ----------
const slides = MFS_SLIDES.filter((s) => s.desktopImage || s.mobileImage).map((s) => ({
  ...s,
  desktopImage: s.desktopImage || s.mobileImage,
  mobileImage: s.mobileImage || s.desktopImage,
}));
const total = slides.length;
---

<section
  class="mfs-hero-wrap"
  aria-roledescription="carousel"
  aria-label="Featured collections"
  data-mfs-slider
  data-delay={SLIDE_TIME_SECONDS * 1000}
>
  <h1 class="mfs-sr-only">Musfira's - Made to adore</h1>

  <div class="mfs-hero-frame">
    <div class="mfs-viewport">
      {
        slides.map((s, i) => (
          <div
            class={`mfs-slide${i === 0 ? " is-active" : ""}`}
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${total}`}
          >
            <div class="mfs-slide-link">
              <picture>
                <source media="(max-width: 767px)" srcset={s.mobileImage} />
                <img
                  src={s.desktopImage}
                  alt={s.alt}
                  width="1920"
                  height="720"
                  loading={i === 0 ? "eager" : "lazy"}
                  fetchpriority={i === 0 ? "high" : "auto"}
                  decoding="async"
                  draggable="false"
                />
              </picture>
            </div>
          </div>
        ))
      }
    </div>

    {
      total > 1 && (
        <>
          <button class="mfs-arrow mfs-prev" type="button" aria-label="Previous banner">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="mfs-arrow mfs-next" type="button" aria-label="Next banner">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </>
      )
    }
  </div>

  {
    total > 1 && (
      <div class="mfs-dots" role="tablist" aria-label="Choose banner">
        {slides.map((_, i) => (
          <button
            class={`mfs-dot${i === 0 ? " is-active" : ""}`}
            type="button"
            role="tab"
            aria-label={`Go to banner ${i + 1}`}
            aria-selected={i === 0 ? "true" : "false"}
          />
        ))}
      </div>
    )
  }
</section>

<style is:global>
  :root {
    --mfs-pink: #e6007e;
    --mfs-maroon: #8e0b3f;
  }

  .mfs-hero-wrap {
    width: 100%;
    background: #ffffff;
    padding: 22px 24px 8px;
  }
  .mfs-hero-wrap *,
  .mfs-hero-wrap *::before,
  .mfs-hero-wrap *::after {
    box-sizing: border-box;
  }

  /* Ubhra howa (raised) look: shadow + halka border + gol corners */
  .mfs-hero-frame {
    position: relative;
    /* HEIGHT KAM/ZYADA: sirf max-width badlo. Chhota number = kam height.
       1080px = height lagbhag 405px. (1320px = 495px, 960px = 360px) */
    max-width: 1080px;
    margin: 0 auto;
    border-radius: 22px;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.07);
    box-shadow:
      0 -6px 16px -4px rgba(0, 0, 0, 0.07),
      0 2px 4px rgba(0, 0, 0, 0.06),
      0 12px 28px -6px rgba(0, 0, 0, 0.16);
    overflow: hidden;
  }

  /* Ratio images ke barabar hai (1920x720), isliye banner kahin se cut nahi hota */
  .mfs-viewport {
    position: relative;
    width: 100%;
    aspect-ratio: 1920 / 720;
    overflow: hidden;
    touch-action: pan-y;
  }

  /* SLIDE ANIMATION: speed yahan se (1.1s = slow aur smooth, zyada slow ke liye 1.5s) */
  .mfs-slide {
    position: absolute;
    inset: 0;
    transform: translateX(100%);
    transition: transform 1.1s cubic-bezier(0.65, 0, 0.35, 1);
    will-change: transform;
  }
  .mfs-slide.is-active {
    transform: translateX(0);
    z-index: 1;
  }
  .mfs-slide-link {
    display: block;
    width: 100%;
    height: 100%;
  }
  .mfs-slide-link {
    cursor: default;
  }
  .mfs-slide picture,
  .mfs-slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* Arrows */
  .mfs-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(142, 11, 63, 0.15);
    background: rgba(255, 255, 255, 0.92);
    color: var(--mfs-maroon);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
    opacity: 0;
    transition: opacity 0.25s ease, background 0.25s ease, color 0.25s ease;
  }
  .mfs-prev { left: 14px; }
  .mfs-next { right: 14px; }
  .mfs-hero-frame:hover .mfs-arrow,
  .mfs-arrow:focus-visible {
    opacity: 1;
  }
  .mfs-arrow:hover {
    background: var(--mfs-pink);
    color: #ffffff;
  }
  .mfs-arrow:focus-visible {
    outline: 3px solid var(--mfs-pink);
    outline-offset: 2px;
  }

  /* Dots */
  .mfs-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
    padding: 14px 0 4px;
  }
  .mfs-dot {
    width: 5px;
    height: 5px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.18);
    cursor: pointer;
    transition: width 0.3s ease, background 0.3s ease;
  }
  .mfs-dot.is-active {
    width: 18px;
    background: var(--mfs-maroon);
  }
  .mfs-dot:focus-visible {
    outline: 2px solid var(--mfs-maroon);
    outline-offset: 3px;
  }

  .mfs-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Mobile: ratio 4:5 (1080x1350), arrows hide, thora chhota margin */
  @media (max-width: 767px) {
    .mfs-hero-wrap {
      padding: 12px 26px 4px;   /* side ka gap barha kar mobile banner ki height kam ki */
    }
    .mfs-hero-frame {
      border-radius: 18px;
      box-shadow:
        0 -4px 12px -3px rgba(0, 0, 0, 0.07),
        0 2px 4px rgba(0, 0, 0, 0.06),
        0 8px 18px -4px rgba(0, 0, 0, 0.15);
    }
    /* Mobile ratio images ke barabar (960x1200 = 4/5), koi cut nahi */
    .mfs-viewport {
      aspect-ratio: 4 / 5;
    }
    .mfs-arrow {
      display: none;
    }
    .mfs-dots {
      padding-top: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mfs-slide,
    .mfs-dot,
    .mfs-arrow {
      transition: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-mfs-slider]");

  if (root) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>(".mfs-slide"));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>(".mfs-dot"));
    const prevBtn = root.querySelector<HTMLButtonElement>(".mfs-prev");
    const nextBtn = root.querySelector<HTMLButtonElement>(".mfs-next");
    const viewport = root.querySelector<HTMLElement>(".mfs-viewport");
    const delay = Number(root.dataset.delay) || 4500;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let current = 0;
    let timer: number | undefined;

    // dir = 1 (agla banner, right se aaye) / -1 (pichla banner, left se aaye)
    const show = (index: number, dir = 1) => {
      const next = (index + slides.length) % slides.length;
      if (next === current) return;
      const outgoing = slides[current];
      const incoming = slides[next];

      // baqi slides ko side me park karo (bina animation)
      slides.forEach((slide) => {
        if (slide !== outgoing && slide !== incoming) {
          slide.style.transition = "none";
          slide.style.transform = "translateX(100%)";
        }
      });

      // incoming ko side par rakho (bina animation), phir andar le aao
      incoming.style.transition = "none";
      incoming.style.transform = `translateX(${dir * 100}%)`;
      void incoming.offsetWidth; // browser ko position yaad karwao
      incoming.style.transition = "";
      incoming.style.transform = "translateX(0)";

      // purana banner dusri side se nikal jaye
      outgoing.style.transition = "";
      outgoing.style.transform = `translateX(${-dir * 100}%)`;

      current = next;
      slides.forEach((slide, i) => {
        slide.classList.toggle("is-active", i === current);
        slide.setAttribute("aria-hidden", i === current ? "false" : "true");
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle("is-active", i === current);
        dot.setAttribute("aria-selected", i === current ? "true" : "false");
      });
    };

    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    };
    const start = () => {
      stop();
      if (slides.length < 2 || reduceMotion || document.hidden) return;
      timer = window.setInterval(() => show(current + 1, 1), delay);
    };
    const go = (index: number, dir = 1) => {
      show(index, dir);
      start(); // click ke baad timer dobara shuru
    };

    prevBtn?.addEventListener("click", () => go(current - 1, -1));
    nextBtn?.addEventListener("click", () => go(current + 1));
    dots.forEach((dot, i) => dot.addEventListener("click", () => go(i, i > current ? 1 : -1)));

    // Mouse upar ho ya keyboard focus ho to ruk jaye
    root.addEventListener("mouseenter", stop);
    root.addEventListener("mouseleave", start);
    root.addEventListener("focusin", stop);
    root.addEventListener("focusout", start);

    // Tab chhupa ho to autoplay band
    document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));

    // Mobile swipe
    let startX = 0;
    let startY = 0;
    viewport?.addEventListener(
      "touchstart",
      (e) => {
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
        stop();
      },
      { passive: true }
    );
    viewport?.addEventListener(
      "touchend",
      (e) => {
        const dx = e.changedTouches[0].clientX - startX;
        const dy = e.changedTouches[0].clientY - startY;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
          go(dx < 0 ? current + 1 : current - 1, dx < 0 ? 1 : -1);
        } else {
          start();
        }
      },
      { passive: true }
    );

    slides.forEach((slide, i) => slide.setAttribute("aria-hidden", i === 0 ? "false" : "true"));

    // Site load hone ke baad baqi banners pehle se load kar lo, taake slide me khali na dikhe
    window.addEventListener("load", () => {
      root.querySelectorAll<HTMLImageElement>("img[loading='lazy']").forEach((img) => (img.loading = "eager"));
    });

    start();
  }
</script>