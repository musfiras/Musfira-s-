---
// =====================================================================
//  MUSFIRAS - HERO BANNER - MASTER CONTROL PANEL
//  Yahan se sirf text / image / link badalna hai
// =====================================================================
const MFS_HERO_CONFIG = {
  image: "/tbnr.jpeg", // public folder wali apni site ki image
  alt: "Bags and carry collection by Musfira's",
  heading: "Bags & Carrying",
  subheading: "Carry Everything. Compromise Nothing.",
  sub: "Spacious, durable carry bags made for women who do it all, in style",
  btnText: "Explore the Collection",
  btnHref: "/bags_carrying/",
};
---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,700;1,6..96,400&family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

<style is:global>
:root{
  --pink:#e6007e;
  --soft-pink:rgba(230,0,126,0.06);
  --maroon:#a8402d;
  --heading-maroon:#9c2954;
  --white:#ffffff;
  --text-dark:#1a1a1a;
  --muted:#555555;
}

html{scroll-behavior:smooth;}

.mfs-page{
  position:relative;
  width:100%;max-width:100%;
  margin:0;padding:0;
  overflow-x:hidden;
  background:var(--white);
  font-family:'Montserrat',sans-serif;
  color:var(--text-dark);
  -webkit-font-smoothing:antialiased;
}
.mfs-page,.mfs-page *,.mfs-page *::before,.mfs-page *::after{box-sizing:border-box;margin:0;padding:0;}
.mfs-page img{display:block;width:100%;height:100%;object-fit:cover;}
.mfs-page a{text-decoration:none;color:inherit;display:inline-block;}

/* HERO BANNER */
a.mfs-hero{
  display:flex !important;
  flex-direction:column;
  width:100%;
  background:var(--white);
}
.mfs-hero-img-wrap{
  position:relative;
  width:100%;
  height:45vh;
  min-height:320px;
  max-height:520px;
  overflow:hidden;
  background:#f9f9f9;
}
.mfs-hero-img{width:100%;height:100%;object-fit:cover;object-position:center;transition:transform 0.8s ease;}
.mfs-hero:hover .mfs-hero-img{transform:scale(1.03);}

.mfs-hero-content{
  width:100% !important;
  max-width:820px !important;
  margin:0 auto !important;
  padding:36px 24px 44px !important;
  text-align:center !important;
}
.mfs-hero-heading{
  font-family:'Bodoni Moda',serif !important;
  font-size:clamp(24px, 4vw, 40px) !important;
  font-weight:800 !important;
  color:var(--heading-maroon) !important;
  line-height:1.3 !important;
  margin:0 0 10px 0 !important;
}
.mfs-hero-subheading{
  font-size:clamp(12px, 1.5vw, 15px) !important;
  font-weight:700 !important;
  color:var(--pink) !important;
  letter-spacing:0.6px !important;
  text-transform:uppercase !important;
  margin:0 0 16px 0 !important;
}
.mfs-hero-sub{
  font-size:clamp(12.5px, 1.5vw, 15px) !important;
  font-weight:500 !important;
  color:var(--muted) !important;
  margin:0 auto 28px !important;
  max-width:480px !important;
  line-height:1.6 !important;
}
.mfs-hero-btn{
  display:inline-flex !important;align-items:center !important;justify-content:center !important;gap:12px !important;
  background:transparent !important;
  color:var(--maroon) !important;
  border:1.5px solid var(--maroon) !important;
  font-size:13px !important;
  font-weight:700 !important;letter-spacing:0.5px !important;text-transform:uppercase !important;
  white-space:nowrap !important;
  padding:15px 38px !important;border-radius:50px !important;
  margin:0 !important;
  cursor:pointer;
  transition:all 0.3s ease;
}
.mfs-hero-btn svg path{stroke:var(--maroon); transition:stroke .3s ease;}
.mfs-hero:hover .mfs-hero-btn,
.mfs-hero:focus-visible .mfs-hero-btn{
  background:var(--pink) !important;
  border-color:var(--pink) !important;
  color:var(--white) !important;
  box-shadow:0 6px 18px rgba(230,0,126,0.35);
}
.mfs-hero:hover .mfs-hero-btn svg path,
.mfs-hero:focus-visible .mfs-hero-btn svg path{stroke:var(--white);}
.mfs-hero:focus-visible{outline:3px solid var(--pink);outline-offset:-3px;}

@media(max-width:767px){
  .mfs-hero-img-wrap{height:34vh !important;min-height:220px !important;}
  .mfs-hero-content{padding:28px 20px 36px !important;}
  .mfs-hero-btn{padding:13px 30px !important;font-size:12px !important;}
}
@media(prefers-reduced-motion:reduce){
  .mfs-hero-img,.mfs-hero-btn{transition:none !important;}
  .mfs-hero:hover .mfs-hero-img{transform:none;}
}
</style>

<main class="mfs-page">
  <a class="mfs-hero" id="mfsHeroLink" href={MFS_HERO_CONFIG.btnHref}>
    <div class="mfs-hero-img-wrap">
      <img
        id="mfsHeroImg"
        class="mfs-hero-img"
        src={MFS_HERO_CONFIG.image}
        alt={MFS_HERO_CONFIG.alt}
        width="1774"
        height="887"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="mfs-hero-content">
      <h1 class="mfs-hero-heading" id="mfsHeroHeading">{MFS_HERO_CONFIG.heading}</h1>
      <p class="mfs-hero-subheading" id="mfsHeroSubheading">{MFS_HERO_CONFIG.subheading}</p>
      <p class="mfs-hero-sub" id="mfsHeroSub">{MFS_HERO_CONFIG.sub}</p>
      <span class="mfs-hero-btn">
        <span id="mfsHeroBtnText">{MFS_HERO_CONFIG.btnText}</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" style="flex-shrink:0;" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </div>
  </a>
</main>