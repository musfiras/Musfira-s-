---
const href = "https://www.musfiras.com/musfiras_choice";
---

<section class="mfp-page" aria-label="Musfira's Choice">
  <div class="mfp-top-divider" aria-hidden="true"><span></span></div>

  <div class="mfp-bar">
    <div class="mfp-text">
      <h2 class="mfp-heading"><span class="mfp-brand">Musfira's</span> Choice</h2>
      <p class="mfp-tagline">Handpicked ladies' favourites across every category, chosen to elevate your style.</p>
    </div>

    <a class="mfp-btn" href={href}>
      View All
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none">
        <path d="M5 12h14M13 6l6 6-6 6" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>

  <!-- yahan baad mein 4 products aayenge -->
  <slot />
</section>

<style is:global>
  .mfp-page {
    --mfp-pink: #e6007e;
    --mfp-maroon: #6b0c23;
    width: 100%;
    font-family: 'Montserrat', sans-serif;
    -webkit-font-smoothing: antialiased;
    text-align: left;
  }
  .mfp-page,
  .mfp-page *,
  .mfp-page *::before,
  .mfp-page *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .mfp-top-divider {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 24px 22px 0;
    display: flex;
    justify-content: center;
  }
  .mfp-top-divider span {
    display: block;
    height: 1px;
    width: 100%;
    max-width: 340px;
    background: var(--mfp-pink);
    opacity: 0.35;
  }
  @media (min-width: 768px) {
    .mfp-top-divider { padding: 30px 32px 0; }
  }
  @media (min-width: 1024px) {
    .mfp-top-divider { padding: 36px 40px 0; }
  }

  .mfp-bar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    max-width: 1240px;
    margin: 0 auto;
    padding: 32px 22px 20px;
  }
  @media (min-width: 768px) {
    .mfp-bar { padding: 40px 32px 24px; align-items: center; }
  }
  @media (min-width: 1024px) {
    .mfp-bar { padding: 48px 40px 28px; }
  }

  .mfp-text { text-align: left; }

  .mfp-heading {
    font-family: 'Bodoni Moda', serif;
    font-weight: 700;
    font-size: clamp(22px, 3.2vw, 32px);
    color: var(--mfp-maroon);
    line-height: 1.2;
  }
  .mfp-brand { color: var(--mfp-pink); font-weight: 800; }

  .mfp-tagline {
    font-family: 'Bodoni Moda', serif;
    font-weight: 600;
    font-style: italic;
    font-size: clamp(12.5px, 1.5vw, 14.5px);
    color: var(--mfp-maroon);
    line-height: 1.5;
    margin-top: 6px;
  }

  .mfp-btn {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    color: var(--mfp-pink);
    border: 1.5px solid var(--mfp-pink);
    border-radius: 50px;
    padding: 9px 18px;
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(10.5px, 1.1vw, 12px);
    font-weight: 800;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    white-space: nowrap;
    text-decoration: none;
    transition: all 0.25s ease;
  }
  .mfp-btn:hover {
    background: var(--mfp-pink);
    border-color: var(--mfp-pink);
    color: #fff;
    box-shadow: 0 6px 16px rgba(230, 0, 126, 0.3);
  }
  .mfp-btn svg path { stroke: var(--mfp-pink); transition: stroke 0.25s ease; }
  .mfp-btn:hover svg path { stroke: #fff; }

  @media (max-width: 480px) {
    .mfp-btn { padding: 7px 14px; font-size: 10px; }
  }
</style>