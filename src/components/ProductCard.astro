---
const { p, checkoutUrl } = Astro.props;
const href = `/product/${p.slug}`;
const save = p.oldPrice - p.price;
const n = Object.keys(p.stock).length;
---
<div class="m-item-wrapper">
  <div class="m-item">
    <div
      class="m-master-box"
      id={p.id}
      data-pname={p.name}
      data-base={p.price}
      data-offer2={p.offer2}
      data-offer3={p.offer3}
      data-stock={JSON.stringify(p.stock)}
      data-checkout={checkoutUrl}
      data-href={href}
    >
      <div class="m-main-card">
        <div class="m-save-float">SAVE AED {save}</div>

        <div class="m-img-container">
          <img src={p.images[0]} alt={p.name} class="m-hero-img" loading="lazy" />
        </div>

        <div class="m-product-info">
          <div style="display: flex; justify-content: space-between; align-items: center; width: 100%; margin-bottom: 8px; gap: 4px;">
            <div class="m-txt-L m-colors-count" style="font-weight: 800; color: #e6007e; text-transform: uppercase; white-space: nowrap;">{n} {n === 1 ? 'Color' : 'Colors'}</div>
            <div class="m-stock-badge m-badge-L" style="margin: 0; padding: 2px 6px; white-space: nowrap;">
              <span class="m-dot-anim"></span> in stock
            </div>
          </div>
          <h2 class="m-pname-line">{p.name}</h2>
          <div class="m-price-row">
            <span class="m-new-p">AED {p.price}</span>
            <span class="m-old-p">AED {p.oldPrice}</span>
          </div>
          <a class="m-details-trigger" href={href}>view details</a>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* Chat ke Offers link se aane par card header ke neeche na chhupe */
  .m-master-box { scroll-margin-top: 110px; }
  @keyframes mCardFlash {
    0%   { box-shadow: 0 0 0 0 rgba(230,0,126,0); }
    25%  { box-shadow: 0 0 0 4px rgba(230,0,126,.35), 0 10px 28px rgba(230,0,126,.25); }
    100% { box-shadow: 0 0 0 0 rgba(230,0,126,0); }
  }
  .m-master-box.m-flash .m-main-card { animation: mCardFlash 2s ease; }
  @media (prefers-reduced-motion: reduce) { .m-master-box.m-flash .m-main-card { animation: none; } }
</style>

<script>
  // Product link par click: yaad rakho kaun sa product khola
  document.addEventListener("click", (e) => {
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="/product/"]');
    if (link) sessionStorage.setItem("lastProduct", link.getAttribute("href") || "");
  });

  // Sirf back dabane par: usi product tak scroll karo
  function restore() {
    const nav = performance.getEntriesByType("navigation")[0] as PerformanceNavigationTiming | undefined;
    if (nav && nav.type !== "back_forward") return;
    const href = sessionStorage.getItem("lastProduct");
    if (!href) return;
    const card = document.querySelector(`[data-href="${href}"]`);
    if (card) {
      card.scrollIntoView({ block: "center" });
      sessionStorage.removeItem("lastProduct");
    }
  }
  addEventListener("pageshow", () => setTimeout(restore, 120));

  // Chat ke Offers link se (/bags#PROD_30): usi card par scroll aur halka glow
  function focusHash() {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const el = document.getElementById(id);
    if (!el || !el.classList.contains("m-master-box")) return;
    el.scrollIntoView({ block: "center" });
    el.classList.add("m-flash");
    setTimeout(() => el.classList.remove("m-flash"), 2200);
  }
  if (document.readyState === "complete") setTimeout(focusHash, 150);
  else addEventListener("load", () => setTimeout(focusHash, 150));
</script>