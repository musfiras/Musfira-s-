---
import ProductNote from './ProductNote.astro';
const { p, checkoutUrl } = Astro.props;
const many = p.images.length > 1;
---
<div
  class="m-master-box"
  id={p.id}
  data-pname={p.name}
  data-base={p.price}
  data-offer2={p.offer2}
  data-offer3={p.offer3}
  data-stock={JSON.stringify(p.stock)}
  data-colorindex={JSON.stringify(p.colorIndex || {})}
  data-checkout={checkoutUrl}
>
  <div class="m-pop-overlay">
    <div class="m-pop-box">
      <div class="m-close-x">&times;</div>

      <div class="m-pop-layout">
        <div class="m-pop-left">

          <div class="m-slider-container">
            <div class="m-track" onscroll="syncDots(this)">
              {p.images.map((src, i) => (
                <img src={src} alt={`${p.name} ${i + 1}`} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
              ))}
            </div>
            <!-- zaroori: script setupDots() isay dhundti hai, is liye rakha hai (CSS se chhupa hua) -->
            <div class="m-dots-wrapper"></div>
          </div>

          {many && (
            <div class="m-thumbs-wrap">
              <div class="m-thumbs">
                {p.images.map((src, i) => (
                  <button type="button" class={i === 0 ? 'm-thumb is-on' : 'm-thumb'} data-i={i} aria-label={`Photo ${i + 1}`}>
                    <img src={src} alt="" width="56" height="56" loading="lazy" decoding="async" />
                  </button>
                ))}
              </div>
              <button type="button" class="m-thumbs-next" aria-label="More photos">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
              </button>
            </div>
          )}
        </div>

        <div class="m-pop-right">
          <!-- Bundle offer box script se banta hai, aur neeche wali script isay is heading ke UPAR rakhti hai -->
          <div class="m-sec-head" style="font-size: 11px; font-weight: 800; color: #E6007E; text-transform: uppercase; margin-top: 50px; margin-bottom: 12px; border-left: 3px solid #e6007e; padding-left: 8px;">Select Color & QTY</div>

          <!-- Sare colors ek hi line mein (script khud bharti hai) -->
          <div class="m-palette"></div>

          <!-- Neeche: remove + selected color + qty (har row mein) -->
          <div class="m-config-rows"></div>

          <!-- Add Color: rows ke NEECHE, chota soft button -->
          <button class="m-add-row-btn" onclick={`addDynamicRow('${p.id}')`}>+ ADD COLOR</button>

          <!-- Bundle ki live line (script isi ko bharti hai) -->
          <div class="m-offer-hint"></div>

          <div class="m-final-bill">Total: AED <span>{p.price}</span></div>

          <!-- Soft note: Total ke neeche, buttons se pehle. Wrapper par koi style nahi, sirf andar wala pill ubhra hua hai -->
          <div class="m-note-float">
            <ProductNote />
          </div>

          <button class="m-buy-now-btn" onclick={`goCheckout('${p.id}')`}>BUY IT NOW →</button>

          <button
            class="m-cart-add-trigger"
            onclick={`addToCartTrigger('${p.id}')`}
            style="width: 100%; background: #fff; border: 2px solid #800000; color: #800000; padding: 18px; border-radius: 50px; font-size: 14px; font-weight: 800; cursor: pointer; transition: 0.4s; text-transform: uppercase; letter-spacing: 1px; margin-top: 10px; display: block;"
          >ADD TO BAG +</button>

          <div id={`cart-alert-${p.id}`} style="display:none; color: #e6007e; font-size: 11px; font-weight: 700; margin-top: 10px; text-align: center; font-family: sans-serif;">
            ⚠️ Please select color & quantity first!
          </div>

          <div class="m-pop-description" set:html={p.descriptionHtml}></div>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
/* =====================================================
   PRODUCT PAGE UPDATE v18
   - Color select karne par us color ki photo slider mein aati hai (script mein)
   - Note ("Colors & size may vary"): text/layout overrides nahi, sirf border + shadow
   - "You save" ki jaga pehle se reserve
   - Description box ubhra hua, icons wale boxes thore bare
   - Pure white page, tight shadows
   - Desktop switch 975px par
   ===================================================== */

/* Floating look ke liye common values (yahin se sab badal sakte ho) */
.m-master-box {
  --m-bd: #e3a6c4;
  /* tight shadow: neeche ek chhoti gehri line, negative spread = side par kuch nahi phailta */
  --m-float: 0 4px 6px -3px rgba(80, 20, 40, .30), 0 1px 2px rgba(80, 20, 40, .08);
  --m-float-sm: 0 3px 4px -2px rgba(80, 20, 40, .28), 0 1px 1px rgba(80, 20, 40, .06);
  /* description box ke liye: thora zyada ubhra hua */
  --m-float-lg: 0 9px 14px -6px rgba(80, 20, 40, .34), 0 2px 4px rgba(80, 20, 40, .10);
}

/* 0) PURA PAGE WHITE */
body:has(.m-master-box),
.m-product-page-wrap,
.m-page-mode,
.m-master-box,
.m-pop-overlay,
.m-pop-box,
.m-pop-layout,
.m-pop-left,
.m-pop-right {
  background: #ffffff !important;
}

/* 1) Maroon line, heading, arrow, dots khatam */
.m-maroon-top-bar { display: none !important; }
.m-arrow-next { display: none !important; }
.m-dots-wrapper { display: none !important; }

/* 2) THUMBNAILS: chhote, har screen par fit (size screen ke hisaab se) */
.m-master-box { --m-th: clamp(40px, 11vw, 48px); }
@media (min-width: 481px) and (max-width: 974px) { .m-master-box { --m-th: 52px; } }
@media (min-width: 975px) { .m-master-box { --m-th: 56px; } }

.m-thumbs-wrap {
  position: relative; box-sizing: border-box; width: 100%;
  margin: 8px 0 10px; padding: 0 2px;
}
.m-thumbs-wrap.has-more { padding-right: 28px; }
.m-thumbs {
  position: relative;
  display: flex; gap: 7px; overflow-x: auto; scroll-behavior: smooth;
  scrollbar-width: none; -webkit-overflow-scrolling: touch;
  scroll-snap-type: x proximity;
  padding: 2px 3px 6px; margin: -2px -3px -4px;
}
.m-thumbs::-webkit-scrollbar { display: none; }
@keyframes m-shimmer {
  0%   { background-position: 120% 0; }
  100% { background-position: -120% 0; }
}
.m-thumb {
  flex: 0 0 var(--m-th); width: var(--m-th); height: var(--m-th);
  box-sizing: border-box; padding: 2px; margin: 0;
  /* placeholder: photo aane tak halka soft shimmer, khali nahi lagta */
  background: linear-gradient(110deg, #f7eff3 30%, #fffafc 50%, #f7eff3 70%);
  background-size: 220% 100%;
  animation: m-shimmer 1.4s linear infinite;
  border: 1px solid var(--m-bd); border-radius: 8px;
  box-shadow: var(--m-float-sm);
  cursor: pointer; scroll-snap-align: start; overflow: hidden;
  opacity: .85; transition: opacity .25s ease, border-color .25s ease, box-shadow .25s ease;
  -webkit-tap-highlight-color: transparent;
}
/* photo load hote hi placeholder band */
.m-thumb.is-ready { background: #fff; animation: none; }
.m-thumb img { width: 100%; height: 100%; object-fit: contain; display: block; border-radius: 6px; }
.m-thumb.is-on { opacity: 1; border-color: #e6007e; box-shadow: 0 0 0 1px #e6007e inset, var(--m-float-sm); }
@media (hover: hover) and (pointer: fine) { .m-thumb:hover { opacity: 1; border-color: #e6007e; } }
@media (prefers-reduced-motion: reduce) { .m-thumb { animation: none; } }
.m-thumbs-next {
  position: absolute; right: 0; top: 50%; transform: translateY(-50%);
  width: 22px; height: 22px; padding: 0; border-radius: 50%;
  display: none; align-items: center; justify-content: center;
  background: #fff; border: 1px solid var(--m-bd); color: #800000;
  box-shadow: var(--m-float-sm); cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}
.m-thumbs-wrap.has-more .m-thumbs-next { display: flex; }
.m-thumbs-next svg { width: 12px; height: 12px; stroke: currentColor; stroke-width: 2.4; fill: none; stroke-linecap: round; stroke-linejoin: round; }
.m-thumbs-next:active { background: #e6007e; color: #fff; border-color: #e6007e; }
@media (hover: hover) and (pointer: fine) { .m-thumbs-next:hover { background: #e6007e; color: #fff; border-color: #e6007e; } }
@media (min-width: 975px) {
  .m-thumbs-wrap { max-width: min(100%, 79vh); margin-left: auto; margin-right: auto; }
}

/* 3) BUNDLE OFFER: thora bara, pure white, dark border, tight shadow */
.m-offer-box {
  padding: 5px 7px 6px !important;
  margin-top: 18px !important;
  border: 1px solid var(--m-bd) !important;
  border-radius: 9px !important;
  background: #ffffff !important;
  box-shadow: var(--m-float) !important;
}
@media (max-width: 974px) { .m-offer-box { margin-top: 26px !important; } }
.m-offer-title {
  font-size: 8px !important; letter-spacing: 2.3px !important;
  margin: 0 0 4px !important; line-height: 1.2 !important;
  font-weight: 700 !important;
}
.m-offer-tiers { gap: 6px !important; }
.m-offer-tier {
  padding: 4px 4px !important; border-radius: 7px !important;
  line-height: 1.12 !important;
  box-shadow: var(--m-float-sm) !important;
}
.m-offer-tier:not([class*="sel"]):not([class*="act"]):not(.is-on):not(.on) {
  border-color: var(--m-bd) !important;
}
.m-ot-n { font-size: 8px !important; letter-spacing: .8px !important; line-height: 1.15 !important; }
.m-ot-new { font-size: 12px !important; margin-top: 1px !important; line-height: 1.15 !important; }
.m-ot-old { font-size: 8px !important; line-height: 1.1 !important; }
.m-offer-hint { font-size: 11px !important; margin: 3px 0 6px !important; }

/* 4) COLOR PALETTE: sare colors ek line mein, uthe hue chips */
.m-palette {
  display: flex; flex-wrap: wrap; justify-content: flex-start; align-items: center;
  gap: 14px 7px; padding: 6px 3px 7px; margin: 0 0 8px; text-align: left;
}
.m-palette:empty { display: none; }
.m-palette:has(.m-sw-sold) { row-gap: 22px; padding-bottom: 20px; }
.m-palette .m-swatch {
  padding: 3px 9px 3px 6px !important; min-height: 26px !important;
  font-size: 10.5px !important; font-weight: 700 !important; gap: 5px !important;
  border-radius: 8px !important;
  background: #fff;
  box-shadow: var(--m-float-sm) !important;
}
.m-palette .m-swatch:not(.is-sel) { border-color: var(--m-bd) !important; }
.m-palette .m-swatch.is-sel { font-weight: 800 !important; }
.m-palette .m-sw-dot { width: 11px !important; height: 11px !important; }
.m-palette .m-sw-stock { font-size: 7.5px !important; top: -6px !important; left: 7px !important; }
.m-master-box .m-palette .m-swatch .m-sw-sold b { font-size: 9.5px !important; }
.m-master-box .m-palette .m-swatch .m-sw-sold b::after { font-size: 9px !important; }

/* 5) SELECTED ROW: [x] ....door.... [color box auto] ...... [qty]
      flex-wrap on: bohot tang jagah ho to qty neeche chali jati hai, naam kabhi cut nahi hota */
.m-config-rows .m-row-item {
  position: relative !important; overflow: visible !important;
  display: flex !important; flex-wrap: wrap !important; align-items: center !important;
  gap: 8px !important;
  box-sizing: border-box !important;
  width: 100% !important;
  margin: 0 0 12px 0 !important;
  padding: 8px 10px 8px 8px !important;
  border-radius: 12px !important; border: 1px solid var(--m-bd) !important;
  background: #fff !important;
  box-shadow: var(--m-float) !important;
}
.m-config-rows .m-row-item .m-swatches { display: none !important; }

/* Order: remove (left), color box, qty (right) */
.m-config-rows .m-row-item .m-remove-btn { order: 1; }
.m-config-rows .m-row-item .m-sel-chip   { order: 2; }
.m-config-rows .m-row-item .m-qty-box    { order: 3; margin: 0 0 0 auto !important; }

/* COLOR BOX: naam ke hisab se auto size, uthi hui */
.m-sel-chip {
  display: inline-flex; align-items: center; gap: 7px;
  flex: 0 1 auto !important; width: auto !important; min-width: 0; max-width: 100%;
  padding: 6px 12px 6px 9px; box-sizing: border-box;
  background: #fff5f9; border: 1px solid #e6007e; border-radius: 10px;
  box-shadow: var(--m-float-sm);
  font-family: 'Segoe UI', sans-serif; font-size: 12px; font-weight: 800; color: #800000; line-height: 1.25;
}
.m-sel-chip .m-sw-dot {
  width: 12px; height: 12px; border-radius: 50%;
  border: 1px solid rgba(0,0,0,.16); flex-shrink: 0; box-sizing: border-box;
}
/* naam pura dikhta hai; bohot lamba ho tabhi do lines mein jata hai */
.m-sel-chip .m-sc-name {
  white-space: normal; overflow-wrap: break-word; word-break: normal;
  overflow: visible; text-overflow: clip; max-width: none; min-width: 0;
}

/* REMOVE (x): LEFT par, color box se door, dark border + uthi hui */
.m-config-rows .m-row-item .m-remove-btn {
  position: relative !important;
  top: auto !important; left: auto !important; right: auto !important; bottom: auto !important;
  transform: none !important;
  flex: 0 0 auto;
  width: 26px !important; height: 26px !important; min-width: 26px;
  padding: 0 !important; margin: 0 18px 0 0 !important;
  font-size: 0 !important; line-height: 0; -webkit-text-stroke: 0 !important;
  display: inline-flex !important; align-items: center; justify-content: center;
  border: 1px solid var(--m-bd) !important; border-radius: 50% !important;
  background: #ffffff !important; color: #a3301f !important; cursor: pointer;
  box-shadow: var(--m-float-sm) !important;
  transition: background .25s ease, color .25s ease, border-color .25s ease, transform .25s ease;
  -webkit-tap-highlight-color: transparent;
}
.m-config-rows .m-row-item .m-remove-btn::before {
  content: "\00d7"; font-size: 18px; font-weight: 600; line-height: 1;
  font-family: 'Segoe UI', Arial, sans-serif; margin-top: -1px;
}
/* touch tap area sirf left/up/down mein (right side chip ki taraf nahi barhta) */
.m-config-rows .m-row-item .m-remove-btn::after { content: ""; position: absolute; top: -6px; bottom: -6px; left: -6px; right: -2px; }
@media (hover: hover) and (pointer: fine) {
  .m-config-rows .m-row-item .m-remove-btn:hover { background: #e6007e !important; color: #fff !important; border-color: #e6007e !important; transform: translateY(-1px); }
}
.m-config-rows .m-row-item .m-remove-btn:active { background: #e6007e !important; color: #fff !important; border-color: #e6007e !important; }

/* QTY BOX: bara, click aasan, uthi hui */
.m-qty-box {
  border-radius: 10px !important; height: 40px !important; width: 124px !important;
  border: 1px solid var(--m-bd) !important;
  background: #fff;
  box-shadow: var(--m-float-sm) !important; flex: 0 0 auto;
}
.m-qty-box button { min-width: 38px !important; font-size: 21px !important; }
.m-qty-box input { width: 44px !important; font-size: 15px !important; }

/* Tablet / Laptop / PC */
@media (min-width: 481px) {
  .m-config-rows .m-row-item { padding: 9px 12px 9px 10px !important; gap: 10px !important; }
  .m-config-rows .m-row-item .m-remove-btn { margin-right: 22px !important; }
  .m-sel-chip { font-size: 12.5px; }
  .m-qty-box { width: 132px !important; height: 42px !important; }
  .m-qty-box button { min-width: 42px !important; }
  .m-qty-box input { width: 48px !important; }
}
/* Mobile / iPhone */
@media (max-width: 400px) {
  .m-config-rows .m-row-item { padding: 7px 8px 7px 7px !important; gap: 6px !important; }
  .m-config-rows .m-row-item .m-remove-btn { margin-right: 14px !important; }
  .m-sel-chip { padding: 5px 9px 5px 7px; font-size: 11.5px; }
  .m-qty-box { width: 112px !important; height: 38px !important; }
  .m-qty-box button { min-width: 36px !important; }
  .m-qty-box input { width: 38px !important; }
}
/* Bohot chhoti screen: jaga kam ho to qty neeche line mein, kuch cut nahi hota */
@media (max-width: 340px) {
  .m-config-rows .m-row-item .m-remove-btn { margin-right: 8px !important; }
  .m-config-rows .m-row-item .m-qty-box { margin-left: auto !important; }
}

/* 6) ADD COLOR: square-ish, dark border, tight luxury shadow */
.m-pop-right button.m-add-row-btn,
.m-pop-right button.m-add-row-btn:focus,
.m-pop-right button.m-add-row-btn:focus-visible {
  display: flex !important; align-items: center; justify-content: center;
  width: auto !important; height: 32px; margin: 4px auto 16px !important; padding: 0 20px !important;
  box-sizing: border-box;
  font-size: 10px !important; font-weight: 800 !important; letter-spacing: 1.5px !important; white-space: nowrap;
  font-family: 'Segoe UI', sans-serif;
  background: #ffffff !important; color: #800000 !important;
  border: 1px solid var(--m-bd) !important; border-radius: 8px !important;
  -webkit-text-stroke: 0 !important; animation: none !important;
  box-shadow: 0 5px 7px -3px rgba(80, 20, 40, .32), 0 1px 2px rgba(80, 20, 40, .08) !important;
  outline: none !important; cursor: pointer;
  transition: background .25s ease, color .25s ease, border-color .25s ease, transform .25s ease, box-shadow .25s ease;
  -webkit-tap-highlight-color: transparent;
}
@media (hover: hover) and (pointer: fine) {
  .m-pop-right button.m-add-row-btn:hover {
    background: #e6007e !important; color: #fff !important; border-color: #e6007e !important;
    transform: translateY(-2px);
    box-shadow: 0 7px 9px -4px rgba(230, 0, 126, .38), 0 1px 2px rgba(80, 20, 40, .10) !important;
  }
}
.m-pop-right button.m-add-row-btn:active {
  background: #e6007e !important; color: #fff !important; border-color: #e6007e !important;
  transform: translateY(0) scale(.98);
  box-shadow: 0 2px 4px -2px rgba(230, 0, 126, .40) !important;
}

/* 6b) "Colors & size may vary slightly" note
       TEXT / LAYOUT KO CHHUA NAHI GAYA (font, line-height, padding, height, white-space sab asli).
       Wrapper aur uska seedha child saaf (patti na bane).
       Sirf andar wale pill par border + halka shadow + 10px corners. */
.m-note-float { padding: 0 0 6px; max-width: 100%; box-sizing: border-box; }
.m-note-float,
.m-note-float > * {
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
}
.m-note-float :is(button, summary, [role="button"], div, span, a, p)[class*="note"]:not(:has([class*="note"])),
.m-note-float :is(button, summary, [role="button"]) {
  background-color: #ffffff !important;
  border: 1px solid var(--m-bd) !important;
  border-radius: 10px !important;
  box-shadow: var(--m-float-sm) !important;
}

/* 6c) DESCRIPTION BOX: page se thora zyada ubhra hua, same border */
.m-pop-description {
  background: #ffffff !important;
  border-color: var(--m-bd) !important;
  border-radius: 12px !important;
  box-shadow: var(--m-float-lg) !important;
  margin-bottom: 16px !important;
}

/* 6d) DESCRIPTION KE NEECHE WALE ICONS: ubhre hue, thori zyada height */
.m-pop-description ~ * > * {
  background-color: #ffffff;
  border: 1px solid var(--m-bd);
  border-radius: 10px;
  box-shadow: var(--m-float-sm);
  box-sizing: border-box;
  min-height: 64px;
  padding-top: 12px;
  padding-bottom: 12px;
}

/* 7) TOTAL: "Total: AED 95   ~~AED 100~~" ek hi line mein, "You save" neeche.
      "You save" wali line ki jaga PEHLE SE reserve hai, taake aane/jaane par step na hile */
.m-master-box .m-final-bill {
  display: flex !important; flex-wrap: wrap;
  align-items: baseline; justify-content: center;
  column-gap: 0; row-gap: 2px;
  line-height: 1.25;
  min-height: 42px;           /* price line (~24px) + gap + you-save line (~14px) */
  align-content: flex-start;
  box-sizing: border-box;
}
.m-master-box .m-final-bill > span:not(.m-final-old):not(.m-final-save) { margin-left: .28em; }
.m-master-box .m-final-bill .m-final-old {
  order: 2; display: inline-block !important; width: auto !important;
  margin: 0 0 0 10px !important; align-self: baseline;
}
.m-master-box .m-final-bill .m-final-save {
  order: 3; flex: 0 0 100%; text-align: center; margin: 0 !important;
  min-height: 14px; line-height: 1.3 !important;
}
.m-page-mode .m-final-bill { font-size: 19px !important; margin: 8px 0 12px !important; letter-spacing: 0 !important; }
.m-page-mode .m-final-old { font-size: 11px !important; }
.m-page-mode .m-final-save { font-size: 10.5px !important; }

/* 8) Sticky bar ke peeche content na chhupe (phone/tablet). Desktop par bar nahi hai */
.m-page-mode .m-pop-layout { padding-bottom: calc(92px + env(safe-area-inset-bottom, 0px)) !important; }
@media (min-width: 975px) {
  .m-page-mode .m-pop-layout { padding-bottom: 28px !important; }
}

/* 9) PHONE / TABLET: description box ki upar wali line aur product name ke beech gap */
@media (max-width: 974px) {
  .m-pop-description { padding-top: 18px !important; }
  .m-pop-description > :first-child { margin-top: 12px !important; }
}

/* 10) MOBILE KA "DESKTOP SITE" MODE (975px se 1023px): laptop jaisa layout */
@media (min-width: 975px) and (max-width: 1023px) {
  .m-page-mode .m-pop-layout.m-pop-layout {
    display: grid !important;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) !important;
    column-gap: 32px !important;
    row-gap: 0 !important;
    align-items: start !important;
    flex-direction: row !important;
  }
  .m-page-mode .m-pop-left.m-pop-left,
  .m-page-mode .m-pop-right.m-pop-right {
    width: auto !important;
    max-width: none !important;
    min-width: 0 !important;
    float: none !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box;
  }
  .m-page-mode .m-pop-left .m-slider-container {
    max-width: min(100%, 79vh);
    margin-left: auto;
    margin-right: auto;
  }
}
</style>

<script is:inline>
(function () {
  var root = document.querySelector('.m-product-page-wrap .m-master-box');
  if (!root) return;

  /* color -> photo number (products.js ke colorImages se aata hai) */
  var colorIndex = {};
  try { colorIndex = JSON.parse(root.getAttribute('data-colorindex') || '{}') || {}; } catch (e) { colorIndex = {}; }

  /* ================= THUMBNAILS ================= */
  var track = root.querySelector('.m-track');
  var strip = root.querySelector('.m-thumbs');
  var wrap = root.querySelector('.m-thumbs-wrap');
  var next = root.querySelector('.m-thumbs-next');
  var go = null;
  if (track && strip) {
    var items = [].slice.call(strip.querySelectorAll('.m-thumb'));
    var cur0 = 0;

    /* lazy thumbnails: photo load ho jaye to placeholder band (is-ready) */
    items.forEach(function (el) {
      var im = el.querySelector('img');
      if (!im) return;
      var done = function () { el.classList.add('is-ready'); };
      if (im.complete && im.naturalWidth > 0) done();
      else {
        im.addEventListener('load', done);
        im.addEventListener('error', done);
      }
    });

    /* page load ke baad, khali waqt mein baqi thumbnails bhi load kar lo,
       taake scroll karne par khali na milein */
    var warm = function () {
      items.forEach(function (el) {
        var im = el.querySelector('img');
        if (im) im.loading = 'eager';
      });
    };
    window.addEventListener('load', function () {
      if (window.requestIdleCallback) window.requestIdleCallback(warm, { timeout: 2000 });
      else setTimeout(warm, 800);
    });

    /* arrow sirf tab, jab thumbnails wrap ki poori chauraai mein na samayen */
    var checkArrow = function () {
      if (!wrap) return;
      var room = wrap.clientWidth - 4;
      wrap.classList.toggle('has-more', strip.scrollWidth > room + 2);
    };

    var mark = function (i) {
      cur0 = i;
      items.forEach(function (el, k) { el.classList.toggle('is-on', k === i); });
      var el = items[i];
      if (!el) return;
      var l = el.offsetLeft;
      if (l < strip.scrollLeft || l + el.offsetWidth > strip.scrollLeft + strip.clientWidth) {
        strip.scrollTo({ left: Math.max(l - 2, 0), behavior: 'smooth' });
      }
    };
    go = function (i) {
      track.scrollTo({ left: i * track.clientWidth, behavior: 'smooth' });
      mark(i);
    };
    items.forEach(function (el, i) { el.addEventListener('click', function () { go(i); }); });

    if (next) {
      next.addEventListener('click', function () {
        var atEnd = strip.scrollLeft + strip.clientWidth >= strip.scrollWidth - 4;
        if (atEnd) { strip.scrollTo({ left: 0, behavior: 'smooth' }); go(0); }
        else { strip.scrollBy({ left: strip.clientWidth * 0.75, behavior: 'smooth' }); }
      });
    }

    var tmr;
    track.addEventListener('scroll', function () {
      clearTimeout(tmr);
      tmr = setTimeout(function () {
        var i = Math.round(track.scrollLeft / (track.clientWidth || 1));
        if (i !== cur0 && items[i]) mark(i);
      }, 80);
    }, { passive: true });

    checkArrow();
    window.addEventListener('load', function () { checkArrow(); setTimeout(checkArrow, 400); });
    window.addEventListener('resize', checkArrow);
    window.addEventListener('orientationchange', function () { setTimeout(checkArrow, 250); });
  }

  /* color ki photo dikhao (agar us color ki photo di gayi hai) */
  function showColor(c) {
    if (!go) return;
    var i = colorIndex[c];
    if (typeof i !== 'number') return;
    go(i);
  }

  /* ================= BUNDLE BOX: heading ke UPAR ================= */
  var right = root.querySelector('.m-pop-right');
  var head = root.querySelector('.m-sec-head');
  function placeOffer() {
    var box = root.querySelector('.m-offer-box');
    if (box && head && head.parentNode && box.nextElementSibling !== head) {
      head.parentNode.insertBefore(box, head);
    }
  }

  /* ================= TOTAL: cut price + save, bill ke ANDAR ================= */
  function fixBill() {
    var bill = root.querySelector('.m-final-bill');
    if (!bill) return;
    var old = root.querySelector('.m-final-old');
    var save = root.querySelector('.m-final-save');
    if (old && !bill.contains(old)) bill.appendChild(old);
    if (save && !bill.contains(save)) bill.appendChild(save);
  }

  /* ================= ADD COLOR: hamesha rows ke NEECHE ================= */
  var cfg = root.querySelector('.m-config-rows');
  var addBtn = root.querySelector('.m-add-row-btn');
  function placeAddBtn() {
    if (!addBtn || !cfg || !cfg.parentNode) return;
    /* agar kisi script ne button row ke andar daal diya ho to wapis neeche rakho */
    if (addBtn.parentNode !== cfg.parentNode || cfg.nextElementSibling !== addBtn) {
      cfg.parentNode.insertBefore(addBtn, cfg.nextSibling);
    }
  }

  if (right) {
    new MutationObserver(function () { placeOffer(); fixBill(); placeAddBtn(); }).observe(right, { childList: true, subtree: true });
  }
  placeOffer();
  fixBill();
  placeAddBtn();

  /* ================= COLOR PALETTE + SELECTED ROW ================= */
  var pal = root.querySelector('.m-palette');
  if (!cfg || !pal) return;

  var lastSig = '';
  var booted = false; /* pehli baar page khulne par slider ko na hilao */

  function rowsList() {
    return [].slice.call(cfg.children).filter(function (r) { return r.classList && r.classList.contains('m-row-item'); });
  }
  function selOf(row) { return row.querySelector('.m-color-select'); }

  function pick(c) {
    var rs = rowsList();
    if (!rs.length) return;
    var active = rs[rs.length - 1];
    var sw = [].slice.call(active.querySelectorAll('.m-swatch')).filter(function (s) { return s.getAttribute('data-c') === c; })[0];
    if (sw) sw.click();
  }

  function sync() {
    var rs = rowsList();
    if (!rs.length) { if (pal.innerHTML) pal.innerHTML = ''; lastSig = ''; return; }

    var first = rs[0];
    var src = [].slice.call(first.querySelectorAll('.m-swatch'));
    if (!src.length) return;

    var active = rs[rs.length - 1];
    var curSel = selOf(active);
    var cur = curSel ? curSel.value : '';
    var used = rs.filter(function (r) { return r !== active; }).map(function (r) { var s = selOf(r); return s ? s.value : ''; });

    var dots = {};
    src.forEach(function (s) {
      var d = s.querySelector('.m-sw-dot');
      dots[s.getAttribute('data-c')] = d ? d.style.background : '';
    });

    var sig = src.map(function (s) { return s.className.replace(/\bis-sel\b|\bis-used\b/g, '') + '~' + s.textContent; }).join('|') + '#' + cur + '#' + used.join(',');
    if (sig !== lastSig) {
      lastSig = sig;
      pal.innerHTML = '';
      src.forEach(function (s) {
        var c = s.getAttribute('data-c');
        var n = s.cloneNode(true);
        n.classList.remove('is-sel', 'is-used');
        if (c === cur) n.classList.add('is-sel');
        if (used.indexOf(c) > -1) n.classList.add('is-used');
        n.setAttribute('aria-pressed', c === cur ? 'true' : 'false');
        n.addEventListener('click', function () { pick(c); });
        n.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); pick(c); }
        });
        pal.appendChild(n);
      });
    }

    rs.forEach(function (row) {
      var s = selOf(row);
      if (!s) return;
      var chip = row.querySelector(':scope > .m-sel-chip');
      if (!chip) {
        chip = document.createElement('span');
        chip.className = 'm-sel-chip';
        chip.innerHTML = '<span class="m-sw-dot"></span><span class="m-sc-name"></span>';
        var q = row.querySelector('.m-qty-box');
        if (q) row.insertBefore(chip, q); else row.appendChild(chip);
      }
      var nm = chip.querySelector('.m-sc-name');
      if (nm.textContent !== s.value) nm.textContent = s.value;
      var dt = chip.querySelector('.m-sw-dot');
      var bg = dots[s.value] || '';
      if (dt.style.background !== bg) dt.style.background = bg;
    });

    /* jis row ka color badla (ya nayi row aayi), us color ki photo dikhao */
    rs.forEach(function (row) {
      var s = selOf(row);
      if (!s) return;
      var prev = row.getAttribute('data-m-last');
      if (prev !== s.value) {
        row.setAttribute('data-m-last', s.value);
        if (booted) showColor(s.value);
      }
    });
    booted = true;

    placeAddBtn();
  }

  var raf = 0;
  function queue() {
    if (raf) return;
    raf = requestAnimationFrame(function () { raf = 0; sync(); fixBill(); });
  }

  /* kisi row ko chhoo (qty plus/minus waghera) to us row ke color ki photo */
  cfg.addEventListener('click', function (e) {
    var t = e.target;
    if (!t || !t.closest) return;
    var row = t.closest('.m-row-item');
    if (!row || t.closest('.m-remove-btn')) return;
    var s = selOf(row);
    if (s) showColor(s.value);
  });

  new MutationObserver(queue).observe(cfg, { childList: true, subtree: true, attributes: true, characterData: true });
  cfg.addEventListener('change', queue);
  window.addEventListener('load', function () { queue(); placeOffer(); fixBill(); placeAddBtn(); setTimeout(function () { queue(); placeOffer(); fixBill(); placeAddBtn(); }, 500); });
  queue();
})();
</script>