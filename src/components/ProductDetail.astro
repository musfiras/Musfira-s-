---
const { p, checkoutUrl } = Astro.props;
const many = p.images.length > 1;
const scrollable = p.images.length > 4;
---
<div
  class="m-master-box"
  id={p.id}
  data-pname={p.name}
  data-base={p.price}
  data-offer2={p.offer2}
  data-offer3={p.offer3}
  data-stock={JSON.stringify(p.stock)}
  data-checkout={checkoutUrl}
>
  <div class="m-pop-overlay">
    <div class="m-pop-box">
      <div class="m-close-x">&times;</div>

      <div class="m-pop-layout">
        <div class="m-pop-left">

          <div class="m-slider-container">
            <div class="m-track" onscroll="syncDots(this)">
              {p.images.map((src, i) => (
                <img src={src} alt={`${p.name} ${i + 1}`} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
              ))}
            </div>
            <!-- zaroori: script setupDots() isay dhundti hai, is liye rakha hai (CSS se chhupa hua) -->
            <div class="m-dots-wrapper"></div>
          </div>

          {many && (
            <div class="m-thumbs-wrap">
              <div class="m-thumbs">
                {p.images.map((src, i) => (
                  <button type="button" class={i === 0 ? 'm-thumb is-on' : 'm-thumb'} data-i={i} aria-label={`Photo ${i + 1}`}>
                    <img src={src} alt="" loading="lazy" decoding="async" />
                  </button>
                ))}
              </div>
              {scrollable && (
                <button type="button" class="m-thumbs-next" aria-label="More photos">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
                </button>
              )}
            </div>
          )}
        </div>

        <div class="m-pop-right">
          <!-- Bundle offer box script se banta hai, aur neeche wali script isay is heading ke UPAR rakhti hai -->
          <div class="m-sec-head" style="font-size: 11px; font-weight: 800; color: #E6007E; text-transform: uppercase; margin-top: 50px; margin-bottom: 12px; border-left: 3px solid #e6007e; padding-left: 8px;">Select Color & QTY</div>

          <!-- Sare colors ek hi line mein (script khud bharti hai) -->
          <div class="m-palette"></div>

          <!-- Neeche: selected color + qty (+ Add Color usi line mein) -->
          <div class="m-config-rows"></div>

          <button class="m-add-row-btn" onclick={`addDynamicRow('${p.id}')`}>+ ADD COLOR</button>
          <!-- Bundle ki live line (script isi ko bharti hai) -->
          <div class="m-offer-hint"></div>

          <div class="m-final-bill">Total: AED <span>{p.price}</span></div>

          <button class="m-buy-now-btn" onclick={`goCheckout('${p.id}')`}>BUY IT NOW →</button>

          <button
            class="m-cart-add-trigger"
            onclick={`addToCartTrigger('${p.id}')`}
            style="width: 100%; background: #fff; border: 2px solid #800000; color: #800000; padding: 18px; border-radius: 50px; font-size: 14px; font-weight: 800; cursor: pointer; transition: 0.4s; text-transform: uppercase; letter-spacing: 1px; margin-top: 10px; display: block;"
          >ADD TO BAG +</button>

          <div id={`cart-alert-${p.id}`} style="display:none; color: #e6007e; font-size: 11px; font-weight: 700; margin-top: 10px; text-align: center; font-family: sans-serif;">
            ⚠️ Please select color & quantity first!
          </div>

          <div class="m-pop-description" set:html={p.descriptionHtml}></div>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
/* =====================================================
   PRODUCT PAGE UPDATE v6
   ===================================================== */

/* 1) Maroon line, heading, arrow, dots khatam */
.m-maroon-top-bar { display: none !important; }
.m-arrow-next { display: none !important; }
.m-dots-wrapper { display: none !important; }

/* 2) THUMBNAILS */
.m-thumbs-wrap {
  position: relative; box-sizing: border-box;
  margin: 8px 0 10px; padding: 0 28px 0 2px;
}
.m-thumbs {
  position: relative;
  display: flex; gap: 7px; overflow-x: auto; scroll-behavior: smooth;
  scrollbar-width: none; -webkit-overflow-scrolling: touch;
  scroll-snap-type: x proximity;
}
.m-thumbs::-webkit-scrollbar { display: none; }
.m-thumb {
  flex: 0 0 calc((100% - 21px) / 4); aspect-ratio: 1 / 1;
  box-sizing: border-box; padding: 2px; margin: 0; background: #fff;
  border: 1px solid #fbd9e8; border-radius: 9px;
  cursor: pointer; scroll-snap-align: start; overflow: hidden;
  opacity: .7; transition: opacity .25s ease, border-color .25s ease, box-shadow .25s ease;
  -webkit-tap-highlight-color: transparent;
}
.m-thumb img { width: 100%; height: 100%; object-fit: contain; display: block; border-radius: 6px; }
.m-thumb.is-on { opacity: 1; border-color: #e6007e; box-shadow: 0 0 0 1px #e6007e inset; }
@media (hover: hover) and (pointer: fine) { .m-thumb:hover { opacity: 1; border-color: #e6007e; } }
.m-thumbs-next {
  position: absolute; right: 0; top: 50%; transform: translateY(-50%);
  width: 22px; height: 22px; padding: 0; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: #fff; border: 1px solid #fbd9e8; color: #800000;
  box-shadow: 0 2px 8px rgba(128,0,0,.10); cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}
.m-thumbs-next svg { width: 12px; height: 12px; stroke: currentColor; stroke-width: 2.4; fill: none; stroke-linecap: round; stroke-linejoin: round; }
.m-thumbs-next:active { background: #e6007e; color: #fff; border-color: #e6007e; }
@media (hover: hover) and (pointer: fine) { .m-thumbs-next:hover { background: #e6007e; color: #fff; border-color: #e6007e; } }
@media (min-width: 1024px) {
  .m-thumbs-wrap { max-width: min(100%, 79vh); margin-left: auto; margin-right: auto; }
}

/* 3) BUNDLE OFFER: sab se upar, extra patla, elite look */
.m-offer-box {
  padding: 4px 7px 5px !important;
  margin-top: 18px !important;
  border: 1px solid #f3d3e2 !important;
  border-radius: 9px !important;
  background: linear-gradient(180deg, #fffafd 0%, #ffffff 100%) !important;
  box-shadow: 0 6px 16px -14px rgba(128, 0, 0, 0.35) !important;
}
@media (max-width: 1023px) { .m-offer-box { margin-top: 26px !important; } }
.m-offer-title {
  font-size: 8.5px !important; letter-spacing: 2.4px !important;
  margin: 0 0 3px !important; line-height: 1.2 !important;
  font-weight: 700 !important;
}
.m-offer-tiers { gap: 5px !important; }
.m-offer-tier {
  padding: 2px 4px !important; border-radius: 7px !important;
  line-height: 1.12 !important;
}
.m-ot-n { font-size: 8px !important; letter-spacing: .9px !important; line-height: 1.15 !important; }
.m-ot-new { font-size: 11.5px !important; margin-top: 0 !important; line-height: 1.15 !important; }
.m-ot-old { font-size: 8px !important; line-height: 1.1 !important; }
.m-offer-hint { font-size: 11px !important; margin: 3px 0 6px !important; }

/* 4) COLOR PALETTE: sare colors ek line mein */
.m-palette {
  display: flex; flex-wrap: wrap; justify-content: flex-start; align-items: center;
  gap: 14px 6px; padding: 6px 2px 4px; margin: 0 0 8px; text-align: left;
}
.m-palette:empty { display: none; }
.m-palette:has(.m-sw-sold) { row-gap: 22px; padding-bottom: 18px; }
.m-palette .m-swatch {
  padding: 3px 9px 3px 6px !important; min-height: 26px !important;
  font-size: 10.5px !important; font-weight: 700 !important; gap: 5px !important;
  border-radius: 8px !important; border-color: #f6dce8 !important;
}
.m-palette .m-swatch.is-sel { font-weight: 800 !important; }
.m-palette .m-sw-dot { width: 11px !important; height: 11px !important; }
.m-palette .m-sw-stock { font-size: 7.5px !important; top: -6px !important; left: 7px !important; }
.m-master-box .m-palette .m-swatch .m-sw-sold b { font-size: 9.5px !important; }
.m-master-box .m-palette .m-swatch .m-sw-sold b::after { font-size: 9px !important; }

/* 5) SELECTED ROW: [Add Color] [selected color] ........ [qty] */
.m-config-rows .m-row-item {
  position: relative !important; overflow: visible !important;
  display: flex !important; flex-wrap: nowrap !important; align-items: center !important;
  gap: 8px !important;
  padding: 7px 10px !important; margin-bottom: 8px !important;
  border-radius: 12px !important; border: 1px solid #f6dce8 !important;
  background: #fff !important;
  box-shadow: 0 3px 10px -8px rgba(128, 0, 0, 0.25) !important;
}
.m-config-rows .m-row-item .m-swatches { display: none !important; }

.m-config-rows .m-row-item .m-add-row-btn { order: 1; }
.m-config-rows .m-row-item .m-sel-chip { order: 2; }
.m-config-rows .m-row-item .m-qty-box { order: 3; margin-left: auto !important; margin-right: 6px !important; }

.m-sel-chip {
  display: inline-flex; align-items: center; gap: 6px;
  min-width: 0; flex: 0 1 auto;
  padding: 4px 10px 4px 7px; box-sizing: border-box;
  background: #fff5f9; border: 1px solid #e6007e; border-radius: 8px;
  font-family: 'Segoe UI', sans-serif; font-size: 11px; font-weight: 800; color: #800000; line-height: 1.2;
}
.m-sel-chip .m-sw-dot { width: 11px; height: 11px; border-radius: 50%; border: 1px solid rgba(0,0,0,.16); flex-shrink: 0; box-sizing: border-box; }
.m-sel-chip .m-sc-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 110px; }

/* ---- REMOVE: ab "Remove" text button, box ke BAHIR left side par ----
   Jab koi remove button maujood ho to saari rows thori chhoti ho kar
   right side par chali jati hain, aur left gutter mein Remove aa jata hai. */
.m-config-rows:has(.m-remove-btn) .m-row-item { margin-left: 70px !important; }

.m-config-rows .m-row-item .m-remove-btn {
  position: absolute !important;
  top: 50% !important; left: -66px !important; right: auto !important; bottom: auto !important;
  transform: translateY(-50%) !important; order: 9;
  width: 58px; height: 26px; padding: 0 !important; margin: 0 !important;
  font-size: 0 !important; line-height: 0; -webkit-text-stroke: 0 !important;
  display: flex; align-items: center; justify-content: center;
  border: 1px solid #f3c9dc !important; border-radius: 8px !important;
  background: #fff !important; color: #a3301f !important; cursor: pointer;
  box-shadow: none !important;
  transition: background .25s ease, color .25s ease, border-color .25s ease;
  z-index: 3;
  -webkit-tap-highlight-color: transparent;
}
.m-config-rows .m-row-item .m-remove-btn::before {
  content: "Remove"; font-size: 10px; font-weight: 800; letter-spacing: .3px; line-height: 1;
  font-family: 'Segoe UI', sans-serif;
}
.m-config-rows .m-row-item .m-remove-btn::after { content: ""; position: absolute; inset: -6px; }
@media (hover: hover) and (pointer: fine) {
  .m-config-rows .m-row-item .m-remove-btn:hover { background: #e6007e !important; color: #fff !important; border-color: #e6007e !important; }
}
.m-config-rows .m-row-item .m-remove-btn:active { background: #e6007e !important; color: #fff !important; border-color: #e6007e !important; }

/* QTY BOX: square type, soft, patla */
.m-qty-box {
  border-radius: 9px !important; height: 34px !important; width: 112px !important;
  border-color: #f6dce8 !important; box-shadow: none !important; flex: 0 0 auto;
}
.m-qty-box button { min-width: 34px !important; font-size: 19px !important; }
.m-qty-box input { width: 44px !important; }

/* Tablet */
@media (min-width: 481px) and (max-width: 1023px) {
  .m-config-rows .m-row-item { padding: 8px 12px !important; }
  .m-config-rows .m-row-item .m-qty-box { margin-right: 8px !important; }
  .m-sel-chip .m-sc-name { max-width: 130px; }
}
/* Laptop / PC */
@media (min-width: 1024px) {
  .m-config-rows .m-row-item { padding: 8px 12px !important; }
  .m-config-rows .m-row-item .m-qty-box { margin-right: 8px !important; }
  .m-sel-chip .m-sc-name { max-width: 120px; }
}
/* Mobile / iPhone */
@media (max-width: 480px) {
  .m-config-rows:has(.m-remove-btn) .m-row-item { margin-left: 56px !important; }
  .m-config-rows .m-row-item .m-remove-btn { left: -54px !important; width: 49px; height: 25px; }
  .m-config-rows .m-row-item .m-remove-btn::before { font-size: 9px; letter-spacing: .2px; }
  .m-config-rows .m-row-item { gap: 6px !important; padding: 7px 8px !important; }
  .m-config-rows .m-row-item .m-qty-box { margin-right: 4px !important; }
  .m-qty-box { width: 92px !important; height: 33px !important; }
  .m-qty-box button { min-width: 29px !important; }
  .m-qty-box input { width: 34px !important; }
  .m-sel-chip { padding: 4px 7px 4px 6px; font-size: 10.5px; }
  .m-sel-chip .m-sc-name { max-width: 52px; }
  .m-config-rows .m-row-item .m-add-row-btn { padding: 0 8px !important; font-size: 9px !important; }
}
@media (max-width: 360px) {
  .m-config-rows:has(.m-remove-btn) .m-row-item { margin-left: 52px !important; }
  .m-config-rows .m-row-item .m-remove-btn { left: -50px !important; width: 46px; }
  .m-qty-box { width: 86px !important; }
  .m-qty-box input { width: 30px !important; }
  .m-sel-chip .m-sc-name { max-width: 40px; }
}

/* 6) ADD COLOR: orangy maroon, patla, hover par pink (pehli row mein, left par) */
.m-pop-right button.m-add-row-btn,
.m-pop-right button.m-add-row-btn:focus,
.m-pop-right button.m-add-row-btn:focus-visible {
  display: inline-flex !important; align-items: center; justify-content: center;
  flex: 0 0 auto; width: auto !important; height: 30px; margin: 0 !important; padding: 0 12px !important;
  font-size: 10px !important; font-weight: 800 !important; letter-spacing: .6px !important; white-space: nowrap;
  background: #a3301f !important; color: #fff !important;
  border: none !important; border-radius: 8px !important;
  -webkit-text-stroke: 0 !important; animation: none !important; box-shadow: none !important;
  outline: none !important; cursor: pointer;
  transition: background .25s ease, transform .15s ease;
}
@media (hover: hover) and (pointer: fine) {
  .m-pop-right button.m-add-row-btn:hover { background: #e6007e !important; color: #fff !important; }
}
.m-pop-right button.m-add-row-btn:active { background: #e6007e !important; color: #fff !important; transform: scale(.97); }
.m-pop-right > button.m-add-row-btn { margin: 4px 0 8px !important; }

/* 7) TOTAL: "Total: AED 95   ~~AED 100~~" ek hi line mein, cut price right side par.
      "You save" neeche apni line mein. */
.m-master-box .m-final-bill {
  display: flex !important; flex-wrap: wrap;
  align-items: baseline; justify-content: center;
  column-gap: 0; row-gap: 2px;
}
.m-master-box .m-final-bill > span:not(.m-final-old):not(.m-final-save) { margin-left: .28em; }
.m-master-box .m-final-bill .m-final-old {
  order: 2; display: inline-block !important; width: auto !important;
  margin: 0 0 0 10px !important; align-self: baseline;
}
.m-master-box .m-final-bill .m-final-save {
  order: 3; flex: 0 0 100%; text-align: center; margin: 0 !important;
}
.m-page-mode .m-final-bill { font-size: 19px !important; margin: 8px 0 12px !important; letter-spacing: 0 !important; }
.m-page-mode .m-final-old { font-size: 11px !important; }
.m-page-mode .m-final-save { font-size: 10.5px !important; }

/* 8) Sticky bar ke peeche content na chhupe */
.m-page-mode .m-pop-layout { padding-bottom: calc(92px + env(safe-area-inset-bottom, 0px)) !important; }

/* 9) MOBILE: description box ki upar wali line aur product name ke beech gap */
@media (max-width: 1023px) {
  .m-pop-description { padding-top: 18px !important; }
  .m-pop-description > :first-child { margin-top: 12px !important; }
}
</style>

<script is:inline>
(function () {
  var root = document.querySelector('.m-product-page-wrap .m-master-box');
  if (!root) return;

  /* ================= THUMBNAILS ================= */
  var track = root.querySelector('.m-track');
  var strip = root.querySelector('.m-thumbs');
  var next = root.querySelector('.m-thumbs-next');
  if (track && strip) {
    var items = [].slice.call(strip.querySelectorAll('.m-thumb'));
    var cur0 = 0;

    var mark = function (i) {
      cur0 = i;
      items.forEach(function (el, k) { el.classList.toggle('is-on', k === i); });
      var el = items[i];
      if (!el) return;
      var l = el.offsetLeft;
      if (l < strip.scrollLeft || l + el.offsetWidth > strip.scrollLeft + strip.clientWidth) {
        strip.scrollTo({ left: Math.max(l - 2, 0), behavior: 'smooth' });
      }
    };
    var go = function (i) {
      track.scrollTo({ left: i * track.clientWidth, behavior: 'smooth' });
      mark(i);
    };
    items.forEach(function (el, i) { el.addEventListener('click', function () { go(i); }); });

    if (next) {
      next.addEventListener('click', function () {
        var atEnd = strip.scrollLeft + strip.clientWidth >= strip.scrollWidth - 4;
        if (atEnd) { strip.scrollTo({ left: 0, behavior: 'smooth' }); go(0); }
        else { strip.scrollBy({ left: strip.clientWidth * 0.75, behavior: 'smooth' }); }
      });
    }

    var tmr;
    track.addEventListener('scroll', function () {
      clearTimeout(tmr);
      tmr = setTimeout(function () {
        var i = Math.round(track.scrollLeft / (track.clientWidth || 1));
        if (i !== cur0 && items[i]) mark(i);
      }, 80);
    }, { passive: true });
  }

  /* ================= BUNDLE BOX: heading ke UPAR ================= */
  var right = root.querySelector('.m-pop-right');
  var head = root.querySelector('.m-sec-head');
  function placeOffer() {
    var box = root.querySelector('.m-offer-box');
    if (box && head && head.parentNode && box.nextElementSibling !== head) {
      head.parentNode.insertBefore(box, head);
    }
  }

  /* ================= TOTAL: cut price + save, bill ke ANDAR (ek line CSS se hoti hai) ================= */
  function fixBill() {
    var bill = root.querySelector('.m-final-bill');
    if (!bill) return;
    var old = root.querySelector('.m-final-old');
    var save = root.querySelector('.m-final-save');
    if (old && !bill.contains(old)) bill.appendChild(old);
    if (save && !bill.contains(save)) bill.appendChild(save);
  }

  if (right) {
    new MutationObserver(function () { placeOffer(); fixBill(); }).observe(right, { childList: true, subtree: true });
  }
  placeOffer();
  fixBill();

  /* ================= COLOR PALETTE + SELECTED ROW ================= */
  var cfg = root.querySelector('.m-config-rows');
  var pal = root.querySelector('.m-palette');
  var addBtn = root.querySelector('.m-add-row-btn');
  if (!cfg || !pal) return;

  var lastSig = '';

  function rowsList() {
    return [].slice.call(cfg.children).filter(function (r) { return r.classList && r.classList.contains('m-row-item'); });
  }
  function selOf(row) { return row.querySelector('.m-color-select'); }

  function pick(c) {
    var rs = rowsList();
    if (!rs.length) return;
    var active = rs[rs.length - 1];
    var sw = [].slice.call(active.querySelectorAll('.m-swatch')).filter(function (s) { return s.getAttribute('data-c') === c; })[0];
    if (sw) sw.click();
  }

  function sync() {
    var rs = rowsList();
    if (!rs.length) { if (pal.innerHTML) pal.innerHTML = ''; lastSig = ''; return; }

    var first = rs[0];
    var src = [].slice.call(first.querySelectorAll('.m-swatch'));
    if (!src.length) return;

    var active = rs[rs.length - 1];
    var curSel = selOf(active);
    var cur = curSel ? curSel.value : '';
    var used = rs.filter(function (r) { return r !== active; }).map(function (r) { var s = selOf(r); return s ? s.value : ''; });

    var dots = {};
    src.forEach(function (s) {
      var d = s.querySelector('.m-sw-dot');
      dots[s.getAttribute('data-c')] = d ? d.style.background : '';
    });

    var sig = src.map(function (s) { return s.className.replace(/\bis-sel\b|\bis-used\b/g, '') + '~' + s.textContent; }).join('|') + '#' + cur + '#' + used.join(',');
    if (sig !== lastSig) {
      lastSig = sig;
      pal.innerHTML = '';
      src.forEach(function (s) {
        var c = s.getAttribute('data-c');
        var n = s.cloneNode(true);
        n.classList.remove('is-sel', 'is-used');
        if (c === cur) n.classList.add('is-sel');
        if (used.indexOf(c) > -1) n.classList.add('is-used');
        n.setAttribute('aria-pressed', c === cur ? 'true' : 'false');
        n.addEventListener('click', function () { pick(c); });
        n.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); pick(c); }
        });
        pal.appendChild(n);
      });
    }

    rs.forEach(function (row) {
      var s = selOf(row);
      if (!s) return;
      var chip = row.querySelector(':scope > .m-sel-chip');
      if (!chip) {
        chip = document.createElement('span');
        chip.className = 'm-sel-chip';
        chip.innerHTML = '<span class="m-sw-dot"></span><span class="m-sc-name"></span>';
        var q = row.querySelector('.m-qty-box');
        if (q) row.insertBefore(chip, q); else row.appendChild(chip);
      }
      var nm = chip.querySelector('.m-sc-name');
      if (nm.textContent !== s.value) nm.textContent = s.value;
      var dt = chip.querySelector('.m-sw-dot');
      var bg = dots[s.value] || '';
      if (dt.style.background !== bg) dt.style.background = bg;
    });

    if (addBtn && addBtn.parentNode !== first) first.insertBefore(addBtn, first.firstChild);
  }

  var raf = 0;
  function queue() {
    if (raf) return;
    raf = requestAnimationFrame(function () { raf = 0; sync(); fixBill(); });
  }

  new MutationObserver(queue).observe(cfg, { childList: true, subtree: true, attributes: true, characterData: true });
  cfg.addEventListener('change', queue);
  window.addEventListener('load', function () { queue(); placeOffer(); fixBill(); setTimeout(function () { queue(); placeOffer(); fixBill(); }, 500); });
  queue();
})();
</script>