---
// Ye Layout.astro mein lagta hai (har page par chalega).
// Jab review ke product-naam wale link se customer ?product=NAME ke saath aaye,
// ye product dhoond kar smooth scroll karta, halka elite glow deta aur product ke NAAM par click karta hai
// (jo ab clickable hai), taake product details khul jayen.
//
// [v2] "View Details" button ki zaroorat nahi: naam click hota hai (button ho to wo bhi chalta hai, backup ke taur par).
//      Highlight: peela rang hata kar soft pink text-highlight aur pink/maroon glow (2 baar pulse).
---
<style is:global>
    /* Text-fragment (#...:~:text=) ka highlight: soft pink, elite */
    ::target-text { background-color: #FFD9E8; color: #800000; }

    /* Product card par halka glow (2 baar pulse), phir khud hat jata hai */
    .mpf-hl { animation: mpfGlow 1.4s ease-in-out 2; border-radius: 14px; }
    @keyframes mpfGlow {
        0%   { box-shadow: 0 0 0 0 rgba(230, 0, 126, 0.55), 0 0 0 2px rgba(163, 11, 34, 0.85); }
        60%  { box-shadow: 0 0 0 12px rgba(230, 0, 126, 0), 0 0 0 2px rgba(163, 11, 34, 0.85); }
        100% { box-shadow: 0 0 0 0 rgba(230, 0, 126, 0), 0 0 0 2px rgba(163, 11, 34, 0); }
    }
    @media (prefers-reduced-motion: reduce) { .mpf-hl { animation: none; box-shadow: 0 0 0 2px #A30B22; } }
</style>

<script is:inline>
    (function () {
        var PROD_Q = (function () {
            var fromQuery = new URLSearchParams(location.search).get('product');
            if (fromQuery) return fromQuery;
            var m = location.hash.match(/[#&]product=([^&:]+)/);
            try { return m ? decodeURIComponent(m[1]) : ''; } catch (e) { return ''; }
        })();
        if (!PROD_Q) return;

        var norm = function (s) { return (s || '').toLowerCase().replace(/[^a-z0-9]/g, ''); };
        var want = norm(PROD_Q);
        var visible = function (el) { return el.getClientRects().length > 0; };
        var reduce = false;
        try { reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
        var tries = 0, scrolled = 0, done = false;

        // Backup: agar kahin purana "View Details" button ab bhi ho
        var findViewBtn = function (card) {
            return [].slice.call(card.querySelectorAll('*')).find(function (e) {
                return e.textContent.trim().toLowerCase() === 'view details';
            });
        };

        // Product ka box: pehle data-pname se, phir naam wale element se
        function findByBox() {
            var boxes = document.querySelectorAll('[data-pname]');
            for (var i = 0; i < boxes.length; i++) {
                if (norm(boxes[i].getAttribute('data-pname')) === want && !boxes[i].closest('#musfira-reviews')) {
                    return boxes[i];
                }
            }
            return null;
        }

        // Product ka naam wala element (heading pehle)
        function findNameEl(scope) {
            var root = scope || document;
            var els = [].slice.call(root.querySelectorAll('h1,h2,h3,h4,h5,h6,a,p,span,div,strong,b'))
                .filter(function (e) { return !e.closest('#musfira-reviews') && (e.textContent || '').length <= PROD_Q.length + 60; });
            var exact = els.filter(function (e) { return norm(e.textContent) === want; });
            var vis = exact.filter(visible).sort(function (x, y) { return x.textContent.length - y.textContent.length; })[0];
            return vis || exact[0] || null;
        }

        function run(card, nameEl) {
            done = true;
            var target = nameEl || card;
            if (!target) return;
            if (visible(target)) target.scrollIntoView({ block: 'center', behavior: reduce ? 'auto' : 'smooth' });

            // glow: card ya naam ke qareeb ka dabba
            var glowEl = card || nameEl.closest('[data-pname]') || nameEl.parentElement;
            if (glowEl && glowEl !== document.body && glowEl.tagName !== 'MAIN' && glowEl.tagName !== 'HTML') {
                setTimeout(function () {
                    glowEl.classList.add('mpf-hl');
                    setTimeout(function () { glowEl.classList.remove('mpf-hl'); }, 3200);
                }, 650);
            }

            // product ke NAAM par click (details khulti hain); naam na ho to View Details button
            setTimeout(function () {
                if (document.body && document.body.classList.contains('m-popup-active')) return;
                var clickEl = (nameEl && visible(nameEl)) ? nameEl : null;
                if (!clickEl) {
                    var scope = card || (nameEl && nameEl.parentElement);
                    var p = scope, btn = null;
                    while (p && !btn) { btn = findViewBtn(p); if (!btn) p = p.parentElement; }
                    clickEl = btn || nameEl;
                }
                if (clickEl) clickEl.click();
            }, 1500);
        }

        var t = setInterval(function () {
            tries++;
            if (done) { clearInterval(t); return; }
            if (document.body && document.body.classList.contains('m-popup-active')) { clearInterval(t); return; }

            var card = findByBox();
            var nameEl = card ? findNameEl(card) : findNameEl(null);
            if (card || nameEl) {
                clearInterval(t);
                run(card || (nameEl && nameEl.closest('[data-pname]')), nameEl);
                return;
            }
            // lazy load: thora scroll karke aur products load karo
            if (tries % 4 === 0 && scrolled < 30) { scrolled++; window.scrollBy(0, window.innerHeight * 0.8); }
            if (tries > 60) clearInterval(t);
        }, 300);
    })();
</script>