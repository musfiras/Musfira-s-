---
// Phone / tablet (975px se chhoti screen): neeche sticky bar (Home | Chat | Add to Cart | Buy it now) + upar patli total line.
//   Landscape mein bar poori width leti hai (left/right gap nahi).
// Laptop / PC aur mobile ka "Desktop site" mode (975px+): bar nahi,
//   Add to Cart + Buy it now alag buttons content ke saath Total ke neeche (hover par halke upar + slow pink).
// Total .m-final-bill se live sync hota hai (koi nayi calculation nahi, sirf wahi number dikhata hai).
//
// [v2] Bar thori patli (total patti 22->20px, buttons row 50->46px).
//      Buttons wali row ab total (price) wali white patti se "ubhri hui" elite look mein:
//      row ke upar tight shadow + buttons ki apni halki lift.
//      Bar ke top ki shadow ab saaf, tight aur strong (phailti nahi).
// [v3] Bar ki height thori aur kam (total 19px, row 45px).
//      Price wali white patti ki purani shadow hata di; ab wo page se ubhri hui (apni tight shadow).
//      Buttons row price patti se aur zyada ubhri hui, buttons par halki bevel + gehri lift.
//      Home aur Chat icons alag alag ubhre hue chips ki tarah (apni shadow ke saath).
const { id } = Astro.props;
---
<div id="mStickyBar" class="msb" role="toolbar" aria-label="Quick actions" data-id={id}>

  <div class="msb-total" aria-live="polite">
    <div class="msb-t-left">
      <span class="msb-t-lab">Total</span>
      <b class="msb-t-new" id="msbTNew">AED</b>
      <s class="msb-t-old" id="msbTOld" hidden></s>
    </div>
    <span class="msb-t-save" id="msbTSave" hidden></span>
  </div>

  <div class="msb-row">
    <a class="msb-ic" href="/" aria-label="Home">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v10h13V10"/><path d="M10 20v-5.5h4V20"/></svg>
      <span>Home</span>
    </a>

    <button type="button" class="msb-ic" id="msbChat" aria-label="Chat with us">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.8 8.8 0 0 1-3.6-.8L3 20.5l1.5-4.9A8.3 8.3 0 0 1 3 11.5 8.5 8.5 0 0 1 12 3a8.5 8.5 0 0 1 9 8.5z"/><circle cx="8.5" cy="11.5" r=".8" fill="currentColor"/><circle cx="12" cy="11.5" r=".8" fill="currentColor"/><circle cx="15.5" cy="11.5" r=".8" fill="currentColor"/></svg>
      <span>Chat</span>
    </button>

    <div class="msb-btns">
      <button type="button" class="msb-cart" id="msbCart">Add to Cart</button>
      <button type="button" class="msb-buy" id="msbBuy">Buy it now</button>
    </div>
  </div>
</div>

<!-- SIRF LAPTOP/PC / DESKTOP MODE: do alag buttons. Script inhe .m-pop-right mein Total ke neeche le jati hai.
     Phone / tablet par ye display:none rehte hain. -->
<div class="msb-dsk" id="msbDsk">
  <button type="button" class="msb-d-cart" id="msbDCart">Add to Cart</button>
  <button type="button" class="msb-d-buy" id="msbDBuy">Buy it now</button>
</div>

<style is:global>
  /* Bar ki height yahan se badlein (baqi sab khud adjust ho jata hai)
     --msb-total = upar ki patli white patti, --msb-row = buttons wali row */
  :root {
    --msb-total: 19px;
    --msb-row: 45px;
  }
  /* Landscape mein chhoti height wale phone par bar thori patli, taake screen na ghere */
  @media (orientation: landscape) and (max-height: 500px) {
    :root { --msb-total: 17px; --msb-row: 40px; }
  }

  .msb {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 8800;
    display: flex; flex-direction: column; box-sizing: border-box;
    padding-bottom: env(safe-area-inset-bottom, 0px);
    padding-left: env(safe-area-inset-left, 0px);
    padding-right: env(safe-area-inset-right, 0px);
    background: #fff;
    border-top: none;
    /* Bar par ab koi shadow nahi: price patti aur buttons row apni apni shadow se ubhre hue hain */
    box-shadow: none;
    font-family: 'Segoe UI', 'Montserrat', sans-serif;
  }

  /* TOTAL LINE: patli aur soft (row iske upar ubhri hui hai, is liye neeche ki border nahi) */
  .msb-total {
    position: relative; z-index: 1;
    height: var(--msb-total); display: flex; align-items: center; justify-content: space-between;
    padding: 0 16px; background: #fff; border-bottom: none;
    /* Price patti page se ubhri hui: tight, saaf shadow (phailti nahi) */
    box-shadow:
      0 -1px 0 rgba(0, 0, 0, 0.10),
      0 -3px 5px -1px rgba(0, 0, 0, 0.20);
  }
  .msb-t-left { display: flex; align-items: baseline; gap: 7px; min-width: 0; }
  .msb-t-lab { font-family: 'Montserrat', sans-serif; font-size: 8px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; color: #a8505c; }
  .msb-t-new { font-family: 'Montserrat', sans-serif; font-size: 13px; font-weight: 700; letter-spacing: .2px; color: #e6007e; line-height: 1; }
  .msb-t-old { font-size: 9.5px; font-weight: 500; color: #a0a0a0; }
  .msb-t-save { font-size: 9.5px; font-weight: 600; letter-spacing: .2px; color: #1e8e4e; white-space: nowrap; }
  .msb-t-old[hidden], .msb-t-save[hidden] { display: none; }

  /* BAR ROW: total patti se UBHRI HUI (elite look).
     z-index upar, upar ki taraf tight shadow + bareek roshan edge line */
  .msb-row {
    position: relative; z-index: 2;
    display: flex; align-items: stretch; height: var(--msb-row); padding-left: 2px; background: #fff;
    box-shadow:
      0 -1px 0 rgba(0, 0, 0, 0.08),
      0 -4px 6px -2px rgba(0, 0, 0, 0.32);
  }
  .msb-row::before {
    content: ""; position: absolute; left: 0; right: 0; top: 0; height: 1px;
    background: rgba(255, 255, 255, 0.95);
    pointer-events: none; z-index: 3;
  }
  /* Home / Chat: alag alag ubhre hue chips (apni shadow, halka border, thora upar uthe hue) */
  .msb-ic {
    flex: 0 0 48px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
    align-self: center; height: calc(var(--msb-row) - 11px); margin: 0 3px; box-sizing: border-box;
    background: linear-gradient(180deg, #ffffff, #fff6f9);
    border: 1px solid #f1d3e0; border-radius: 11px; padding: 0;
    cursor: pointer; text-decoration: none;
    color: #800000; -webkit-tap-highlight-color: transparent; touch-action: manipulation;
    transform: translateY(-2px);
    box-shadow:
      0 -2px 3px rgba(0, 0, 0, 0.10),
      0 4px 6px -2px rgba(80, 20, 40, 0.38),
      inset 0 1px 0 #fff;
    transition: transform .2s ease, box-shadow .2s ease, color .2s ease;
  }
  .msb-ic svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .msb-ic span { font-size: 9px; font-weight: 700; letter-spacing: .2px; line-height: 1; }
  .msb-ic:active { color: #e6007e; transform: translateY(0); box-shadow: 0 1px 2px rgba(80, 20, 40, 0.30), inset 0 1px 0 #fff; }
  @media (hover: hover) { .msb-ic:hover { color: #e6007e; } }

  /* Buttons ki lift: filter parent par lagta hai, is liye clip-path (tirchhe kone) ke saath bhi shadow sahi aati hai.
     Buttons price patti ki taraf thora aur upar uthe hue. */
  .msb-btns {
    flex: 1; display: flex; min-width: 0;
    filter: drop-shadow(0 -3px 3px rgba(60, 0, 20, 0.40));
  }
  .msb-cart, .msb-buy {
    flex: 1; min-width: 0; border: none; cursor: pointer; color: #fff;
    font-family: inherit; font-size: 14px; font-weight: 700; letter-spacing: .3px;
    white-space: nowrap; -webkit-tap-highlight-color: transparent; touch-action: manipulation;
    transition: background .25s ease;
  }
  .msb-cart {
    background: #800000;
    clip-path: polygon(12px 0, 100% 0, 100% 100%, 0 100%);
    padding-left: 8px;
  }
  .msb-buy {
    background: #a3301f;
    clip-path: polygon(12px 0, 100% 0, 100% 100%, 0 100%);
    margin-left: -12px; padding-left: 12px;
  }
  .msb-cart:active, .msb-buy:active { background: #e6007e; }
  @media (hover: hover) { .msb-cart:hover, .msb-buy:hover { background: #e6007e; } }

  /* chhoti screens (iPhone SE / chhote Android) */
  @media (max-width: 380px) {
    .msb-cart, .msb-buy { font-size: 12.5px; }
    .msb-ic { flex-basis: 44px; margin: 0 2px; }
    .msb-total { padding: 0 12px; }
  }
  @media (max-width: 340px) {
    .msb-cart, .msb-buy { font-size: 11.5px; letter-spacing: 0; }
    .msb-ic { flex-basis: 40px; margin: 0 2px; }
    .msb-ic span { font-size: 8.5px; }
  }

  /* Landscape phone: bar poori width, left/right gap nahi. Safe-area (notch) upar padding mein sambhali hui hai. */
  @media (orientation: landscape) and (max-height: 500px) {
    .msb-cart, .msb-buy { font-size: 13.5px; }
    .msb-ic svg { width: 17px; height: 17px; }
    .msb-ic { height: calc(var(--msb-row) - 8px); gap: 1px; }
  }

  /* DESKTOP BUTTONS: phone / tablet par chhupe hue */
  .msb-dsk { display: none; }

  /* Laptop / PC aur mobile ka "Desktop site" mode (975px+): sticky bar bilkul band, uski jagah do buttons */
  @media (min-width: 975px) {
    .msb { display: none !important; }
    body.m-product-page { padding-bottom: 0 !important; }
    /* bar nahi hai to neeche ki extra jagah bhi nahi chahiye */
    .m-page-mode .m-pop-layout.m-pop-layout { padding-bottom: 28px !important; }

    .msb-dsk {
      display: flex; gap: 12px; align-items: stretch;
      width: 100%; margin: 8px 0 14px; box-sizing: border-box;
      font-family: 'Segoe UI', 'Montserrat', sans-serif;
      /* elite ubhra look: shadow parent par (clip-path wale buttons ke saath bhi sahi) */
      filter: drop-shadow(0 3px 3px rgba(60, 0, 20, 0.28));
    }
    .msb-d-cart, .msb-d-buy {
      flex: 1; min-width: 0; height: 48px; border: none; cursor: pointer; color: #fff;
      font-family: inherit; font-size: clamp(13px, 1.1vw, 15px); font-weight: 700; letter-spacing: .3px;
      white-space: nowrap;
      clip-path: polygon(12px 0, 100% 0, 100% 100%, 0 100%);
      padding: 0 12px 0 20px;
      -webkit-tap-highlight-color: transparent; touch-action: manipulation;
      /* slow pink + halka sa upar uthna */
      transition: background-color .55s ease, transform .45s cubic-bezier(.22, .61, .36, 1);
      will-change: transform;
    }
    .msb-d-cart { background-color: #800000; }
    .msb-d-buy  { background-color: #a3301f; }

    /* mouse hover aur touch (dabate waqt) dono par: thora upar + pink */
    .msb-d-cart:hover, .msb-d-buy:hover,
    .msb-d-cart:active, .msb-d-buy:active,
    .msb-d-cart:focus-visible, .msb-d-buy:focus-visible {
      background-color: #e6007e;
      transform: translateY(-3px);
      outline: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .msb-d-cart, .msb-d-buy { transition: background-color .3s ease; }
    .msb-d-cart:hover, .msb-d-buy:hover,
    .msb-d-cart:active, .msb-d-buy:active { transform: none; }
  }

  /* Product page: phone / tablet par bar ke peeche content na chhupe, purane do buttons chhupe
     (bar / naye buttons unhi ko click karte hain, is liye wo DOM mein rehte hain) */
  body.m-product-page { padding-bottom: calc(var(--msb-total) + var(--msb-row) + 16px + env(safe-area-inset-bottom, 0px)); }
  .m-product-page-wrap .m-buy-now-btn,
  .m-product-page-wrap .m-cart-add-trigger { display: none !important; }
</style>

<script is:inline>
(function () {
  var bar = document.getElementById('mStickyBar');
  if (!bar) return;
  var id = bar.getAttribute('data-id');

  function root() { return document.getElementById(id); }
  function realBtn(sel) { var r = root(); return r ? r.querySelector(sel) : null; }

  function doBuy()  { var b = realBtn('.m-buy-now-btn');      if (b) b.click(); }
  function doCart() { var b = realBtn('.m-cart-add-trigger'); if (b) b.click(); }

  /* phone / tablet bar */
  document.getElementById('msbBuy').addEventListener('click', doBuy);
  document.getElementById('msbCart').addEventListener('click', doCart);
  document.getElementById('msbChat').addEventListener('click', function () {
    if (window.openSupportChat) window.openSupportChat();
  });

  /* desktop buttons (same logic: wahi asli buttons click hote hain) */
  var dBuy = document.getElementById('msbDBuy');
  var dCart = document.getElementById('msbDCart');
  if (dBuy) dBuy.addEventListener('click', doBuy);
  if (dCart) dCart.addEventListener('click', doCart);

  /* desktop buttons ko right side mein Total ke neeche rakho */
  function placeDesktop() {
    var dsk = document.getElementById('msbDsk');
    var r = root();
    if (!dsk || !r) return;
    var bill = r.querySelector('.m-final-bill');
    if (bill && bill.parentNode && bill.nextElementSibling !== dsk) {
      bill.parentNode.insertBefore(dsk, bill.nextSibling);
    }
  }
  placeDesktop();
  document.addEventListener('DOMContentLoaded', placeDesktop);
  window.addEventListener('load', function () { placeDesktop(); setTimeout(placeDesktop, 500); });
  setTimeout(placeDesktop, 300);

  /* ---- TOTAL (phone bar): .m-final-bill se live sync ---- */
  var tNew = document.getElementById('msbTNew');
  var tOld = document.getElementById('msbTOld');
  var tSave = document.getElementById('msbTSave');

  function sync() {
    var r = root();
    var bill = r ? r.querySelector('.m-final-bill') : null;
    if (!bill) return;
    var sp = bill.querySelector('span');
    var v = sp ? sp.textContent.trim() : '';
    if (v) tNew.textContent = 'AED ' + v;

    var old = bill.querySelector('.m-final-old');
    var save = bill.querySelector('.m-final-save');
    if (old && old.textContent.trim()) { tOld.textContent = old.textContent.trim(); tOld.hidden = false; }
    else { tOld.hidden = true; }
    if (save && save.textContent.trim()) { tSave.textContent = save.textContent.trim(); tSave.hidden = false; }
    else { tSave.hidden = true; }
  }

  var r0 = root();
  var bill0 = r0 ? r0.querySelector('.m-final-bill') : null;
  if (bill0) {
    new MutationObserver(sync).observe(bill0, { childList: true, subtree: true, characterData: true });
  }
  sync();
  setTimeout(sync, 400);
  window.addEventListener('load', function () { sync(); setTimeout(sync, 600); });

  /* "Please select color & quantity first" wala message beech wale soft alert mein dikhao */
  var al = document.getElementById('cart-alert-' + id);
  if (al) {
    new MutationObserver(function () {
      var shown = al.style.display && al.style.display !== 'none';
      if (shown && window.showEliteAlert && document.getElementById('m-elite-alert')) {
        al.style.display = 'none';
        window.showEliteAlert("<span class='m-al-title'>SELECT FIRST</span><span class='m-al-text'>Please choose a color and quantity first.</span>");
      }
    }).observe(al, { attributes: true, attributeFilter: ['style'] });
  }
})();
</script>