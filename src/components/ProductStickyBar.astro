---
// Sticky bottom bar (Daraz style): upar patli total line, neeche Home | Chat | Cart | Buy it now
// Total .m-final-bill se live sync hota hai (koi nayi calculation nahi, sirf wahi number dikhata hai).
const { id } = Astro.props;
---
<div id="mStickyBar" class="msb" role="toolbar" aria-label="Quick actions" data-id={id}>

  <div class="msb-total" aria-live="polite">
    <div class="msb-t-left">
      <span class="msb-t-lab">Total</span>
      <b class="msb-t-new" id="msbTNew">AED</b>
      <s class="msb-t-old" id="msbTOld" hidden></s>
    </div>
    <span class="msb-t-save" id="msbTSave" hidden></span>
  </div>

  <div class="msb-row">
    <a class="msb-ic" href="/" aria-label="Home">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v10h13V10"/><path d="M10 20v-5.5h4V20"/></svg>
      <span>Home</span>
    </a>

    <button type="button" class="msb-ic" id="msbChat" aria-label="Chat with us">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.8 8.8 0 0 1-3.6-.8L3 20.5l1.5-4.9A8.3 8.3 0 0 1 3 11.5 8.5 8.5 0 0 1 12 3a8.5 8.5 0 0 1 9 8.5z"/><circle cx="8.5" cy="11.5" r=".8" fill="currentColor"/><circle cx="12" cy="11.5" r=".8" fill="currentColor"/><circle cx="15.5" cy="11.5" r=".8" fill="currentColor"/></svg>
      <span>Chat</span>
    </button>

    <div class="msb-btns">
      <button type="button" class="msb-cart" id="msbCart">Add to Cart</button>
      <button type="button" class="msb-buy" id="msbBuy">Buy it now</button>
    </div>
  </div>
</div>

<style is:global>
  .msb {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 8800;
    display: flex; flex-direction: column;
    padding-bottom: env(safe-area-inset-bottom, 0px);
    background: #fff;
    border-top: 1px solid #ececec;
    /* upar ki taraf soft shadow: bar page se alag nazar aaye */
    box-shadow: 0 -6px 18px rgba(0, 0, 0, 0.12), 0 -1px 4px rgba(0, 0, 0, 0.06);
    font-family: 'Segoe UI', 'Montserrat', sans-serif;
  }

  /* TOTAL LINE: patli, pure white */
  .msb-total {
    height: 24px; display: flex; align-items: center; justify-content: space-between;
    padding: 0 14px; background: #fff; border-bottom: 1px solid #f0f0f0;
  }
  .msb-t-left { display: flex; align-items: baseline; gap: 7px; min-width: 0; }
  .msb-t-lab { font-family: 'Montserrat', sans-serif; font-size: 8px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; color: #a8505c; }
  .msb-t-new { font-family: 'Montserrat', sans-serif; font-size: 13px; font-weight: 700; letter-spacing: .2px; color: #e6007e; line-height: 1; }
  .msb-t-old { font-size: 9.5px; font-weight: 500; color: #a0a0a0; }
  .msb-t-save { font-size: 9.5px; font-weight: 600; letter-spacing: .2px; color: #1e8e4e; white-space: nowrap; }
  .msb-t-old[hidden], .msb-t-save[hidden] { display: none; }

  /* BAR: patli (40px), white */
  .msb-row { display: flex; align-items: stretch; height: 40px; padding-left: 4px; background: #fff; }
  .msb-ic {
    flex: 0 0 44px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1px;
    background: none; border: none; padding: 0; cursor: pointer; text-decoration: none;
    color: #800000; -webkit-tap-highlight-color: transparent; touch-action: manipulation;
  }
  .msb-ic svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .msb-ic span { font-size: 8.5px; font-weight: 700; letter-spacing: .2px; line-height: 1; }
  .msb-ic:active { color: #e6007e; }
  @media (hover: hover) { .msb-ic:hover { color: #e6007e; } }

  .msb-btns { flex: 1; display: flex; min-width: 0; }
  .msb-cart, .msb-buy {
    flex: 1; border: none; cursor: pointer; color: #fff;
    font-family: inherit; font-size: 13px; font-weight: 700; letter-spacing: .3px;
    white-space: nowrap; -webkit-tap-highlight-color: transparent; touch-action: manipulation;
    transition: background .25s ease;
  }
  .msb-cart {
    background: #800000;
    clip-path: polygon(12px 0, 100% 0, 100% 100%, 0 100%);
    padding-left: 8px;
  }
  .msb-buy {
    background: #a3301f;
    clip-path: polygon(12px 0, 100% 0, 100% 100%, 0 100%);
    margin-left: -12px; padding-left: 12px;
  }
  /* dono buttons par pink: laptop par hover, mobile par dabate waqt */
  .msb-cart:active, .msb-buy:active { background: #e6007e; }
  @media (hover: hover) { .msb-cart:hover, .msb-buy:hover { background: #e6007e; } }

  @media (max-width: 380px) {
    .msb-cart, .msb-buy { font-size: 12px; }
    .msb-ic { flex-basis: 40px; }
    .msb-total { padding: 0 10px; }
  }

  /* Laptop / PC: bar beech mein (shadow bhi dikhe, is liye overflow hidden nahi) */
  @media (min-width: 1024px) {
    .msb { left: 50%; right: auto; width: 620px; transform: translateX(-50%); border-radius: 14px 14px 0 0; border: 1px solid #ececec; border-bottom: none; }
    .msb-total { border-radius: 14px 14px 0 0; }
  }

  /* Sirf product page: bar ke peeche content na chhupe, purane do buttons chhupe
     (bar unhi ko click karta hai, is liye wo DOM mein rehte hain) */
  body.m-product-page { padding-bottom: calc(72px + env(safe-area-inset-bottom, 0px)); }
  .m-product-page-wrap .m-buy-now-btn,
  .m-product-page-wrap .m-cart-add-trigger { display: none !important; }
</style>

<script is:inline>
(function () {
  var bar = document.getElementById('mStickyBar');
  if (!bar) return;
  var id = bar.getAttribute('data-id');

  function root() { return document.getElementById(id); }
  function realBtn(sel) { var r = root(); return r ? r.querySelector(sel) : null; }

  document.getElementById('msbBuy').addEventListener('click', function () {
    var b = realBtn('.m-buy-now-btn');
    if (b) b.click();
  });
  document.getElementById('msbCart').addEventListener('click', function () {
    var b = realBtn('.m-cart-add-trigger');
    if (b) b.click();
  });
  document.getElementById('msbChat').addEventListener('click', function () {
    if (window.openSupportChat) window.openSupportChat();
  });

  /* ---- TOTAL: .m-final-bill se live sync ---- */
  var tNew = document.getElementById('msbTNew');
  var tOld = document.getElementById('msbTOld');
  var tSave = document.getElementById('msbTSave');

  function sync() {
    var r = root();
    var bill = r ? r.querySelector('.m-final-bill') : null;
    if (!bill) return;
    var sp = bill.querySelector('span');
    var v = sp ? sp.textContent.trim() : '';
    if (v) tNew.textContent = 'AED ' + v;

    var old = bill.querySelector('.m-final-old');
    var save = bill.querySelector('.m-final-save');
    if (old && old.textContent.trim()) { tOld.textContent = old.textContent.trim(); tOld.hidden = false; }
    else { tOld.hidden = true; }
    if (save && save.textContent.trim()) { tSave.textContent = save.textContent.trim(); tSave.hidden = false; }
    else { tSave.hidden = true; }
  }

  var r0 = root();
  var bill0 = r0 ? r0.querySelector('.m-final-bill') : null;
  if (bill0) {
    new MutationObserver(sync).observe(bill0, { childList: true, subtree: true, characterData: true });
  }
  sync();
  setTimeout(sync, 400);
  window.addEventListener('load', function () { sync(); setTimeout(sync, 600); });

  /* "Please select color & quantity first" wala message beech wale soft alert mein dikhao */
  var al = document.getElementById('cart-alert-' + id);
  if (al) {
    new MutationObserver(function () {
      var shown = al.style.display && al.style.display !== 'none';
      if (shown && window.showEliteAlert && document.getElementById('m-elite-alert')) {
        al.style.display = 'none';
        window.showEliteAlert("<span class='m-al-title'>SELECT FIRST</span><span class='m-al-text'>Please choose a color and quantity first.</span>");
      }
    }).observe(al, { attributes: true, attributeFilter: ['style'] });
  }
})();
</script>