---
// SupportChat.astro : elite auto-reply support widget (free, koi API / server nahi).
// Live agent ka WhatsApp number src/config/site.js se aata hai (whatsappUrl), yahan number likhna nahi.
// Jawab badalne hon to neeche <script> ke andar TOPICS mein sirf text badlein.
//
// OFFERS: products.js se khud aate hain (jis product par offer2/offer3 ho). Yahan kuch manual nahi.
//         Link category page par jata hai (categories.js se) aur #id se usi product par scroll hota hai.
//
// hideLauncher prop: true ho to floating chat icon nahi dikhta (order page par use hota hai).
//       Chat tab "Need help?" button se window.openSupportChat() ke zariye khulta hai.
import { whatsappUrl } from '../config/site.js';
import { offerProducts, offerDetails } from '../data/products.js';
import { categories } from '../data/categories.js';

const { hideLauncher = false } = Astro.props;

let wa = '';
try { wa = whatsappUrl() || ''; } catch (e) { wa = ''; }

// ----- Offers: product kis category page par hai (home / shop-all ko baad mein rakha) -----
const catByTag = {};
for (const c of categories) { if (!(c.tag in catByTag)) catByTag[c.tag] = c.slug; }

const pageFor = (p) => {
  const pl = p.placements || [];
  for (const t of pl) {
    if (t !== 'shop-all' && t !== 'home' && catByTag[t]) return '/' + catByTag[t];
  }
  if (pl.includes('shop-all')) return '/store';
  if (pl.includes('home')) return '/';
  return '/store';
};

const offers = offerProducts.map((p) => {
  const d = offerDetails(p);
  return { n: p.name, u: pageFor(p) + '#' + p.id, o2: d.o2, o3: d.o3 };
});
---
<div id="mscRoot" class={"msc-root" + (hideLauncher ? " msc-no-launcher" : "")} data-wa={wa} data-offers={JSON.stringify(offers)}>

  <div id="mscBackdrop" class="msc-backdrop" aria-hidden="true"></div>

  <button type="button" id="mscLauncher" class="msc-launcher" aria-label="Open Musfira's support chat" aria-expanded="false" aria-controls="mscPanel">
    <span class="msc-launcher-tip">Need help?</span>
    <svg class="msc-ic-chat" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.8 8.8 0 0 1-3.6-.8L3 20.5l1.5-4.9A8.3 8.3 0 0 1 3 11.5 8.5 8.5 0 0 1 12 3a8.5 8.5 0 0 1 9 8.5z"/><circle cx="8.5" cy="11.5" r=".8" fill="currentColor"/><circle cx="12" cy="11.5" r=".8" fill="currentColor"/><circle cx="15.5" cy="11.5" r=".8" fill="currentColor"/></svg>
    <svg class="msc-ic-x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>

  <section id="mscPanel" class="msc-panel" role="dialog" aria-modal="true" aria-label="Musfira's support chat" aria-hidden="true">
    <header class="msc-head">
      <div class="msc-avatar" aria-hidden="true">M</div>
      <div class="msc-head-text">
        <div class="msc-title">Musfira’s Support</div>
        <div class="msc-sub"><i></i>Online · Instant answers</div>
      </div>
      <button type="button" id="mscClose" class="msc-close" aria-label="Close chat">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </header>

    <div class="msc-tag" aria-hidden="true"><i></i><span>Made to adore</span><i></i></div>

    <div id="mscBody" class="msc-body" aria-live="polite"></div>

    <div class="msc-chipwrap">
      <div id="mscChips" class="msc-chips"></div>
      <!-- Neeche aur buttons chhupe hon to chhota soft arrow nazar aata hai -->
      <div id="mscMore" class="msc-more" aria-hidden="true">
        <button type="button" id="mscMoreBtn" class="msc-more-btn" tabindex="-1" aria-label="Show more options">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </button>
      </div>
    </div>
  </section>
</div>

<style is:global>
.msc-root{
  --msc-pink:#e6007e;
  --msc-maroon:var(--orange-maroon,#a3301f);
  --msc-lpink:#fce4f0;
  --msc-line:#f4dde9;
  --msc-text:#5b4651;
  --msc-sat:env(safe-area-inset-top,0px);
  --msc-sab:env(safe-area-inset-bottom,0px);
  font-family:'Montserrat',system-ui,sans-serif;
}

html.msc-lock, html.msc-lock body{ overflow:hidden !important; }

/* ───── Backdrop ───── */
.msc-backdrop{
  position:fixed; inset:0; z-index:2147483000;
  background:rgba(70,14,36,.34);
  -webkit-backdrop-filter:blur(3px); backdrop-filter:blur(3px);
  opacity:0; visibility:hidden; touch-action:none;
  transition:opacity .3s ease, visibility 0s linear .3s;
}
.msc-backdrop.is-open{ opacity:1; visibility:visible; transition:opacity .3s ease, visibility 0s; }

/* ───── Launcher (chota kiya: 36px) ───── */
.msc-launcher{
  position:fixed; z-index:8900;
  right:16px; right:max(16px, env(safe-area-inset-right,0px));
  bottom:18px; bottom:calc(18px + env(safe-area-inset-bottom,0px));
  width:36px; height:36px; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  background-color:var(--msc-maroon);
  color:#fff; border:2px solid #fff; cursor:pointer;
  box-shadow:0 8px 20px rgba(163,48,31,.32), 0 2px 6px rgba(0,0,0,.1);
  transition:transform .35s cubic-bezier(.22,.61,.36,1), box-shadow .35s ease, background-color .3s ease;
  -webkit-tap-highlight-color:transparent; touch-action:manipulation;
}
.msc-launcher svg{ width:16px; height:16px; display:block; }
.msc-launcher .msc-ic-x{ display:none; }
.msc-launcher.is-open{ z-index:2147483002; }
.msc-launcher.is-open .msc-ic-chat{ display:none; }
.msc-launcher.is-open .msc-ic-x{ display:block; }
.msc-launcher::before, .msc-launcher::after{
  content:""; position:absolute; inset:-3px; border-radius:50%;
  border:2px solid rgba(230,0,126,.5); opacity:0; pointer-events:none;
  animation:mscRing 4.8s ease-out infinite;
}
.msc-launcher::after{ animation-delay:.5s; }
.msc-launcher.is-open::before, .msc-launcher.is-open::after{ animation:none; }
@keyframes mscRing{
  0%,66%{ transform:scale(1); opacity:0; }
  72%{ opacity:.75; }
  100%{ transform:scale(1.7); opacity:0; }
}
.msc-launcher:active{ transform:scale(.93); background-color:var(--msc-pink); }
.msc-launcher-tip{
  position:absolute; right:calc(100% + 12px); top:50%;
  transform:translateY(-50%) translateX(6px);
  padding:7px 13px; border-radius:999px; background:#fff; color:var(--msc-maroon);
  border:1px solid #f5cfe3; box-shadow:0 8px 22px rgba(156,41,84,.14);
  font-size:10px; font-weight:800; letter-spacing:1.1px; text-transform:uppercase; white-space:nowrap;
  opacity:0; pointer-events:none;
  transition:opacity .3s ease, transform .35s cubic-bezier(.22,.61,.36,1);
}
.msc-launcher.is-open .msc-launcher-tip{ display:none; }
@media (hover:hover){
  .msc-launcher:hover{ background-color:var(--msc-pink); transform:translateY(-3px); box-shadow:0 12px 26px rgba(230,0,126,.4), 0 3px 8px rgba(0,0,0,.12); }
  .msc-launcher:hover .msc-launcher-tip{ opacity:1; transform:translateY(-50%) translateX(0); }
}

/* ───── Panel: height screen ke hisaab se khud set (har device mein fit) ───── */
.msc-panel{
  position:fixed; z-index:2147483001;
  right:16px; right:max(16px, env(safe-area-inset-right,0px));
  bottom:70px; bottom:calc(70px + env(safe-area-inset-bottom,0px));
  width:380px; max-width:calc(100vw - 24px);
  height:min(600px, calc(100vh - 86px));
  height:min(600px, calc(100dvh - 86px - env(safe-area-inset-top,0px) - env(safe-area-inset-bottom,0px)));
  display:flex; flex-direction:column; overflow:hidden;
  background:#fff; border:1px solid var(--msc-line); border-radius:22px;
  box-shadow:0 26px 70px rgba(120,20,60,.28), 0 4px 14px rgba(0,0,0,.08);
  opacity:0; visibility:hidden; pointer-events:none;
  transform:translateY(16px) scale(.97); transform-origin:bottom right;
  transition:opacity .3s ease, transform .4s cubic-bezier(.22,.61,.36,1), visibility 0s linear .4s;
}
.msc-panel::before{
  content:""; position:absolute; top:0; left:0; right:0; height:2px; z-index:2;
  background:var(--msc-maroon);
}
.msc-panel.is-open{
  opacity:1; visibility:visible; pointer-events:auto; transform:none;
  transition:opacity .3s ease, transform .4s cubic-bezier(.22,.61,.36,1), visibility 0s;
}

/* ───── Header ───── */
.msc-head{
  flex:0 0 auto;
  display:flex; align-items:center; gap:12px; padding:14px 14px 8px 16px;
  background:linear-gradient(180deg,#fff 0%,#fff6fa 100%);
}
.msc-avatar{
  flex-shrink:0; width:38px; height:38px; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  background:#fff; color:var(--msc-pink);
  border:1.5px solid #f6bcd8;
  box-shadow:0 4px 12px rgba(230,0,126,.18);
  font-family:'Bodoni Moda',Georgia,serif; font-style:italic; font-size:21px; font-weight:600; line-height:1;
}
.msc-head-text{ flex:1; min-width:0; }
.msc-title{ font-size:14px; font-weight:800; letter-spacing:.4px; color:var(--msc-maroon); }
.msc-sub{ display:flex; align-items:center; gap:6px; margin-top:3px; font-size:11px; font-weight:600; color:#8a7480; }
.msc-sub i{ width:7px; height:7px; border-radius:50%; background:#2fcf6b; box-shadow:0 0 0 3px rgba(47,207,107,.2); display:block; }
.msc-close{
  flex-shrink:0; width:32px; height:32px; border-radius:50%; border:1px solid #f5cfe3; cursor:pointer;
  display:flex; align-items:center; justify-content:center;
  background:var(--msc-lpink); color:var(--msc-maroon); transition:all .25s ease;
  -webkit-tap-highlight-color:transparent; touch-action:manipulation;
}
.msc-close svg{ width:14px; height:14px; }
.msc-close:active{ background:var(--msc-pink); color:#fff; border-color:transparent; }
@media (hover:hover){ .msc-close:hover{ background:var(--msc-pink); color:#fff; border-color:transparent; } }

/* ───── Tagline ───── */
.msc-tag{
  flex:0 0 auto;
  display:flex; align-items:center; justify-content:center; gap:8px;
  padding:0 16px 7px; background:#fff6fa; border-bottom:1px solid var(--msc-line);
}
.msc-tag span{
  font-family:'Bodoni Moda',Georgia,serif; font-style:italic; font-size:12px;
  color:var(--msc-pink); letter-spacing:.3px; white-space:nowrap;
}
.msc-tag i{ display:block; width:26px; height:1px; background:linear-gradient(90deg,var(--msc-pink),transparent); opacity:.7; }
.msc-tag i:first-child{ background:linear-gradient(90deg,transparent,var(--msc-pink)); }

/* ───── Soft pink scrollbar ───── */
.msc-body, .msc-chips{ scrollbar-width:thin; scrollbar-color:#ee86b9 #fbe3ef; overscroll-behavior:contain; }
.msc-body::-webkit-scrollbar, .msc-chips::-webkit-scrollbar{ width:6px; }
.msc-body::-webkit-scrollbar-track, .msc-chips::-webkit-scrollbar-track{ background:#fbe3ef; border-radius:6px; margin:6px 0; }
.msc-body::-webkit-scrollbar-thumb, .msc-chips::-webkit-scrollbar-thumb{
  background:linear-gradient(180deg,#f48fc0,#e6007e); border-radius:6px;
}
.msc-body::-webkit-scrollbar-thumb:hover, .msc-chips::-webkit-scrollbar-thumb:hover{ background:var(--msc-pink); }

/* ───── Messages: baqi bachi hui jagah le leta hai (kam az kam 96px) ───── */
.msc-body{
  flex:1 1 0; min-height:96px; overflow-y:auto; padding:14px 14px 8px; -webkit-overflow-scrolling:touch;
  background:linear-gradient(180deg,#fff6fa 0%,#fff 38%);
  display:flex; flex-direction:column; gap:10px; scroll-behavior:smooth;
}
.msc-msg{
  max-width:90%; padding:11px 15px; font-size:13.5px; line-height:1.65; font-weight:500;
  white-space:pre-line; word-break:break-word;
  animation:mscIn .35s cubic-bezier(.22,.61,.36,1);
}
.msc-msg.bot{
  align-self:flex-start; color:var(--msc-text); background:#fff;
  border:1px solid var(--msc-line); border-radius:4px 18px 18px 18px;
  box-shadow:0 4px 14px rgba(156,41,84,.06);
}
.msc-msg.me{
  align-self:flex-end; color:#fff; font-weight:600;
  background:linear-gradient(135deg,var(--msc-maroon),var(--msc-pink));
  border-radius:18px 4px 18px 18px;
  box-shadow:0 6px 16px rgba(230,0,126,.22);
}
@keyframes mscIn{ from{ opacity:0; transform:translateY(8px); } to{ opacity:1; transform:none; } }

.msc-typing{
  align-self:flex-start; display:flex; gap:5px; padding:14px 16px;
  background:#fff; border:1px solid var(--msc-line); border-radius:4px 18px 18px 18px;
}
.msc-typing span{ width:7px; height:7px; border-radius:50%; background:var(--msc-pink); opacity:.35; animation:mscDot 1.1s infinite ease-in-out; }
.msc-typing span:nth-child(2){ animation-delay:.18s; }
.msc-typing span:nth-child(3){ animation-delay:.36s; }
@keyframes mscDot{ 0%,70%,100%{ transform:translateY(0); opacity:.35; } 35%{ transform:translateY(-4px); opacity:1; } }

/* ───── Offers list (chat ke andar, har product ek tap) ───── */
.msc-offers{
  align-self:flex-start; width:92%;
  display:flex; flex-direction:column; gap:8px;
  animation:mscIn .35s cubic-bezier(.22,.61,.36,1);
}
.msc-offer{
  display:flex; align-items:center; justify-content:space-between; gap:10px;
  min-height:48px; padding:10px 14px;
  background:#fff; border:1px solid #f1c4da; border-radius:14px;
  text-decoration:none; box-shadow:0 4px 14px rgba(156,41,84,.07);
  transition:background .2s ease, border-color .2s ease, transform .2s ease, box-shadow .2s ease;
  -webkit-tap-highlight-color:transparent; touch-action:manipulation;
}
.msc-offer-t{ display:flex; flex-direction:column; gap:3px; min-width:0; }
.msc-offer-n{ font-size:13px; font-weight:800; color:var(--msc-maroon); line-height:1.25; word-break:break-word; }
.msc-offer-d{ font-size:11.5px; font-weight:700; color:var(--msc-pink); line-height:1.3; }
.msc-offer svg{ width:16px; height:16px; flex-shrink:0; color:var(--msc-pink); }
.msc-offer:active{ background:#fff0f7; border-color:var(--msc-pink); }
@media (hover:hover){
  .msc-offer:hover{ background:#fff6fa; border-color:var(--msc-pink); transform:translateY(-1px); box-shadow:0 8px 18px rgba(230,0,126,.16); }
}

/* ───── Chips area: panel ki height ka 44% tak, us se zyada ho to apne andar scroll ───── */
.msc-chipwrap{
  position:relative; flex:0 0 auto; min-height:0;
  max-height:44%;
  display:flex; flex-direction:column;
}
.msc-chips{
  flex:1 1 auto; min-height:0;
  display:flex; flex-wrap:wrap; align-content:flex-start; gap:6px; padding:8px 12px 10px;
  background:#fff6fa; border-top:1px solid var(--msc-line);
  overflow-y:auto; -webkit-overflow-scrolling:touch;
}
.msc-chips:empty{ display:none; }
.msc-chip{
  padding:6px 11px; border-radius:999px; cursor:pointer;
  background:#fff; color:var(--msc-maroon); border:1px solid #f1c4da;
  font-family:inherit; font-size:11.5px; font-weight:700; letter-spacing:.2px; text-align:left; line-height:1.25;
  transition:all .22s ease; animation:mscIn .4s ease backwards;
  -webkit-tap-highlight-color:transparent; touch-action:manipulation;
}
.msc-chip:active{ background:var(--msc-pink); color:#fff; border-color:transparent; }
@media (hover:hover){
  .msc-chip:hover{ background:var(--msc-pink); color:#fff; border-color:transparent; transform:translateY(-2px); box-shadow:0 8px 18px rgba(230,0,126,.24); }
}
/* Offers chip: halka pink tint, taake alag nazar aaye */
.msc-chip.hot{ background:#fff0f7; border-color:var(--msc-pink); }

/* Live agent: chhota, soft pale green, sab se upar */
.msc-chip.agent{
  order:-1; flex:1 1 100%;
  display:flex; align-items:center; justify-content:center; gap:7px;
  min-height:32px; padding:6px 12px; text-align:center; text-decoration:none;
  color:#15803d; background:#effaf3; border:1px solid #bfe8cf;
  font-size:11.5px; font-weight:700; letter-spacing:.3px; box-shadow:none;
}
.msc-chip.agent svg{ width:14px; height:14px; fill:currentColor; flex-shrink:0; }
.msc-chip.agent:active{ background:#27b867; color:#fff; border-color:transparent; }
@media (hover:hover){
  .msc-chip.agent:hover{ background:#27b867; color:#fff; border-color:transparent; box-shadow:0 6px 14px rgba(39,184,103,.28); }
}
.msc-chips.is-busy .msc-chip{ opacity:.5; pointer-events:none; }

/* ───── Chhota soft arrow: jab neeche aur buttons chhupe hon ───── */
.msc-more{
  position:absolute; left:0; right:6px; bottom:0; height:34px; z-index:3;
  display:flex; align-items:flex-end; justify-content:center; padding-bottom:4px;
  background:linear-gradient(180deg, rgba(255,246,250,0) 0%, rgba(255,246,250,.9) 60%, #fff6fa 100%);
  opacity:0; visibility:hidden; pointer-events:none;
  transition:opacity .25s ease, visibility 0s linear .25s;
}
.msc-more.is-on{ opacity:1; visibility:visible; transition:opacity .25s ease, visibility 0s; }
.msc-more-btn{
  position:relative; pointer-events:auto; cursor:pointer;
  width:26px; height:26px; padding:0; border-radius:50%;
  display:inline-flex; align-items:center; justify-content:center;
  background:rgba(255,255,255,.94); color:var(--msc-pink);
  border:1px solid #f3c1da;
  box-shadow:0 2px 8px rgba(230,0,126,.16);
  -webkit-tap-highlight-color:transparent; touch-action:manipulation;
}
.msc-more-btn::after{ content:""; position:absolute; inset:-7px; }
.msc-more-btn svg{ width:13px; height:13px; animation:mscBounce 1.6s ease-in-out infinite; }
.msc-more-btn:active{ background:var(--msc-pink); color:#fff; border-color:transparent; }
@media (hover:hover){ .msc-more-btn:hover{ background:var(--msc-pink); color:#fff; border-color:transparent; } }
@keyframes mscBounce{ 0%,100%{ transform:translateY(-1px); } 50%{ transform:translateY(2px); } }

/* ───── Bari screen (desktop / PC / bara laptop) ───── */
@media (min-width:1280px) and (min-height:760px){
  .msc-panel{
    width:400px;
    height:min(640px, calc(100vh - 86px));
    height:min(640px, calc(100dvh - 86px - env(safe-area-inset-top,0px) - env(safe-area-inset-bottom,0px)));
  }
  .msc-msg{ font-size:14px; }
}

/* ───── Tablet / iPad ───── */
@media (min-width:521px) and (max-width:1024px){
  .msc-panel{
    width:392px;
    height:min(620px, calc(100vh - 86px));
    height:min(620px, calc(100dvh - 86px - env(safe-area-inset-top,0px) - env(safe-area-inset-bottom,0px)));
  }
}

/* ───── Mobile / iPhone: panel ───── */
@media (max-width:520px){
  .msc-panel{
    left:10px; right:10px; width:auto; max-width:none;
    left:max(10px, env(safe-area-inset-left,0px)); right:max(10px, env(safe-area-inset-right,0px));
    bottom:64px; bottom:calc(64px + env(safe-area-inset-bottom,0px));
    height:min(640px, calc(100vh - 80px));
    height:min(640px, calc(100dvh - 80px - env(safe-area-inset-top,0px) - env(safe-area-inset-bottom,0px)));
    border-radius:20px;
  }
  .msc-launcher{ width:36px; height:36px; right:14px; right:max(14px, env(safe-area-inset-right,0px)); bottom:14px; bottom:calc(14px + env(safe-area-inset-bottom,0px)); }
  .msc-body{ padding:12px 12px 8px; }
  .msc-msg{ max-width:92%; }
  .msc-offers{ width:96%; }
}

/* ───── TOUCH devices (phone, iPhone, iPad): aasan tap, magar jagah ka khayal ───── */
@media (pointer:coarse), (max-width:520px){
  .msc-msg{ font-size:14px; }
  .msc-chips{ gap:7px; padding:9px 12px 11px; }
  .msc-chip{
    min-height:40px; padding:9px 15px;
    font-size:12.5px; font-weight:700; line-height:1.2; border-width:1.5px;
    display:inline-flex; align-items:center;
  }
  .msc-chip.agent{
    min-height:38px; padding:8px 14px; font-size:12.5px; border-width:1px;
    display:flex; justify-content:center;
  }
  .msc-chip.agent svg{ width:16px; height:16px; }
  .msc-close{ width:38px; height:38px; }
  .msc-close svg{ width:15px; height:15px; }
  .msc-chips::-webkit-scrollbar{ width:5px; }
  .msc-more{ height:38px; }
  .msc-more-btn{ width:30px; height:30px; }
  .msc-more-btn svg{ width:14px; height:14px; }
}

/* ───── Chhoti height (chhota laptop window / phone landscape) ───── */
@media (max-height:700px){
  .msc-tag{ display:none; }
}
@media (max-height:620px){
  .msc-head{ padding:10px 14px 6px 16px; }
  .msc-avatar{ width:32px; height:32px; font-size:18px; }
  .msc-body{ min-height:84px; }
  .msc-chipwrap{ max-height:48%; }
}

/* ───── Launcher chhupa hua (order page) ───── */
.msc-root.msc-no-launcher .msc-launcher{ display:none !important; }
.msc-root.msc-no-launcher .msc-panel{
  bottom:16px; bottom:calc(16px + env(safe-area-inset-bottom,0px));
  height:min(640px, calc(100vh - 32px));
  height:min(640px, calc(100dvh - 32px - env(safe-area-inset-top,0px) - env(safe-area-inset-bottom,0px)));
}
@media (max-width:520px){
  .msc-root.msc-no-launcher .msc-panel{
    bottom:10px; bottom:calc(10px + env(safe-area-inset-bottom,0px));
    height:min(660px, calc(100vh - 24px));
    height:min(660px, calc(100dvh - 24px - env(safe-area-inset-top,0px) - env(safe-area-inset-bottom,0px)));
  }
}

@media (prefers-reduced-motion: reduce){
  .msc-launcher, .msc-panel, .msc-backdrop, .msc-chip, .msc-msg, .msc-more, .msc-offers, .msc-offer{ transition:none; animation:none; }
  .msc-launcher::before, .msc-launcher::after{ animation:none; }
  .msc-typing span{ animation:none; opacity:.8; }
  .msc-more-btn svg{ animation:none; }
  .msc-body{ scroll-behavior:auto; }
}
</style>

<script is:inline>
(function () {
  var root = document.getElementById('mscRoot');
  if (!root) return;

  var launcher = document.getElementById('mscLauncher');
  var panel = document.getElementById('mscPanel');
  var backdrop = document.getElementById('mscBackdrop');
  var closeBtn = document.getElementById('mscClose');
  var body = document.getElementById('mscBody');
  var chips = document.getElementById('mscChips');
  var more = document.getElementById('mscMore');
  var moreBtn = document.getElementById('mscMoreBtn');
  var WA = root.getAttribute('data-wa') || '';

  // Offers products.js se khud aate hain (build ke waqt). Yahan kuch badalna nahi.
  var OFFERS = [];
  try { OFFERS = JSON.parse(root.getAttribute('data-offers') || '[]'); } catch (e) { OFFERS = []; }
  var MAX_OFFERS = 6;   // chat mein zyada se zyada kitne offer products dikhane hain

  // ===== JAWAB (sirf yahan text badlein) =====
  var GREETING = "Hi 👋 Welcome to Musfira’s!\nI’m here to help. What would you like to know?";
  var TOPICS = [
    { id: 'order', label: '🛍️ I want to place an order',
      answer: "Placing an order is quick and easy ✨\n\nYou can order in whichever way you like:\n\n• Buy it now: open any product and tap Buy it now to check out straight away.\n• Add to Cart: collect your favourites, then open your cart and check out together.\n\nEnter your delivery details and confirm. We will message you on WhatsApp to verify your order and get it on its way.\n\nPay when it reaches your door with Cash on Delivery." },
    { id: 'delivery', label: '🚚 Delivery time',
      answer: "We deliver across the UAE 🇦🇪\n\nEstimated delivery is 1–3 working days after your order is confirmed.\n\nOn public holidays, in bad weather or during busy courier periods, delivery can occasionally take a little longer. If that happens, we will keep you updated: your courier name and tracking details are shared on WhatsApp as soon as your order is dispatched, and our team is always happy to help you with any update 📦" },
    { id: 'payment', label: '💳 Payment methods',
      answer: "We offer Cash on Delivery 💵\n\nYou pay only when your order arrives at your door. No advance payment and no card details needed, so you can shop with complete peace of mind." },
    { id: 'shipping', label: '📦 Shipping charges',
      answer: "Shipping is complimentary 🎁\n\nWe deliver across the UAE at no extra cost, so the price you see is the price you pay." },
    { id: 'returns', label: '🔄 Returns & refund',
      answer: "You have 30 days to return or exchange your order 💖\n\nIf something is not right, just message us within 30 days of receiving your parcel and we will gladly help with a return, exchange or refund.\n\nPlease keep the item unused and in its original packaging." }
  ];

  // Offers button: sirf tab aata hai jab store mein kam az kam ek offer product ho
  if (OFFERS.length) {
    TOPICS.unshift({ id: 'offers', label: '🔥 Offers', offers: true,
      answer: "Here are our current offers 🎁\n\nTap any product to go straight to it." });
  }

  var AGENT_LABEL = 'Talk to a live agent';
  var FOLLOW = "Was that helpful? You can pick another question, or our team is happy to help personally 💕";
  var WA_ICON = '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>';
  var CHEV = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>';
  // ============================================

  var busy = false;
  var started = false;
  var lastTopic = '';
  var html = document.documentElement;
  var prevPad = '';

  function agentUrl(topic) {
    if (!WA) return '';
    var text = topic ? ("Hi Musfira's, I need help with: " + topic) : "Hi Musfira's, I need help.";
    try {
      var u = new URL(WA, window.location.href);
      u.searchParams.set('text', text);
      return u.toString();
    } catch (e) { return WA; }
  }

  function scrollDown() { body.scrollTop = body.scrollHeight; }

  // Chhota arrow tab dikhao jab chips ke neeche aur buttons chhupe hon
  function updateMore() {
    var hidden = chips.scrollHeight - chips.clientHeight;
    var canScroll = hidden > 6;
    var atEnd = chips.scrollTop + chips.clientHeight >= chips.scrollHeight - 6;
    more.classList.toggle('is-on', canScroll && !atEnd);
  }
  chips.addEventListener('scroll', updateMore, { passive: true });
  window.addEventListener('resize', updateMore);
  moreBtn.addEventListener('click', function () {
    chips.scrollBy({ top: Math.max(chips.clientHeight * 0.8, 80), behavior: 'smooth' });
  });

  function addMsg(text, who) {
    var d = document.createElement('div');
    d.className = 'msc-msg ' + who;
    d.textContent = text;
    body.appendChild(d);
    scrollDown();
    return d;
  }
  function showTyping() {
    var t = document.createElement('div');
    t.className = 'msc-typing';
    t.innerHTML = '<span></span><span></span><span></span>';
    body.appendChild(t);
    scrollDown();
    return t;
  }

  function botSay(text, done) {
    var dots = showTyping();
    var wait = 650 + Math.min(text.length * 3, 650);
    setTimeout(function () {
      dots.remove();
      var el = addMsg('', 'bot');
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) { el.textContent = text; scrollDown(); if (done) done(); return; }
      var i = 0;
      var step = text.length > 400 ? 5 : (text.length > 220 ? 3 : 2);
      (function tick() {
        i = Math.min(i + step, text.length);
        el.textContent = text.slice(0, i);
        scrollDown();
        if (i < text.length) { setTimeout(tick, 16); }
        else if (done) { done(); }
      })();
    }, wait);
  }

  // ----- Offers list: har product ek tap, seedha category page par us product tak -----
  function offerText(o) {
    var parts = [];
    if (o.o2) parts.push('Buy 2 for AED ' + o.o2);
    if (o.o3) parts.push('Buy 3 for AED ' + o.o3);
    return parts.join(' · ');
  }

  function goOffer(e, a) {
    var u = new URL(a.getAttribute('href'), window.location.href);
    var same = u.pathname.replace(/\/$/, '') === window.location.pathname.replace(/\/$/, '');
    closeChat();
    if (same) {
      // Isi page par hain: reload nahi, seedha us card par scroll aur nishani
      e.preventDefault();
      var id = decodeURIComponent(u.hash.slice(1));
      setTimeout(function () {
        if (window.mHighlightCard && window.mHighlightCard(id)) return;
        var el = document.getElementById(id);
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }, 200);
    }
  }

  function addOffers() {
    var wrap = document.createElement('div');
    wrap.className = 'msc-offers';
    OFFERS.slice(0, MAX_OFFERS).forEach(function (o) {
      var a = document.createElement('a');
      a.className = 'msc-offer';
      a.href = o.u;
      var t = document.createElement('span');
      t.className = 'msc-offer-t';
      var n = document.createElement('span');
      n.className = 'msc-offer-n';
      n.textContent = o.n;
      var d = document.createElement('span');
      d.className = 'msc-offer-d';
      d.textContent = offerText(o);
      t.appendChild(n);
      t.appendChild(d);
      a.appendChild(t);
      a.insertAdjacentHTML('beforeend', CHEV);
      a.addEventListener('click', function (e) { goOffer(e, a); });
      wrap.appendChild(a);
    });
    body.appendChild(wrap);
    scrollDown();
  }

  function renderChips(exceptId) {
    chips.innerHTML = '';
    chips.scrollTop = 0;

    // Live agent chip: sab se upar (CSS order:-1)
    var url = agentUrl(lastTopic);
    if (url) {
      var a = document.createElement('a');
      a.className = 'msc-chip agent';
      a.href = url;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.innerHTML = WA_ICON + '<span></span>';
      a.lastChild.textContent = AGENT_LABEL;
      chips.appendChild(a);
    }

    TOPICS.forEach(function (t, idx) {
      if (t.id === exceptId) return;
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'msc-chip' + (t.offers ? ' hot' : '');
      b.textContent = t.label;
      b.style.animationDelay = (idx * 60) + 'ms';
      b.addEventListener('click', function () { choose(t); });
      chips.appendChild(b);
    });
    chips.classList.remove('is-busy');

    updateMore();
    setTimeout(updateMore, 120);
    setTimeout(updateMore, 500);
  }

  function choose(topic) {
    if (busy) return;
    busy = true;
    chips.classList.add('is-busy');
    more.classList.remove('is-on');
    lastTopic = topic.label.replace(/^[^A-Za-z]+/, '');
    addMsg(topic.label, 'me');
    botSay(topic.answer, function () {
      if (topic.offers) addOffers();
      botSay(FOLLOW, function () {
        renderChips(topic.id);
        busy = false;
        scrollDown();
      });
    });
  }

  function start() {
    if (started) return;
    started = true;
    busy = true;
    botSay(GREETING, function () {
      renderChips('');
      busy = false;
    });
  }

  function lockScroll() {
    var sw = window.innerWidth - html.clientWidth;
    prevPad = document.body.style.paddingRight;
    if (sw > 0) { document.body.style.paddingRight = sw + 'px'; }
    html.classList.add('msc-lock');
  }
  function unlockScroll() {
    html.classList.remove('msc-lock');
    document.body.style.paddingRight = prevPad;
  }

  function openChat() {
    panel.classList.add('is-open');
    backdrop.classList.add('is-open');
    launcher.classList.add('is-open');
    panel.setAttribute('aria-hidden', 'false');
    launcher.setAttribute('aria-expanded', 'true');
    lockScroll();
    start();
    setTimeout(updateMore, 450);
  }
  function closeChat() {
    panel.classList.remove('is-open');
    backdrop.classList.remove('is-open');
    launcher.classList.remove('is-open');
    panel.setAttribute('aria-hidden', 'true');
    launcher.setAttribute('aria-expanded', 'false');
    unlockScroll();
  }

  launcher.addEventListener('click', function () {
    if (panel.classList.contains('is-open')) closeChat(); else openChat();
  });
  closeBtn.addEventListener('click', closeChat);
  backdrop.addEventListener('click', closeChat);
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && panel.classList.contains('is-open')) closeChat();
  });

  // iPhone / touch: piche ka page na hile
  backdrop.addEventListener('touchmove', function (e) { e.preventDefault(); }, { passive: false });
  panel.addEventListener('touchmove', function (e) {
    if (!e.target.closest('.msc-body, .msc-chips')) e.preventDefault();
  }, { passive: false });

  // Bahar se (order page ka "Need help?" button) chat kholne / band karne ke liye
  window.openSupportChat = openChat;
  window.closeSupportChat = closeChat;
})();
</script>