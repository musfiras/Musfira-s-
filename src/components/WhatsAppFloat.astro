---
// WhatsAppFloat.astro : page ke right corner mein chhota floating WhatsApp button.
// Number / message / on-off sab src/config/site.js se aata hai.
import { site, whatsappUrl } from '../config/site.js';
const wa = site.whatsapp;
---
{wa.show && (
  <a
    href={whatsappUrl()}
    class="mfs-wa"
    target="_blank"
    rel="noopener"
    aria-label={`${wa.label} on WhatsApp ${wa.display}`}
  >
    <svg viewBox="0 0 32 32" width="24" height="24" fill="currentColor" aria-hidden="true">
      <path d="M16.02 3C8.84 3 3 8.83 3 16c0 2.3.6 4.54 1.74 6.52L3 29l6.64-1.7A13 13 0 0 0 16.02 29C23.2 29 29 23.17 29 16S23.2 3 16.02 3Zm0 23.7c-1.95 0-3.86-.53-5.53-1.52l-.4-.24-3.94 1.01 1.05-3.84-.26-.4A10.66 10.66 0 0 1 5.3 16c0-5.9 4.82-10.7 10.72-10.7S26.7 10.1 26.7 16s-4.8 10.7-10.68 10.7Zm5.87-8c-.32-.16-1.9-.94-2.2-1.04-.3-.1-.5-.16-.72.16-.22.32-.83 1.04-1.02 1.26-.19.21-.38.24-.7.08-.32-.16-1.36-.5-2.59-1.6-.96-.85-1.6-1.9-1.79-2.22-.19-.32-.02-.5.14-.66.14-.14.32-.38.48-.57.16-.19.21-.32.32-.54.1-.21.05-.4-.03-.56-.08-.16-.72-1.74-.99-2.38-.26-.62-.52-.54-.72-.55h-.62c-.21 0-.56.08-.85.4-.3.32-1.12 1.1-1.12 2.68s1.15 3.1 1.31 3.32c.16.21 2.26 3.45 5.47 4.84.76.33 1.36.53 1.82.68.77.24 1.46.2 2.01.12.61-.09 1.9-.78 2.16-1.53.27-.75.27-1.39.19-1.52-.08-.14-.3-.22-.62-.38Z"/>
    </svg>
    <span class="mfs-wa-tip">{wa.label}</span>
  </a>
)}

<style is:global>
.mfs-wa{
  position:fixed;
  right:16px; right:max(16px, env(safe-area-inset-right, 0px));
  bottom:18px; bottom:calc(18px + env(safe-area-inset-bottom, 0px));
  z-index:9000; /* header (9999) aur cart drawer ke neeche */
  width:46px;height:46px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  color:#fff;text-decoration:none;
  background:linear-gradient(145deg,#2fcf6b 0%,#128c4a 100%);
  border:2px solid #fff;
  box-shadow:0 6px 16px rgba(18,140,74,.32),0 2px 5px rgba(0,0,0,.14);
  transition:transform .25s ease, box-shadow .25s ease;
  -webkit-tap-highlight-color:transparent;touch-action:manipulation;
}
.mfs-wa svg{display:block;}
.mfs-wa:active{transform:scale(.94);}
.mfs-wa:focus-visible{outline:2px solid var(--mfs-pink,#e6007e);outline-offset:3px;}
/* chhota label: sirf mouse wali devices par hover karne se nikalta hai */
.mfs-wa-tip{
  position:absolute;right:calc(100% + 10px);top:50%;
  transform:translateY(-50%) translateX(6px);
  background:#fff;color:var(--mfs-maroon,#a3301f);
  font-family:'Montserrat',sans-serif;font-size:10.5px;font-weight:800;letter-spacing:.8px;text-transform:uppercase;
  padding:7px 12px;border-radius:999px;border:1px solid #f5cfe3;
  box-shadow:0 4px 12px rgba(0,0,0,.08);
  white-space:nowrap;opacity:0;pointer-events:none;
  transition:opacity .2s ease, transform .2s ease;
}
@media (hover:hover){
  .mfs-wa:hover{transform:translateY(-3px);box-shadow:0 10px 22px rgba(18,140,74,.38),0 2px 6px rgba(0,0,0,.14);}
  .mfs-wa:hover .mfs-wa-tip, .mfs-wa:focus-visible .mfs-wa-tip{opacity:1;transform:translateY(-50%) translateX(0);}
}
@media (min-width:951px){
  .mfs-wa{width:50px;height:50px;right:24px;bottom:24px;}
  .mfs-wa svg{width:26px;height:26px;}
}
@media (prefers-reduced-motion: reduce){
  .mfs-wa, .mfs-wa-tip{transition:none;}
}
</style>
