---
import Header from '../components/Header.astro';
const { title = "Musfira's Store - Luxury Bags & Backpacks" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="icon" type="image/png" sizes="512x512" href="/mlogo.png?v=2" />
    <link rel="apple-touch-icon" href="/mlogo.png?v=2" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:wght@400..900&family=Montserrat:wght@700;800;900&display=swap" rel="stylesheet" />

    <style is:global>
      html, body { margin: 0; width: 100%; height: 100%; }
    </style>
  </head>
  <body>
    <Header />
    <slot />
    <!-- Footer yahan aayega (agla step) -->

    <!-- Cart drawer script aane tak cart icon par click error na de -->
    <script is:inline>
      if (typeof window.openDrawer !== 'function') { window.openDrawer = function () {}; }
    </script>
  </body>
</html>