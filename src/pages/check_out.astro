<script is:inline>
// =====================================================================
//  SETTINGS (sirf yahan)
// =====================================================================
const SCRIPT_URL = "https://store.musfiras.workers.dev";
const ORDER_KEY = "4Zr0aVGBeRo0aqIE52k1Jq";
const THANK_YOU_URL = "https://www.musfiras.com/thank_you";
const SHOP_URL = "https://www.musfiras.com/store";
const PAGE_VERSION = "order-page v12 color-wise thumbnails + elite floating look (2026-11-19)";

try { console.log("Musfira's " + PAGE_VERSION); } catch (e) {}

try {
    const pc = document.createElement('link');
    pc.rel = 'preconnect';
    pc.href = SCRIPT_URL;
    document.head.appendChild(pc);
} catch (e) {}

// =====================================================================
//  DIGITS: Arabic-Indic (٠١٢٣) aur Persian (۰۱۲۳) digits ko hamesha English (0123) bana do.
//  Is se customer ke phone / keyboard / language ka koi asar nahi parta.
// =====================================================================
function latinDigits(s) {
    return String(s == null ? "" : s)
        .replace(/[\u0660-\u0669]/g, function (d) { return String(d.charCodeAt(0) - 0x0660); })
        .replace(/[\u06F0-\u06F9]/g, function (d) { return String(d.charCodeAt(0) - 0x06F0); });
}
// URL ya kisi bhi text se poora number nikalna (commas / spaces / Arabic digits sab theek)
function numParam(v) {
    const s = latinDigits(v).replace(/[,\s\u066B\u066C\u00a0\u202f]/g, "");
    const n = parseInt(s, 10);
    return isNaN(n) ? 0 : n;
}

const urlParams = new URLSearchParams(window.location.search);
let products = [];
let deliveryType = "Standard";   // sirf COD + free delivery: link mein delivery=express bhi ho to ignore
let totalPayable = numParam(urlParams.get('total'));
let subtotalVal = numParam(urlParams.get('subtotal'));
let stockBlocked = false;

// Delivery hamesha FREE (koi shipping charge nahi)
let shipping = 0;

// Image link: sirf safe (http/https ya / se shuru hone wala) link hi chalta hai
function safeImg(u) {
    if (!u || typeof u !== 'string') return '';
    u = u.trim();
    if (!u || u.length > 600) return '';
    if (/^(https?:)?\/\//i.test(u) || u.charAt(0) === '/') return u;
    if (/^[\w\-./%]+\.(png|jpe?g|webp|avif|gif)(\?.*)?$/i.test(u)) return '/' + u.replace(/^\.?\//, '');
    return '';
}

// Format: name|color|qty|price||name|color|qty|price ...
// optional 5th/6th part: |p2|p3 = 2 items / 3 items ki offer qeemat (total)
// optional 7th part: |image link (thumbnail ke liye)
if (urlParams.has('data')) {
    let rawData = urlParams.get('data') || "";
    try { rawData = decodeURIComponent(rawData); } catch (e) {}
    const blocks = rawData.split('||');
    blocks.forEach(block => {
        const parts = block.split('|');
        if (parts.length >= 3) {
            let pName = parts[0] ? parts[0].trim() : "Premium Item";
            let pColor = parts[1] ? parts[1].trim() : "Default";
            let pQty = numParam(parts[2]);
            if (pQty < 1) pQty = 1;

            let pPrice = numParam(parts[3]);
            if (pPrice <= 0) {
                pPrice = (subtotalVal % 2799 === 0 && subtotalVal > 0) ? 2799 : 2699;
            }

            let pOffer2 = numParam(parts[4]);
            let pOffer3 = numParam(parts[5]);
            let pImg = safeImg(parts[6] || '');

            products.push({ name: pName, color: pColor, qty: pQty, price: pPrice, offer2: pOffer2, offer3: pOffer3, img: pImg });
        }
    });
} else if (urlParams.has('item')) {
    const rawColor = urlParams.get('color') || "Default";
    let itemPrice = 2699;
    if (subtotalVal > 0) {
        itemPrice = subtotalVal;
    } else if (totalPayable > 0) {
        itemPrice = totalPayable - shipping;
    }
    products.push({ name: urlParams.get('item'), color: rawColor, qty: 1, price: itemPrice, offer2: 0, offer3: 0, img: safeImg(urlParams.get('img') || '') });
}

function calcBundleDiscount(list) {
    const groups = {};
    list.forEach(p => {
        if (!groups[p.name]) groups[p.name] = { qty: 0, price: p.price, offer2: p.offer2, offer3: p.offer3 };
        groups[p.name].qty += p.qty;
    });
    let discount = 0;
    Object.keys(groups).forEach(k => {
        const g = groups[k];
        const full = g.qty * g.price;
        let offered = full;
        if (g.qty >= 3 && g.offer3 > 0) {
            offered = g.offer3 + (g.qty - 3) * g.price;
        } else if (g.qty === 2 && g.offer2 > 0) {
            offered = g.offer2;
        }
        if (offered < full) discount += (full - offered);
    });
    return discount;
}

function escHtml(s) {
    return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#39;");
}

// Amount hamesha English digits mein (5,548). Customer ke phone ki language ka asar nahi hota.
function fmtN(n) {
    return Number(n).toLocaleString('en-US');
}

function nrm(s) { return String(s == null ? "" : s).toLowerCase().replace(/\s+/g, " ").trim(); }

const entryEls = [];
const thumbJobs = [];

if (products.length > 0) {
    document.getElementById('orderSummary').style.display = 'block';
    const wrapper = document.getElementById('itemListWrapper');
    let totalQty = 0;
    let calculatedSubtotal = 0;

    products.forEach(p => {
        totalQty += p.qty;
        let itemRowPrice = p.qty * p.price;
        calculatedSubtotal += itemRowPrice;

        const calcDisplay = p.qty > 1 ? `<span class="m-prod-calc-text">AED ${fmtN(p.price)} × ${p.qty}</span>` : '';
        const initial = escHtml((p.name || "?").trim().charAt(0).toUpperCase() || "?");

        const entry = document.createElement('div');
        entry.className = 'm-product-entry';
        entry.innerHTML = `
            <div class="m-prod-thumb"><span class="m-thumb-ph">${initial}</span></div>
            <div class="m-prod-name">
                ${escHtml(p.name)}
                <span class="m-prod-detail"><span class="m-prod-label">Color:</span> <span class="m-prod-value">${escHtml(p.color)}</span></span>
                <span class="m-prod-detail"><span class="m-prod-label">Qty:</span> <span class="m-prod-value">${p.qty}</span></span>
                ${calcDisplay}
            </div>
            <div class="m-prod-price-block">
                <div class="m-prod-item-price">AED ${fmtN(Math.round(itemRowPrice))}</div>
            </div>
        `;
        wrapper.appendChild(entry);
        entryEls.push({ el: entry, key: nrm(p.name) + "||" + nrm(p.color) });
        thumbJobs.push({ box: entry.querySelector('.m-prod-thumb'), name: p.name, color: p.color, img: p.img });
    });

    const offerDiscount = calcBundleDiscount(products);

    // Total hamesha items se hisaab hota hai (URL ke purane total / 250 ka asar nahi)
    totalPayable = calculatedSubtotal - offerDiscount + shipping;
    subtotalVal = calculatedSubtotal;

    document.getElementById('displayQty').innerText = totalQty;
    document.getElementById('displayTotal').innerText = fmtN(totalPayable);
    document.getElementById('displayDeliveryType').innerText = deliveryType.toUpperCase();
    document.getElementById('displayDeliveryCharges').innerText = shipping > 0 ? "AED " + fmtN(shipping) : "FREE";
    document.getElementById('displaySubtotal').innerText = fmtN(subtotalVal);

    // Dropdown ke header mein chhoti line: "2 items · AED 350"
    document.getElementById('miniInfo').innerText = totalQty + (totalQty === 1 ? " item" : " items") + " · AED " + fmtN(totalPayable);

    if (offerDiscount > 0) {
        document.getElementById('displayDiscountRow').style.display = 'flex';
        document.getElementById('displayDiscount').innerText = fmtN(offerDiscount);
        const oldTot = document.getElementById('displayOldTotal');
        oldTot.innerText = "AED " + fmtN(totalPayable + offerDiscount);
        oldTot.style.display = 'inline';
    }
    window.__offerDiscount = offerDiscount;
    // Quantity screen ke text se nahi, seedha number se (browser translate se digits na badlein)
    window.__totalQty = totalQty;
}

// =====================================================================
//  ORDER SUMMARY DROPDOWN
// =====================================================================
(function setupSummaryToggle() {
    const box = document.getElementById('orderSummary');
    const btn = document.getElementById('summaryToggle');
    if (!box || !btn) return;
    btn.addEventListener('click', function () {
        const open = box.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
})();

function openSummary() {
    const box = document.getElementById('orderSummary');
    const btn = document.getElementById('summaryToggle');
    if (box) box.classList.add('is-open');
    if (btn) btn.setAttribute('aria-expanded', 'true');
}

// =====================================================================
//  PRODUCT THUMBNAILS (COLOR WISE)
//  1) Foran: URL ka image ya browser ke cart data se (taake box khali na lage)
//  2) Phir: product page (/product/<slug>/) se us COLOR ki photo (products.js ke colorImages)
//  3) Color ki photo na mile to purani photo hi rehti hai, aur kuch na mile to naam ka pehla harf.
// =====================================================================
function setThumb(box, url) {
    if (!box || !url) return;
    const im = new Image();
    im.alt = '';
    im.decoding = 'async';
    im.onload = function () { box.innerHTML = ''; box.appendChild(im); };
    im.onerror = function () {};
    im.src = url;
}

function findImgInStorage() {
    const map = {};
    function walk(o, depth) {
        if (!o || depth > 6) return;
        if (Array.isArray(o)) { o.forEach(function (x) { walk(x, depth + 1); }); return; }
        if (typeof o !== 'object') return;
        const nm = o.name || o.pname || o.title || o.product || o.productName;
        let im = o.image || o.img || o.thumb || o.thumbnail || o.photo || o.src || '';
        if (!im && Array.isArray(o.images)) im = o.images[0];
        if (typeof nm === 'string' && typeof im === 'string') {
            const s = safeImg(im);
            if (s && !map[nrm(nm)]) map[nrm(nm)] = s;
        }
        Object.keys(o).forEach(function (k) {
            const v = o[k];
            if (v && typeof v === 'object') walk(v, depth + 1);
        });
    }
    try {
        for (let i = 0; i < localStorage.length; i++) {
            const k = localStorage.key(i);
            const raw = localStorage.getItem(k);
            if (!raw || raw.length > 200000) continue;
            const c = raw.charAt(0);
            if (c !== '{' && c !== '[') continue;
            try { walk(JSON.parse(raw), 0); } catch (e) {}
        }
    } catch (e) {}
    return map;
}

async function fetchStoreImages(names) {
    try {
        const ctrl = new AbortController();
        const t = setTimeout(function () { ctrl.abort(); }, 6000);
        const r = await fetch('/store/', { signal: ctrl.signal });
        clearTimeout(t);
        if (!r.ok) return {};
        const doc = new DOMParser().parseFromString(await r.text(), 'text/html');
        const out = {};
        names.forEach(function (n) {
            const key = nrm(n);
            let img = null;
            const els = doc.querySelectorAll('[data-pname]');
            for (let i = 0; i < els.length; i++) {
                if (nrm(els[i].getAttribute('data-pname')) === key) {
                    img = els[i].querySelector('img');
                    if (img) break;
                }
            }
            if (!img) {
                const imgs = doc.querySelectorAll('img[alt]');
                for (let j = 0; j < imgs.length; j++) {
                    if (nrm(imgs[j].getAttribute('alt')).indexOf(key) === 0) { img = imgs[j]; break; }
                }
            }
            if (img) {
                const s = safeImg(img.getAttribute('src') || img.getAttribute('data-src') || '');
                if (s) out[key] = s;
            }
        });
        return out;
    } catch (e) {
        return {};
    }
}

// ---- Color wali photo: product page se ----
function slugifyName(s) {
    return String(s).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
}

async function fetchDoc(url) {
    try {
        const ctrl = new AbortController();
        const t = setTimeout(function () { ctrl.abort(); }, 6000);
        const r = await fetch(url, { signal: ctrl.signal });
        clearTimeout(t);
        if (!r.ok) return null;
        return new DOMParser().parseFromString(await r.text(), 'text/html');
    } catch (e) {
        return null;
    }
}

// Ek product ka page sirf ek baar khulta hai (us ke sab colors ke liye)
const productDocCache = {};
function getProductDoc(name) {
    const k = nrm(name);
    if (!productDocCache[k]) {
        const s = slugifyName(name);
        productDocCache[k] = (async function () {
            if (!s) return null;
            let d = await fetchDoc('/product/' + s + '/');
            if (!d) d = await fetchDoc('/product/' + s);
            return d;
        })();
    }
    return productDocCache[k];
}

function colorImgFromDoc(doc, name, color) {
    try {
        if (!doc) return '';
        const boxes = doc.querySelectorAll('.m-master-box[data-pname]');
        let box = null;
        for (let i = 0; i < boxes.length; i++) {
            if (nrm(boxes[i].getAttribute('data-pname')) === nrm(name)) { box = boxes[i]; break; }
        }
        if (!box) return '';
        let idx = {};
        try { idx = JSON.parse(box.getAttribute('data-colorindex') || '{}') || {}; } catch (e) { idx = {}; }
        let n;
        Object.keys(idx).forEach(function (c) { if (nrm(c) === nrm(color)) n = idx[c]; });
        if (typeof n !== 'number') return '';
        const imgs = box.querySelectorAll('.m-track img');
        const im = imgs[n];
        if (!im) return '';
        return safeImg(im.getAttribute('src') || im.getAttribute('data-src') || '');
    } catch (e) {
        return '';
    }
}

(function resolveThumbs() {
    if (!thumbJobs.length) return;
    const stored = findImgInStorage();
    const missing = [];

    // Step 1: foran jo mile wo dikhao (khali box na lage)
    thumbJobs.forEach(function (j) {
        const u = j.img || stored[nrm(j.name)];
        if (u) setThumb(j.box, u); else missing.push(j);
    });

    // Step 2: color wali photo mil jaye to usay laga do
    thumbJobs.forEach(function (j) {
        getProductDoc(j.name).then(function (doc) {
            const u = colorImgFromDoc(doc, j.name, j.color);
            if (u) {
                j.colorImgFound = true;
                setThumb(j.box, u);
            }
        });
    });

    // Step 3: jin ki koi photo nahi mili unke liye store page se main photo
    if (missing.length) {
        fetchStoreImages(missing.map(function (j) { return j.name; })).then(function (map) {
            missing.forEach(function (j) {
                if (j.colorImgFound) return;
                const u = map[nrm(j.name)];
                if (u) setThumb(j.box, u);
            });
        });
    }
})();

// Meta: checkout shuru hua (sirf jab cart mein items hon)
try {
    if (products.length > 0 && typeof fbq === 'function') {
        fbq('track', 'InitiateCheckout', {
            content_type: 'product',
            content_name: products.map(function (p) { return p.name; }).join(', '),
            num_items: products.reduce(function (s, p) { return s + p.qty; }, 0),
            value: totalPayable,
            currency: 'AED'
        });
    }
} catch (e) {}

// ---------- Need help? -> SupportChat kholo ----------
document.getElementById('needHelpBtn').addEventListener('click', function () {
    if (typeof window.openSupportChat === 'function') {
        window.openSupportChat();
    } else {
        showEliteAlert("Support chat is loading, please try again.", 3000);
    }
