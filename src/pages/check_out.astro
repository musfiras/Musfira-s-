let alertTimer = null;
function showEliteAlert(msg, ms) {
    const toast = document.getElementById('mCustomAlert');
    document.getElementById('mAlertMessage').innerText = msg;
    toast.classList.add('is-visible');
    clearTimeout(alertTimer);
    alertTimer = setTimeout(() => { toast.classList.remove('is-visible'); }, ms || 3500);
}

function generateUniqueOrderId() {
    const prefix = "MS-";
    const date = new Date();
    const dateStr = date.getFullYear().toString().slice(-2) +
                    ("0" + (date.getMonth() + 1)).slice(-2) +
                    ("0" + date.getDate()).slice(-2);
    const randomNum = Math.floor(1000 + Math.random() * 9000);
    return prefix + dateStr + "-" + randomNum;
}

// =====================================================================
//  LIVE STOCK CHECK
// =====================================================================
function goBackToBag() {
    if (document.referrer && history.length > 1) { history.back(); }
    else { window.location.href = SHOP_URL; }
}

function showStockIssues(issues) {
    if (!issues || !issues.length) return;
    stockBlocked = true;
    openSummary(); // masla ho to summary khud khul jaye, SOLD OUT tag nazar aaye
    const warn = document.getElementById('mStockWarn');
    const lines = issues.map(i =>
        '<b>' + escHtml(i.name) + '</b> (' + escHtml(i.color) + '): ' + (i.left > 0 ? 'only ' + i.left + ' left' : 'sold out')
    ).join('<br>');
    if (warn) {
        warn.innerHTML = 'Sorry, stock has just changed:<br>' + lines + '<br>Please go back to your bag and update it.<br>' +
                         '<button type="button" onclick="goBackToBag()">&larr; BACK TO BAG</button>';
        warn.style.display = 'block';
    }
    issues.forEach(i => {
        const key = nrm(i.name) + "||" + nrm(i.color);
        entryEls.forEach(e => {
            if (e.key !== key || e.el.querySelector('.m-prod-soldout')) return;
            const nameBox = e.el.querySelector('.m-prod-name');
            if (nameBox) {
                const tag = document.createElement('span');
                tag.className = 'm-prod-soldout';
                tag.textContent = i.left > 0 ? 'Only ' + i.left + ' left' : 'SOLD OUT';
                nameBox.appendChild(tag);
            }
        });
    });
    const btn = document.getElementById('orderBtn');
    if (btn) { btn.classList.add('is-blocked'); btn.innerHTML = 'UPDATE YOUR BAG'; }
}

async function checkLiveStock() {
    try {
        if (!products.length) return null;
        const ctrl = new AbortController();
        const timer = setTimeout(() => ctrl.abort(), 7000);
        const r = await fetch(SCRIPT_URL + "?action=publicStock", { cache: 'no-store', signal: ctrl.signal });
        clearTimeout(timer);
        const d = await r.json();
        if (!d || d.status !== "success" || !d.items || typeof d.items !== 'object') return null;

        const lk = {};
        Object.keys(d.items).forEach(p => {
            const cols = {};
            const src = d.items[p] || {};
            Object.keys(src).forEach(c => { cols[nrm(c)] = parseInt(src[c], 10) || 0; });
            lk[nrm(p)] = cols;
        });

        const want = {};
        products.forEach(p => {
            const k = nrm(p.name) + "||" + nrm(p.color);
            if (!want[k]) want[k] = { name: p.name, color: p.color, qty: 0 };
            want[k].qty += p.qty;
        });

        const issues = [];
        Object.keys(want).forEach(k => {
            const w = want[k];
            const pc = lk[nrm(w.name)];
            if (!pc) return;
            const ck = nrm(w.color);
            if (!Object.prototype.hasOwnProperty.call(pc, ck)) return;
            const left = Math.max(0, pc[ck]);
            if (left < w.qty) issues.push({ name: w.name, color: w.color, left: left });
        });
        return issues;
    } catch (e) {
        return null;
    }
}

if (products.length > 0) {
    checkLiveStock().then(issues => { if (issues && issues.length) showStockIssues(issues); });
}

// =====================================================================
//  ORDER BHEJNA
// =====================================================================
function postOrder(payload, timeoutMs) {
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), timeoutMs);
    return fetch(SCRIPT_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(payload),
        cache: 'no-store',
        keepalive: true,
        signal: ctrl.signal
    }).then(r => r.text().then(t => ({ status: r.status, text: String(t).trim() })))
      .finally(() => clearTimeout(timer));
}

function classifyReply(res) {
    const t = res.text;
    if (t === "Success") return "ok";
    if (t.indexOf("Error: stock") === 0) return "stock";
    if (t.indexOf("Error: invalid") === 0) return "invalid";
    if (t.indexOf("Error: limit") === 0) return "limit";
    if (t.indexOf("Access Denied") > -1) return "denied";
    return "retry";
}

function parseStockReply(t) {
    try {
        const list = JSON.parse(String(t).replace(/^Error: stock\s*/, ""));
        if (Array.isArray(list)) return list.map(x => ({ name: x.product, color: x.color, left: parseInt(x.left, 10) || 0 }));
    } catch (e) {}
    return [];
}

async function sendWithRetry(payload) {
    let why = "";
    for (let attempt = 1; attempt <= 3; attempt++) {
        try {
            const res = await postOrder(payload, attempt === 1 ? 12000 : 15000);
            const kind = classifyReply(res);
            if (kind === "ok") return { ok: true };
            if (kind === "stock") {
                const items = parseStockReply(res.text);
                return { ok: false, stock: true, items: items, msg: "Sorry, some items are no longer available. Please update your bag." };
            }
            if (kind === "invalid") return { ok: false, msg: "Please check your name, phone number and address, then try again." };
            if (kind === "limit") return { ok: false, msg: "Too many orders from this number. Please try again later." };
            if (kind === "denied") return { ok: false, msg: "Order service is updating. Please try again in a minute. (E-KEY)" };
            why = "S" + res.status;
        } catch (e) {
            why = (e && e.name === "AbortError") ? "TIMEOUT" : "NETWORK";
        }
        if (attempt < 3) await new Promise(r => setTimeout(r, 600 * attempt));
    }
    return { ok: false, msg: "Order could not be placed (" + why + "). Please check your internet and press Confirm again." };
}

let lastSig = "";
let lastOrderId = "";

async function sendOrder() {
    const btn = document.getElementById('orderBtn');
    if (btn.classList.contains('is-loading')) return;

    if (products.length === 0) { showEliteAlert("Your cart is empty. Please add items first.", 5000); return; }
    if (stockBlocked) { showEliteAlert("Some items are no longer available. Please go back to your bag.", 6000); return; }
    if (!(totalPayable > 0)) { showEliteAlert("Order total could not be calculated. Please go back to your bag and try again.", 6000); return; }

    const name = document.getElementById('custName').value.trim();
    // Phone: Arabic / Persian digits bhi theek ho jate hain
    let phone = latinDigits(document.getElementById('custPhone').value).replace(/[\s\-()]/g, "");
    const address = document.getElementById('custAddress').value.trim();
    const city = document.getElementById('custCity').value.trim();
    const email = document.getElementById('custEmail').value.trim();
    const method = document.querySelector('input[name="paymentMethod"]:checked').value;

    if (!name || !phone || !address || !city) { showEliteAlert("Please fill all details! ✨"); return; }
    if (!/^0?\d{9}$/.test(phone)) { showEliteAlert("Enter a valid phone number! 📞"); return; }

    // Email optional: khali ho to theek, likha ho to sahi hona chahiye
    if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
        showEliteAlert("Please enter a valid email, or leave it empty. ✉️");
        return;
    }

    phone = "+971" + phone.replace(/^0/, "");

    btn.innerHTML = "PLACING ORDER... ✨";
    btn.classList.add('is-loading');

    // Amount seedha number se banta hai (screen ke text se nahi), hamesha English digits mein
    const sTotal = fmtN(subtotalVal);
    const tQty = String(window.__totalQty || products.reduce((s, p) => s + p.qty, 0));
    const tPayable = fmtN(totalPayable);
    // Har product ki apni qeemat: "Name [Color] x2 @2699" (@ ke baad ek piece ki qeemat)
    let orderDetails = products.map(p => `${p.name} [${p.color}] x${p.qty} @${p.price}`).join(" | ");

    const sig = [name, phone, address, city, email, orderDetails, tQty, tPayable, deliveryType, method].join("~");
    const generatedOrderId = (sig === lastSig && lastOrderId) ? lastOrderId : generateUniqueOrderId();
    lastSig = sig;
    lastOrderId = generatedOrderId;

    const offerText = (window.__offerDiscount && window.__offerDiscount > 0) ? ` | Bundle Offer: -AED ${fmtN(window.__offerDiscount)}` : "";
    const emailText = email ? ` | Email: ${email}` : "";

    const finalDetails = `OrderID: ${generatedOrderId} | Items: ${orderDetails} | Total Qty: ${tQty} | Subtotal: AED ${sTotal}${offerText} | Shipping: ${deliveryType} | Payment: ${method} | Grand Total: AED ${tPayable}${emailText}`;

    const hp = (document.getElementById('company_site') || {}).value || "";

    const payload = {
        order_key: ORDER_KEY,
        hp: hp,
        name: name,
        phone: phone,
        address: address,
        city: city,
        email: email,          // naya optional field (Worker ignore kare to bhi details mein likha hota hai)
        details: finalDetails
    };

    const result = await sendWithRetry(payload);

    if (result.ok) {
        // total aur quantity thank_you page ko bhi bhejte hain (Meta Purchase ke liye)
        window.location.href = THANK_YOU_URL + "?order_id=" + encodeURIComponent(generatedOrderId) + "&v=" + encodeURIComponent(String(totalPayable)) + "&q=" + encodeURIComponent(tQty);
        return;
    }

    try { console.error("Order failed:", result.msg); } catch (e) {}
    btn.classList.remove('is-loading');
    btn.innerHTML = "CONFIRM ORDER →";
    showEliteAlert(result.msg, 7000);

    if (result.stock) {
        let issues = result.items;
        if (!issues || !issues.length) issues = await checkLiveStock();
        if (issues && issues.length) showStockIssues(issues);
    }
}

document.getElementById('orderBtn').addEventListener('click', sendOrder);

// =====================================================================
//  MOBILE KEYBOARD
// =====================================================================
(function setupKeyboardUX() {
    const fields = ['custName', 'custPhone', 'custAddress', 'custCity', 'custEmail']
        .map(id => document.getElementById(id))
        .filter(Boolean);

    fields.forEach((el, i) => {
        el.addEventListener('keydown', function (e) {
            if (e.key !== 'Enter') return;
            e.preventDefault();
            if (i < fields.length - 1) {
                fields[i + 1].focus();
            } else {
                el.blur();
                sendOrder();
            }
        });
    });

    // Phone box mein Arabic digits likhe jayen to usi waqt English ban jayen
    const ph = document.getElementById('custPhone');
    if (ph) {
        ph.addEventListener('input', function () {
            const fixed = latinDigits(ph.value);
            if (fixed !== ph.value) ph.value = fixed;
        });
    }

    const btn = document.getElementById('orderBtn');
    const vv = window.visualViewport;
    if (!btn || !vv) return;

    let raf = 0;
    function adjust() {
        raf = 0;
        const kb = Math.max(0, Math.round(window.innerHeight - vv.height));
        const open = kb > 120;
        document.documentElement.style.setProperty('--kb', (open ? kb : 0) + 'px');
        if (!open) return;
        const a = document.activeElement;
        if (!a || (a.id !== 'custAddress' && a.id !== 'custCity' && a.id !== 'custEmail')) return;
        const r = btn.getBoundingClientRect();
        const visibleBottom = vv.offsetTop + vv.height;
        if (r.bottom > visibleBottom - 12) {
            window.scrollBy({ top: r.bottom - visibleBottom + 18, behavior: 'smooth' });
        }
    }
    function schedule() { if (!raf) raf = requestAnimationFrame(adjust); }

    vv.addEventListener('resize', schedule);
    vv.addEventListener('scroll', schedule);
    fields.forEach(el => {
        el.addEventListener('focus', () => setTimeout(schedule, 350));
        el.addEventListener('blur', () => setTimeout(schedule, 250));
    });
})();

// =====================================================================
//  AUTO SCROLL: shipping details bhar jayen to Confirm button samne aa jaye
// =====================================================================
(function setupAutoScroll() {
    const nameEl = document.getElementById('custName');
    const phoneEl = document.getElementById('custPhone');
    const addrEl = document.getElementById('custAddress');
    const cityEl = document.getElementById('custCity');
    const emailEl = document.getElementById('custEmail');
    const btn = document.getElementById('orderBtn');
    if (!nameEl || !phoneEl || !addrEl || !cityEl || !btn) return;

    let done = false;
    let timer = 0;

    function complete() {
        const ph = latinDigits(phoneEl.value).replace(/[\s\-()]/g, "");
        return nameEl.value.trim().length >= 2 &&
               /^0?\d{9}$/.test(ph) &&
               addrEl.value.trim().length >= 3 &&
               cityEl.value.trim().length >= 2;
    }

    function btnInView() {
        const vv = window.visualViewport;
        const top = vv ? vv.offsetTop : 0;
        const h = vv ? vv.height : window.innerHeight;
        const r = btn.getBoundingClientRect();
        return r.top >= top && r.bottom <= top + h - 8;
    }

    function check() {
        if (!complete()) { done = false; return; }
        if (done) return;
        const a = document.activeElement;
        // customer abhi optional email bhar raha hai to usay disturb na karein
        if (a && emailEl && a === emailEl) return;
        if (btn.classList.contains('is-loading') || btn.classList.contains('is-blocked')) { done = true; return; }
        if (btnInView()) { done = true; return; }
        done = true;
        try { btn.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
        catch (e) { btn.scrollIntoView(); }
    }

    function later() { clearTimeout(timer); timer = setTimeout(check, 350); }

    [nameEl, phoneEl, addrEl, cityEl, emailEl].forEach(function (el) {
        if (!el) return;
        el.addEventListener('blur', later);
        el.addEventListener('input', function () { if (!complete()) done = false; });
    });
})();
</script>

