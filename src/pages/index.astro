---
import products from '/./src/data/products.json';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Musfira's Store</title>
    <style>
      body { font-family: system-ui, sans-serif; margin: 0; background-color: #f9fafb; color: #1f2937; }
      header { background: #ffffff; border-bottom: 1px solid #e5e7eb; padding: 1.5rem 2rem; text-align: center; }
      h1 { margin: 0; color: #111827; font-size: 2rem; }
      .container { max-width: 1200px; margin: 2rem auto; padding: 0 1rem; }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; }
      .card { background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); border: 1px solid #f3f4f6; }
      .card img { width: 100%; height: 250px; object-fit: cover; }
      .content { padding: 1.25rem; }
      .category { font-size: 0.75rem; text-transform: uppercase; color: #6b7280; font-weight: 600; letter-spacing: 0.05em; }
      .title { font-size: 1.25rem; font-weight: bold; margin: 0.5rem 0; color: #111827; }
      .price { font-size: 1.125rem; color: #2563eb; font-weight: bold; margin-bottom: 1rem; }
      .buy-btn { display: block; width: 100%; text-align: center; background-color: #25d366; color: white; text-decoration: none; padding: 0.75rem 0; border-radius: 8px; font-weight: bold; }
    </style>
  </head>
  <body>
    <header>
      <h1>Musfira's Store</h1>
      <p>Premium Handbags, Backpacks & Laptop Bags</p>
    </header>

    <main class="container">
      <div class="grid">
        {products.map((product) => (
          <div class="card">
            <img src={product.image} alt={product.name} />
            <div class="content">
              <span class="category">{product.category}</span>
              <h2 class="title">{product.name}</h2>
              <div class="price">{product.price}</div>
              <a href={`https://wa.me/?text=Hi,%20I%20want%20to%20order%20${encodeURIComponent(product.name)}`} target="_blank" class="buy-btn">
                Order via WhatsApp
              </a>
            </div>
          </div>
        ))}
      </div>
    </main>
  </body>
</html>