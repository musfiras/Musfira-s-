---
import Layout from '../layouts/Layout.astro';
import HeroBanner from '../components/HeroBanner.astro';
import EliteDivider from '../components/EliteDivider.astro';
import MusfirasChoice from '../components/MusfirasChoice.astro';
import MusfirasChoiceBanner from '../components/MusfirasChoiceBanner.astro';
import ProductCard from '../components/ProductCard.astro';
import { productsFor, CHECKOUT_URL } from '../data/products.js';

// ---------------------------------------------------------------------
//  HOME PAGE PLACEMENTS (products.js me placements: [...] me ye likho)
//    'home-top' = top banner ke neeche (jahan pehle clickable banner tha)
//    'home-2'   = 'home-top' ke neeche (MusfirasChoice se pehle)
//    'home'     = MusfirasChoice ke neeche (pehle jaisa, koi change nahi)
// ---------------------------------------------------------------------
const HOME_TOP_TITLE = "Discover the Collection";   // heading nahi chahiye to "" khali kar do

const homeTop = productsFor('home-top');
const homeSecond = productsFor('home-2');
const homeProducts = productsFor('home');
---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,700;0,6..96,900;1,6..96,400&family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

<style is:global>
  /* CategoryBanner hatne ke baad baqi components ke colors/behaviour na tootein */
  :root{
    --pink:#e6007e;
    --soft-pink:rgba(230,0,126,0.06);
    --maroon:#a8402d;
    --heading-maroon:#9c2954;
    --white:#ffffff;
    --text-dark:#1a1a1a;
    --muted:#555555;
  }
  html{scroll-behavior:smooth;}

  .m-home-sec{display:block;width:100%;clear:both;background:#ffffff;}
  .m-home-head{text-align:center;padding:40px 20px 20px;background:#ffffff;}
  .m-home-title{
    font-family:'Bodoni Moda',Georgia,serif;
    font-size:clamp(22px, 3.2vw, 28px);
    font-weight:900;
    color:var(--heading-maroon);
    line-height:1.3;
  }
  .m-home-rule{display:flex;align-items:center;justify-content:center;gap:10px;margin-top:8px;}
  .m-home-rule span{display:block;width:35px;height:1px;background:var(--pink);opacity:.4;}
  .m-home-rule i{color:var(--pink);font-size:8px;font-style:normal;font-weight:bold;}
</style>

<Layout shop={true} title="Musfira's">
  <HeroBanner />
  <EliteDivider />

  {/* TOP BANNER KE NEECHE: placements 'home-top' wale products */}
  {homeTop.length > 0 && (
    <section class="m-home-sec">
      {HOME_TOP_TITLE && (
        <div class="m-home-head">
          <h2 class="m-home-title">{HOME_TOP_TITLE}</h2>
          <div class="m-home-rule"><span></span><i>&#9670;</i><span></span></div>
        </div>
      )}
      <div class="m-super-grid">
        {homeTop.map((p) => <ProductCard p={p} checkoutUrl={CHECKOUT_URL} />)}
      </div>
    </section>
  )}

  {/* USKE NEECHE: placements 'home-2' wale products */}
  {homeSecond.length > 0 && (
    <section class="m-home-sec">
      <div class="m-super-grid">
        {homeSecond.map((p) => <ProductCard p={p} checkoutUrl={CHECKOUT_URL} />)}
      </div>
    </section>
  )}

  <MusfirasChoice />

  {homeProducts.length > 0 && (
    <div class="m-super-grid">
      {homeProducts.map((p) => <ProductCard p={p} checkoutUrl={CHECKOUT_URL} />)}
    </div>
  )}

  <div style="display:block;width:100%;clear:both;">
    <MusfirasChoiceBanner />
  </div>
</Layout>