---
import Layout from '../../layouts/Layout.astro';
import ProductDetail from '../../components/ProductDetail.astro';
import { products, CHECKOUT_URL } from '../../data/products.js';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  offers: {
    '@type': 'Offer',
    priceCurrency: 'AED',
    price: p.price,
    availability: 'https://schema.org/InStock',
  },
};
---
<Layout
  shop={true}
  pageType="product"
  title={`${p.name} | Musfira's`}
  description={`Buy ${p.name} for AED ${p.price}. Free delivery all over UAE.`}
>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

  <div class="m-product-page-wrap m-page-mode">
    <a class="m-back-link" href="/store" data-back-to-store>← Back </a>
    <ProductDetail p={p} checkoutUrl={CHECKOUT_URL} />
  </div>

  <script>
    // Customer store ya kisi category page se aaya ho to asli "back" chalao:
    // wo usi page par, usi jagah wapas jata hai. Seedha link se aaya ho
    // (WhatsApp, ad, Google) to normal link /store par le jayega.
    document.querySelectorAll<HTMLElement>('[data-back-to-store]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        let cameFromShop = false;
        try {
          const ref = new URL(document.referrer);
          const path = ref.pathname.replace(/\/+$/, '');
          cameFromShop =
            ref.origin === location.origin &&
            path !== location.pathname.replace(/\/+$/, '') &&
            !path.startsWith('/product') &&
            !path.startsWith('/checkout') &&
            !path.startsWith('/thank_you') &&
            !path.startsWith('/cart');
        } catch {}

        if (cameFromShop && history.length > 1) {
          e.preventDefault();
          history.back();
        }
      });
    });
  </script>
</Layout>