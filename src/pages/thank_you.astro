---
// Route: src/pages/thank_you.astro  ->  https://www.musfiras.com/thank_you
const SITE = "https://www.musfiras.com";

const nav = [
  { label: "Store", href: `${SITE}/store` },
  { label: "Bags & Carrying", href: `${SITE}/bags_carrying` },
  { label: "Fashion & Accessories", href: `${SITE}/fashion_accessories` },
  { label: "Apparel & Jewellery", href: `${SITE}/apparel_jewellery` },
  { label: "Musfira's Choice", href: `${SITE}/musfiras_choice` },
];

// APNE PRODUCTS YAHAN BADLEIN (link + image)
const picks = [
  { name: "The Greek Luxe Bag", href: "APNA_PAGE_LINK_1", img: "APNI_IMAGE_URL_1" },
  { name: "Premium Signature Wallet", href: "APNA_PAGE_LINK_2", img: "APNI_IMAGE_URL_2" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#FFB6C1" />
    <title>Order received | Musfira's</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:wght@400..900&display=swap"
      rel="stylesheet"
    />

    <!-- Meta Pixel / Google Ads conversion code yahan paste karein (purchase event isi page par fire hota hai) -->
  </head>

  <body>
    <header class="site-header">
      <a class="brand" href={`${SITE}/store`} aria-label="Musfira's home">
        <span class="brand-name">Musfira's</span>
        <span class="brand-tag"><i></i>Made to adore<i></i></span>
      </a>
      <nav class="site-nav" aria-label="Main">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
    </header>

    <main>
      <section class="card" aria-labelledby="ty-title">
        <div class="tick" aria-hidden="true">✓</div>
        <h1 id="ty-title">Order received!</h1>
        <p>
          Thank you for shopping with Musfira's. We are preparing your items and will
          process them right away.
        </p>
        <p class="note">Please keep your phone active for the verification call.</p>
        <a class="cta" href={`${SITE}/store`}>Continue shopping</a>
      </section>

      <section class="picks" aria-labelledby="picks-title">
        <h2 id="picks-title">You may also like</h2>
        <div class="grid">
          {picks.map((p) => (
            <a class="pick" href={p.href}>
              <span class="thumb"><img src={p.img} alt={p.name} loading="lazy" /></span>
              <span class="pname">{p.name}</span>
              <span class="pact">View product</span>
            </a>
          ))}
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="f-brand">Musfira's <small>Made to adore</small></div>
      <nav class="f-links" aria-label="Footer">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        <a href={`${SITE}/reviews`}>Reviews</a>
      </nav>
      <p class="copy">© {new Date().getFullYear()} Musfira's. All rights reserved.</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --maroon: #800000;
    --pink: #e6007e;
    --blush: #fecce6;
    --paper: #fafafa;
    --ink: #4a4a4a;
    --serif: "Bodoni Moda", "Bodoni 72", Didot, "Playfair Display", Georgia, serif;
    --sans: "Segoe UI", Roboto, -apple-system, sans-serif;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    padding-top: env(safe-area-inset-top, 0px);
  }
  a { color: inherit; text-decoration: none; }
  a:focus-visible { outline: 2px solid var(--pink); outline-offset: 3px; }

  /* Header */
  .site-header {
    background: #fff;
    border-bottom: 1px solid #f0f0f0;
    padding: 8px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .brand { text-align: center; }
  .brand-name { display: block; font-family: var(--serif); font-size: 22px; font-weight: 670; color: var(--pink); line-height: 1.15; }
  .brand-tag { display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 3px; font-family: var(--serif); font-size: 8.5px; font-weight: 600; color: var(--pink); }
  .brand-tag i { width: 6px; height: 1px; background: var(--pink); }
  .site-nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 18px; font-size: 13px; }
  .site-nav a { color: var(--maroon); font-weight: 600; padding: 4px 0; border-bottom: 1px solid transparent; }
  .site-nav a:hover { border-bottom-color: var(--pink); color: var(--pink); }

  /* Main */
  main { flex: 1; width: 100%; padding: 32px 16px 40px; display: flex; flex-direction: column; align-items: center; gap: 32px; }

  .card {
    width: 100%; max-width: 480px; background: #fff; text-align: center;
    padding: 44px 32px 36px; border-radius: 28px; border: 1px solid var(--blush);
    box-shadow: 0 20px 60px rgba(128, 0, 0, 0.06); position: relative; overflow: hidden;
  }
  .card::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 5px; background: linear-gradient(90deg, #800000, #e6007e, #800000); }
  .tick { width: 72px; height: 72px; margin: 0 auto 22px; border-radius: 50%; background: #10b981; color: #fff; font-size: 32px; display: grid; place-items: center; box-shadow: 0 10px 25px rgba(16, 185, 129, 0.2); }
  .card h1 { margin: 0 0 12px; font-family: var(--serif); font-size: 28px; font-weight: 700; color: var(--maroon); }
  .card p { margin: 0 0 16px; font-size: 15px; line-height: 1.6; }
  .card .note { font-size: 13px; color: #888; }
  .cta {
    display: inline-block; margin-top: 8px; padding: 12px 30px; border-radius: 50px;
    background: linear-gradient(90deg, #800000, #e6007e); color: #fff; font-size: 13px; font-weight: 700;
    box-shadow: 0 5px 15px rgba(230, 0, 126, 0.2);
  }
  .cta:hover { box-shadow: 0 8px 20px rgba(230, 0, 126, 0.35); }

  /* Suggestions: hamesha 2 side by side */
  .picks { width: 100%; max-width: 900px; background: #fff; border: 1px solid var(--blush); border-radius: 24px; padding: 28px 16px; text-align: center; }
  .picks h2 { margin: 0 0 20px; font-family: var(--serif); font-size: 22px; color: var(--maroon); }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .pick { background: var(--paper); border: 1px solid #f1f1f1; border-radius: 16px; padding: 10px; display: flex; flex-direction: column; align-items: center; min-width: 0; transition: border-color .2s, background .2s; }
  .pick:hover { background: #fff5f9; border-color: var(--blush); }
  .thumb { width: 100%; aspect-ratio: 1; border-radius: 12px; overflow: hidden; background: #eee; margin-bottom: 10px; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pname { font-size: 13px; font-weight: 700; color: var(--maroon); margin-bottom: 4px; }
  .pact { font-size: 12px; font-weight: 700; color: var(--pink); }

  /* Footer */
  .site-footer { background: #fff; border-top: 1px solid #f0f0f0; padding: 24px 20px calc(24px + env(safe-area-inset-bottom, 0px)); text-align: center; }
  .f-brand { font-family: var(--serif); font-size: 20px; font-weight: 670; color: var(--pink); }
  .f-brand small { display: block; font-size: 10px; font-weight: 600; margin-top: 2px; }
  .f-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 18px; margin: 14px 0; font-size: 13px; }
  .f-links a { color: var(--maroon); font-weight: 600; }
  .f-links a:hover { color: var(--pink); }
  .copy { margin: 0; font-size: 12px; color: #999; }

  @media (min-width: 900px) {
    .site-header { flex-direction: row; justify-content: space-between; padding: 10px 40px; }
    .picks { padding: 40px; }
    .grid { gap: 24px; }
    .thumb { aspect-ratio: 4 / 3; }
    .pname { font-size: 16px; }
  }
  @media (max-width: 480px) {
    .card { padding: 36px 20px 28px; border-radius: 22px; }
    .card h1 { font-size: 24px; }
    .pname { font-size: 11.5px; }
    .pact { font-size: 10.5px; }
  }
</style>