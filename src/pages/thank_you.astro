---
// Route: src/pages/thank_you.astro  ->  https://www.musfiras.com/thank_you
//
// Header/footer links build ke waqt live site (/store) se khud uthaye jate hain.
// Jo page site par hai wo aayega, jo nahi hai wo nahi aayega. Naam badlein to
// yahan kuch change nahi karna, bas agla deploy naya naam utha lega.

const SITE = "https://www.musfiras.com";

// Ye pages collections nahi hain, inhein category links se alag rakha gaya hai
const HELP_PATHS = ["/terms", "/faqs", "/privacy", "/contact", "/about", "/reviews"];
const NOT_COLLECTION = new Set([
  "", "/cart", "/checkout", "/order", "/orders", "/thank_you", "/search", "/account", "/login", "/product",
  ...HELP_PATHS,
]);

type Link = { path: string; text: string };

function tidy(s: string) {
  // "-BAGS & CARRYING-" -> "Bags & Carrying", "★REVIEWS" -> "Reviews"
  let t = s
    .replace(/<[^>]*>/g, "")
    .replace(/&amp;/g, "&")
    .replace(/&#0?39;|&apos;|&rsquo;/g, "'")
    .replace(/\s+/g, " ")
    .trim()
    .replace(/^[-–—★◆\s]+|[-–—★◆\s]+$/g, "");
  if (t && t === t.toUpperCase()) {
    t = t.toLowerCase().replace(/(^|[\s&(])([a-z])/g, (_m, a, b) => a + b.toUpperCase());
  }
  return t;
}

function parseLinks(html: string): Link[] {
  const out: Link[] = [];
  const seen = new Set<string>();
  const re = /<a\b[^>]*?href=["']([^"']+)["'][^>]*>([\s\S]*?)<\/a>/gi;
  let m: RegExpExecArray | null;
  while ((m = re.exec(html))) {
    let u: URL;
    try { u = new URL(m[1].trim(), SITE); } catch { continue; }
    if (u.hostname.replace(/^www\./, "") !== "musfiras.com") continue;
    const path = u.pathname.replace(/\/+$/, "");
    const text = tidy(m[2]);
    if (!text || text.length > 40 || seen.has(path)) continue;
    seen.add(path);
    out.push({ path, text });
  }
  return out;
}

let links: Link[] = [];
try {
  const res = await fetch(`${SITE}/store/`, { signal: AbortSignal.timeout(8000) });
  if (res.ok) links = parseLinks(await res.text());
} catch {
  /* fetch fail ho to neeche fallback chalega */
}

const isSingleSegment = (p: string) => /^\/[^/]+$/.test(p);
let collections = links.filter((l) => isSingleSegment(l.path) && !NOT_COLLECTION.has(l.path));
const help = HELP_PATHS.map((p) => links.find((l) => l.path === p)).filter(Boolean) as Link[];

if (!collections.length) collections = [{ path: "/store", text: "Shop all" }];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#FFB6C1" />
    <title>Order received | Musfira's</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:wght@400..900&display=swap"
      rel="stylesheet"
    />

    <!-- Meta Pixel / Google Ads purchase conversion code yahan paste karein -->
  </head>

  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Musfira's home">
        <span class="brand-name">Musfira's</span>
        <span class="brand-tag"><i></i>Made to adore<i></i></span>
      </a>
      <nav class="site-nav" aria-label="Main">
        <a href="/">Home</a>
        {collections.map((l) => <a href={l.path}>{l.text}</a>)}
      </nav>
    </header>

    <main>
      <section class="card" aria-labelledby="ty-title">
        <div class="tick" aria-hidden="true">✓</div>
        <h1 id="ty-title">Order received!</h1>
        <p>
          Thank you for shopping with Musfira's. We are preparing your items and will
          process them right away.
        </p>
        <p class="note">Please keep your phone active for the verification call.</p>
        <a class="cta" href="/store">Continue shopping</a>
      </section>
    </main>

    <footer class="site-footer">
      <div class="f-brand">Musfira's <small>Made to adore</small></div>
      <nav class="f-links" aria-label="Shop">
        <a href="/">Home</a>
        {collections.map((l) => <a href={l.path}>{l.text}</a>)}
      </nav>
      {help.length > 0 && (
        <nav class="f-links f-help" aria-label="Help and info">
          {help.map((l) => <a href={l.path}>{l.text}</a>)}
        </nav>
      )}
      <p class="copy">© {year} Musfira's. All rights reserved.</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --maroon: #800000;
    --pink: #e6007e;
    --blush: #fecce6;
    --paper: #fafafa;
    --ink: #4a4a4a;
    --serif: "Bodoni Moda", "Bodoni 72", Didot, "Playfair Display", Georgia, serif;
    --sans: "Segoe UI", Roboto, -apple-system, sans-serif;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    padding-top: env(safe-area-inset-top, 0px);
  }
  a { color: inherit; text-decoration: none; }
  a:focus-visible { outline: 2px solid var(--pink); outline-offset: 3px; }

  .site-header {
    background: #fff;
    border-bottom: 1px solid #f0f0f0;
    padding: 8px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .brand { text-align: center; }
  .brand-name { display: block; font-family: var(--serif); font-size: 22px; font-weight: 670; color: var(--pink); line-height: 1.15; }
  .brand-tag { display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 3px; font-family: var(--serif); font-size: 8.5px; font-weight: 600; color: var(--pink); }
  .brand-tag i { width: 6px; height: 1px; background: var(--pink); }
  .site-nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 18px; font-size: 13px; }
  .site-nav a { color: var(--maroon); font-weight: 600; padding: 4px 0; border-bottom: 1px solid transparent; }
  .site-nav a:hover { border-bottom-color: var(--pink); color: var(--pink); }

  main { flex: 1; width: 100%; padding: 40px 16px 48px; display: flex; flex-direction: column; align-items: center; }

  .card {
    width: 100%; max-width: 480px; background: #fff; text-align: center;
    padding: 44px 32px 36px; border-radius: 28px; border: 1px solid var(--blush);
    box-shadow: 0 20px 60px rgba(128, 0, 0, 0.06); position: relative; overflow: hidden;
  }
  .card::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 5px; background: linear-gradient(90deg, #800000, #e6007e, #800000); }
  .tick { width: 72px; height: 72px; margin: 0 auto 22px; border-radius: 50%; background: #10b981; color: #fff; font-size: 32px; display: grid; place-items: center; box-shadow: 0 10px 25px rgba(16, 185, 129, 0.2); }
  .card h1 { margin: 0 0 12px; font-family: var(--serif); font-size: 28px; font-weight: 700; color: var(--maroon); }
  .card p { margin: 0 0 16px; font-size: 15px; line-height: 1.6; }
  .card .note { font-size: 13px; color: #888; }
  .cta {
    display: inline-block; margin-top: 8px; padding: 12px 30px; border-radius: 50px;
    background: linear-gradient(90deg, #800000, #e6007e); color: #fff; font-size: 13px; font-weight: 700;
    box-shadow: 0 5px 15px rgba(230, 0, 126, 0.2);
  }
  .cta:hover { box-shadow: 0 8px 20px rgba(230, 0, 126, 0.35); }

  .site-footer { background: #fff; border-top: 1px solid #f0f0f0; padding: 24px 20px calc(24px + env(safe-area-inset-bottom, 0px)); text-align: center; }
  .f-brand { font-family: var(--serif); font-size: 20px; font-weight: 670; color: var(--pink); }
  .f-brand small { display: block; font-size: 10px; font-weight: 600; margin-top: 2px; }
  .f-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 18px; margin: 14px 0 0; font-size: 13px; }
  .f-links a { color: var(--maroon); font-weight: 600; }
  .f-links a:hover { color: var(--pink); }
  .f-help a { color: #777; font-weight: 500; }
  .copy { margin: 16px 0 0; font-size: 12px; color: #999; }

  @media (min-width: 900px) {
    .site-header { flex-direction: row; justify-content: space-between; padding: 10px 40px; }
  }
  @media (max-width: 480px) {
    .card { padding: 36px 20px 28px; border-radius: 22px; }
    .card h1 { font-size: 24px; }
  }
</style>